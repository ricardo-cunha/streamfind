@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfsensors: <https://streamfind.dev/catalogue/domains/sensors#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfsensors:sourceIdColumnParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Source ID column" ;
    skos:definition "Input column containing the stable acquisition source identity." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "source_id" ;
    sf:example "device" .

sfsensors:layoutParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Input layout" ;
    skos:definition "CSV/table layout: long uses one signal and value per row; wide uses each selected variable column as a signal." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "long" ;
    sf:constraints "long|wide" ;
    sf:example "wide" .

sfsensors:variableColumnsParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Variable columns" ;
    skos:definition "Explicit wide-layout table columns to emit as sensor signals, in the desired signal order." ;
    sf:type "array" ;
    sf:required false ;
    sf:default "[]" ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"pH\",\"temperature\"]" .

sfsensors:signalIdColumnParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Signal ID column" ;
    skos:definition "Long-layout input column containing the stable sensor or channel identity." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "signal_id" ;
    sf:example "sensor" .

sfsensors:eventTimeColumnParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Event time column" ;
    skos:definition "Input column containing the measurement timestamp in ISO-8601 form." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "event_time" ;
    sf:example "timestamp" .

sfsensors:valueColumnParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Sensor value column" ;
    skos:definition "Long-layout input scalar column containing the observation value." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "value" ;
    sf:example "pH" .

sfsensors:receivedAtColumnParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Received-at column" ;
    skos:definition "Optional input column containing the time streamfind received the observation; absent values use invocation time." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "received_at" .

sfsensors:unitColumnParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Unit column" ;
    skos:definition "Optional input column containing the measurement unit." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "unit" .

sfsensors:qualityColumnParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Quality column" ;
    skos:definition "Optional input column containing good, uncertain, bad, or missing quality." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "quality" .

sfsensors:statusCodeColumnParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Status-code column" ;
    skos:definition "Optional input column containing the protocol-native status code." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "status_code" .

sfsensors:timeOriginParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Time origin" ;
    skos:definition "Origin of the event timestamp: source, server, broker, or receiver." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "source" ;
    sf:constraints "source|server|broker|receiver" ;
    sf:example "source" .

sfsensors:captureIdParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Capture ID" ;
    skos:definition "Optional immutable acquisition or normalization segment identity." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "capture-2026-01-01" .

sfsensors:startTimeParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Start time" ;
    skos:definition "Inclusive lower bound for event_time, in normalized ISO-8601 UTC form." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "2026-11-19T12:00:00.000000Z" .

sfsensors:endTimeParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "End time" ;
    skos:definition "Exclusive upper bound for event_time, in normalized ISO-8601 UTC form." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "2026-11-19T13:00:00.000000Z" .

sfsensors:windowSecondsParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Window size" ;
    skos:definition "Fixed UTC resampling window size in seconds; windows are left-closed and right-open and anchored at the Unix epoch." ;
    sf:type "real" ;
    sf:required true ;
    sf:default "60" ;
    sf:constraints "{\"minimum\":0.000001}" ;
    sf:example "60" .

sfsensors:aggregationParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Aggregation" ;
    skos:definition "Resampling aggregation: mean averages numeric observations and last selects the latest observation in each window." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "mean" ;
    sf:constraints "mean|last" ;
    sf:example "mean" .

sfsensors:referenceSignalParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Reference signal" ;
    skos:definition "Signal identifier whose observations define the timestamps used for nearest-time alignment." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "pH" .

sfsensors:toleranceSecondsParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Alignment tolerance" ;
    skos:definition "Maximum absolute event-time distance in seconds for a nearest observation to be considered matched." ;
    sf:type "real" ;
    sf:required false ;
    sf:default "1" ;
    sf:constraints "{\"minimum\":0}" ;
    sf:example "0.5" .

sfsensors:timeAxisParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Alignment time axis" ;
    skos:definition "Timestamp axis used when projecting aligned observations back to SENSOR_TIMESERIES: reference uses the reference timeline, while observed uses matched event times and anchors missing matches to the reference timestamp." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "reference" ;
    sf:constraints "reference|observed" ;
    sf:example "reference" .

sfsensors:endpointParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "OPC UA endpoint" ;
    skos:definition "OPC UA endpoint URL, for example opc.tcp://localhost:4840." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "opc.tcp://localhost:4840" ;
    sf:example "opc.tcp://localhost:4840" .

sfsensors:brokerEndpointParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT broker endpoint" ;
    skos:definition "MQTT broker URL using tcp://, ssl://, ws://, or wss://." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "tcp://localhost:1883" ;
    sf:example "tcp://localhost:1883" .

sfsensors:topicsParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT topics" ;
    skos:definition "JSON object mapping stable signal identifiers to MQTT topic filters." ;
    sf:type "object" ;
    sf:required true ;
    sf:default "{}" ;
    sf:example "{\"temperature\":\"lab/temperature\"}" .

sfsensors:payloadFormatParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT payload format" ;
    skos:definition "MQTT payload decoding mode: json envelopes or plain text values." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "json" ;
    sf:constraints "json|plain" ;
    sf:example "json" .

sfsensors:qosParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT QoS" ;
    skos:definition "MQTT subscription quality of service level 0, 1, or 2." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default "1" ;
    sf:constraints "{\"enum\":[0,1,2]}" ;
    sf:example "1" .

sfsensors:clientIdParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT client ID" ;
    skos:definition "Optional MQTT client identifier; a unique operation identifier is used when absent." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "streamfind-sensors" .

sfsensors:maxReconnectAttemptsParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum MQTT reconnect attempts" ;
    skos:definition "Maximum number of bounded reconnect attempts after an established MQTT connection is lost. Zero disables reconnect." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default "3" ;
    sf:constraints "{\"minimum\":0,\"maximum\":32}" ;
    sf:example "3" .

sfsensors:reconnectBackoffSecondsParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT reconnect backoff" ;
    skos:definition "Delay in seconds between bounded MQTT reconnect attempts." ;
    sf:type "real" ;
    sf:required false ;
    sf:default "1" ;
    sf:constraints "{\"minimum\":0,\"maximum\":60}" ;
    sf:example "1" .

sfsensors:mqttUsernameParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT username" ;
    skos:definition "Optional MQTT broker username." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "user" .

sfsensors:mqttPasswordParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT password" ;
    skos:definition "Optional MQTT broker password paired with the username." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "secret" .

sfsensors:tlsEnabledParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Enable MQTT TLS" ;
    skos:definition "Enable TLS for ssl:// or wss:// broker endpoints." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:default "false" ;
    sf:example "true" .

sfsensors:tlsCaFileParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT CA certificate" ;
    skos:definition "Optional PEM trust-store path for MQTT broker certificate validation." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "C:/certs/ca.pem" .

sfsensors:tlsClientCertificateParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT client certificate" ;
    skos:definition "Optional PEM client certificate path for mutual TLS." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "C:/certs/client.pem" .

sfsensors:tlsClientKeyParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT client key" ;
    skos:definition "Optional PEM private-key path for mutual TLS." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "C:/certs/client.key" .

sfsensors:tlsClientKeyPasswordParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MQTT client key password" ;
    skos:definition "Optional password for an encrypted MQTT client private key." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "secret" .

sfsensors:tlsVerifyServerParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Verify MQTT broker certificate" ;
    skos:definition "Require successful broker certificate and hostname validation for TLS connections." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:default "true" ;
    sf:example "true" .

sfsensors:usernameParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "OPC UA username" ;
    skos:definition "Optional username for OPC UA username/password authentication." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "user" .

sfsensors:passwordParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "OPC UA password" ;
    skos:definition "Optional password paired with the OPC UA username." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "secret" .

sfsensors:timeoutSecondsParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "OPC UA timeout" ;
    skos:definition "Connection and request timeout in seconds." ;
    sf:type "real" ;
    sf:required false ;
    sf:default "10" ;
    sf:example "10" .

sfsensors:nodeIdParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "OPC UA node ID" ;
    skos:definition "Identifier of the OPC UA node whose definition and metadata should be inspected." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "ns=2;s=Temperature" .

sfsensors:maxDepthParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum browse depth" ;
    skos:definition "Maximum number of hierarchical levels explored from the Objects folder." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default "2" ;
    sf:example "2" .

sfsensors:maxChildrenParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum children per node" ;
    skos:definition "Maximum number of child references retained for each browsed node." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default "64" ;
    sf:example "64" .

sfsensors:nodesParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "OPC UA nodes" ;
    skos:definition "JSON object mapping output names to OPC UA node identifiers." ;
    sf:type "object" ;
    sf:required true ;
    sf:default "{}" ;
    sf:example "{\"temperature\":\"ns=2;s=Temperature\"}" .

sfsensors:captureDurationParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Capture duration" ;
    skos:definition "Maximum duration of one finite sensor time-series capture in seconds." ;
    sf:type "real" ;
    sf:required false ;
    sf:default "10" ;
    sf:constraints "{\"minimum\":0.001,\"maximum\":3600}" ;
    sf:example "30" .

sfsensors:captureIntervalParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Sample interval" ;
    skos:definition "Polling interval for each requested OPC UA node in milliseconds." ;
    sf:type "real" ;
    sf:required false ;
    sf:default "1000" ;
    sf:constraints "{\"minimum\":1,\"maximum\":600000}" ;
    sf:example "1000" .

sfsensors:maxSamplesParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum samples" ;
    skos:definition "Maximum total observations emitted by one finite capture across all requested nodes." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default "1000" ;
    sf:constraints "{\"minimum\":1,\"maximum\":1000000}" ;
    sf:example "300" .

sfsensors:maxBufferBytesParameter
    a sf:Parameter ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum buffer bytes" ;
    skos:definition "Maximum approximate in-memory Arrow batch size before a capture publishes another immutable result batch." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default "67108864" ;
    sf:constraints "{\"minimum\":1,\"maximum\":536870912}" ;
    sf:example "16777216" .
