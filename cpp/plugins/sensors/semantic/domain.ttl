@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfsensors: <https://streamfind.dev/catalogue/domains/sensors#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfsensors:sensors
    a sf:Domain ;
    skos:prefLabel "sensors" ;
    skos:definition "Sensor data project domain." ;
    sf:guidance "Sensor workflow: create or describe the project, discover canonical operations with get_operations(domain=sensors), add configured operation nodes, connect typed ports, validate the graph, and run_workflow." .
