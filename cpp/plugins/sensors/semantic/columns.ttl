@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfsensors: <https://streamfind.dev/catalogue/domains/sensors#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfsensors:sourceIdColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Source ID" ;
    skos:definition "Stable identity of the acquisition source." ;
    sf:columnName "source_id" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:signalIdColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Signal ID" ;
    skos:definition "Stable identity of the sensor or channel." ;
    sf:columnName "signal_id" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:referenceSignalColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Reference signal" ;
    skos:definition "Signal whose observations define the reference timestamps for alignment." ;
    sf:columnName "reference_signal" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:referenceEventTimeColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Reference event time" ;
    skos:definition "Reference signal timestamp to which the aligned observation is compared." ;
    sf:columnName "reference_event_time" ;
    sf:type "timestamp" ;
    sf:storageType "TIMESTAMP" .

sfsensors:eventTimeColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Event time" ;
    skos:definition "Measurement time normalized to UTC with microsecond precision when available." ;
    sf:columnName "event_time" ;
    sf:type "timestamp" ;
    sf:storageType "TIMESTAMP" .

sfsensors:receivedAtColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Received at" ;
    skos:definition "Time at which streamfind received the observation." ;
    sf:columnName "received_at" ;
    sf:type "timestamp" ;
    sf:storageType "TIMESTAMP" .

sfsensors:timeOriginColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Time origin" ;
    skos:definition "Origin of event_time: source, server, broker, or receiver." ;
    sf:columnName "time_origin" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:valueTypeColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Value type" ;
    skos:definition "Typed value representation: real, integer, boolean, string, json, or missing." ;
    sf:columnName "value_type" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:valueDoubleColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Real value" ;
    skos:definition "Numeric real observation when value_type is real." ;
    sf:columnName "value_double" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfsensors:valueIntColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Integer value" ;
    skos:definition "Integer observation when value_type is integer." ;
    sf:columnName "value_int" ;
    sf:type "integer" ;
    sf:storageType "BIGINT" .

sfsensors:valueBoolColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Boolean value" ;
    skos:definition "Boolean observation when value_type is boolean." ;
    sf:columnName "value_bool" ;
    sf:type "boolean" ;
    sf:storageType "BOOLEAN" .

sfsensors:valueTextColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Text value" ;
    skos:definition "Text observation when value_type is string." ;
    sf:columnName "value_text" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:sensorValueJsonColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "JSON value" ;
    skos:definition "Serialized structured observation when value_type is json." ;
    sf:columnName "value_json" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:unitColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Unit" ;
    skos:definition "Unit of measurement when known." ;
    sf:columnName "unit" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:qualityColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Quality" ;
    skos:definition "Normalized observation quality: good, uncertain, bad, or missing." ;
    sf:columnName "quality" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:sensorStatusCodeColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Status code" ;
    skos:definition "Protocol-native status code associated with the observation." ;
    sf:columnName "status_code" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:captureIdColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Capture ID" ;
    skos:definition "Acquisition execution or immutable segment identity." ;
    sf:columnName "capture_id" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:eventIdColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Event ID" ;
    skos:definition "Observation identity used for deduplication and provenance." ;
    sf:columnName "event_id" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:alignmentStatusColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Alignment status" ;
    skos:definition "Whether the row is the reference observation, a nearest observation within tolerance, or an unavailable observation." ;
    sf:columnName "alignment_status" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:timeDeltaMicrosecondsColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Alignment time delta" ;
    skos:definition "Signed matched event_time minus reference_event_time in microseconds; absent when no observation is within tolerance." ;
    sf:columnName "time_delta_microseconds" ;
    sf:type "integer" ;
    sf:storageType "BIGINT" .

sfsensors:endpointColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Endpoint" ;
    skos:definition "OPC UA endpoint used for the read." ;
    sf:columnName "endpoint" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:nodeNameColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Node name" ;
    skos:definition "User-provided output name for the requested node." ;
    sf:columnName "node_name" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:nodeIdColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Node identifier" ;
    skos:definition "OPC UA node identifier read by the operation." ;
    sf:columnName "node_id" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:nodeClassColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Node class" ;
    skos:definition "Numeric OPC UA NodeClass category reported by the server." ;
    sf:columnName "node_class" ;
    sf:type "integer" ;
    sf:storageType "BIGINT" .

sfsensors:nodeClassNameColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Node class name" ;
    skos:definition "Human-readable OPC UA NodeClass category reported by the server." ;
    sf:columnName "node_class_name" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:valueAvailableColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Value available" ;
    skos:definition "Whether a value was read successfully from a Variable node; non-Variable nodes are not queried for a value." ;
    sf:columnName "value_available" ;
    sf:type "boolean" ;
    sf:storageType "BOOLEAN" .

sfsensors:valueColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Value" ;
    skos:definition "Decoded OPC UA scalar or array value when the read succeeds." ;
    sf:columnName "value" ;
    sf:type "object" ;
    sf:storageType "JSON" .

sfsensors:valueJsonColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Value JSON" ;
    skos:definition "Serialized JSON representation of the decoded OPC UA value." ;
    sf:columnName "value_json" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:statusCodeColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Status code" ;
    skos:definition "OPC UA status code returned by the node read." ;
    sf:columnName "status_code" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfsensors:statusNameColumn
    a sf:Column ;
    sf:availableInDomain sfsensors:sensors ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Status name" ;
    skos:definition "Human-readable OPC UA status name returned by the node read." ;
    sf:columnName "status_name" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .
