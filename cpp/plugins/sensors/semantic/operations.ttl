@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfsensors: <https://streamfind.dev/catalogue/domains/sensors#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfsensors:exploreOpcuaServer
    a sf:Operation ;
    sf:operationId "sensors.explore_opcua_server" ;
    sf:availableInDomain sfsensors:sensors ;
    sf:providedByModule sfsensors:baseModule ;
    sf:projectEntry true ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Explore OPC UA server" ;
    skos:definition "Connect to an OPC UA endpoint, report endpoint and namespace metadata, and browse a bounded hierarchical node tree from the Objects folder." ;
    sf:hasParameter
        sfsensors:endpointParameter,
        sfsensors:usernameParameter,
        sfsensors:passwordParameter,
        sfsensors:timeoutSecondsParameter,
        sfsensors:maxDepthParameter,
        sfsensors:maxChildrenParameter ;
    sf:hasOutputPort sfsensors:opcuaExploration, sfcore:operationSuccessSignal .

sfsensors:collectOpcuaData
    a sf:Operation ;
    sf:operationId "sensors.collect_opcua_data" ;
    sf:availableInDomain sfsensors:sensors ;
    sf:providedByModule sfsensors:baseModule ;
    sf:projectEntry true ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Collect OPC UA data" ;
    skos:definition "Connect to an OPC UA endpoint, read the requested node values once, and emit one typed row per requested node with decoded value and OPC UA status metadata." ;
    sf:hasParameter
        sfsensors:endpointParameter,
        sfsensors:usernameParameter,
        sfsensors:passwordParameter,
        sfsensors:timeoutSecondsParameter,
        sfsensors:nodesParameter ;
    sf:hasOutputPort sfsensors:opcuaDataTable, sfcore:operationSuccessSignal .
