{
  "metadata": {
    "id": "statistics-pca-example",
    "name": "Statistics PCA example",
    "description": "Import a CSV table and inspect its first two principal components. Set csv_input_path to statistics-example.csv from the statistics plugin resources.",
    "domain": "statistics",
    "use_case": "Explore multivariate variation",
    "owner": "StreamFind statistics demos"
  },
  "workflow": {
    "schema_version": 2,
    "workflow_id": "statistics-pca-example",
    "name": "Statistics PCA example",
    "version": 1,
    "metadata": {
      "name": "Statistics PCA example",
      "description": "Import a wide table and run PCA.",
      "domain": "statistics"
    },
    "operations": [
      {
        "id": 1,
        "operation": "streamfind.read_csv",
        "parameters": {
          "csv_input_path": "statistics-example.csv"
        },
        "inputs": {},
        "position": {
          "x": 120,
          "y": 180
        }
      },
      {
        "id": 2,
        "operation": "statistics.pca",
        "parameters": {
          "layout": "wide",
          "sample_id_column": "sample_id",
          "variable_columns": [
            "feature_a",
            "feature_b"
          ],
          "group_column": "group",
          "preprocessing": "center",
          "n_components": 2
        },
        "inputs": {},
        "position": {
          "x": 420,
          "y": 180
        }
      }
    ],
    "connections": [
      {
        "source_operation": 1,
        "source_port": "anyTable",
        "target_operation": 2,
        "target_port": "tableInput"
      }
    ]
  }
}
