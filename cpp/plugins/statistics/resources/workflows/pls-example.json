{
  "metadata": {
    "id": "statistics-pls-example",
    "name": "Statistics PLS example",
    "description": "Import a CSV table and fit a one-response PLS model. Set csv_input_path to statistics-example.csv from the statistics plugin resources.",
    "domain": "statistics",
    "use_case": "Model a numeric response",
    "owner": "StreamFind statistics demos"
  },
  "workflow": {
    "schema_version": 2,
    "workflow_id": "statistics-pls-example",
    "name": "Statistics PLS example",
    "version": 1,
    "metadata": {
      "name": "Statistics PLS example",
      "description": "Import a wide table and fit a numeric response.",
      "domain": "statistics"
    },
    "operations": [
      {
        "id": 1,
        "operation": "streamfind.read_csv",
        "parameters": {
          "csv_input_path": "statistics-example.csv"
        },
        "inputs": {},
        "position": {
          "x": 120,
          "y": 180
        }
      },
      {
        "id": 2,
        "operation": "statistics.pls",
        "parameters": {
          "layout": "wide",
          "sample_id_column": "sample_id",
          "variable_columns": [
            "feature_a",
            "feature_b"
          ],
          "response_mode": "regression",
          "response_columns": [
            "response"
          ],
          "preprocessing": "center",
          "n_components": 1
        },
        "inputs": {},
        "position": {
          "x": 420,
          "y": 180
        }
      }
    ],
    "connections": [
      {
        "source_operation": 1,
        "source_port": "anyTable",
        "target_operation": 2,
        "target_port": "tableInput"
      }
    ]
  }
}
