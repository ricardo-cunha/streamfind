@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfstat: <https://streamfind.dev/catalogue/domains/statistics#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfstat:sampleIdColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Sample ID" ;
    skos:definition "Stable identifier of a source sample." ;
    sf:columnName "sample_id" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfstat:variableIdColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Variable ID" ;
    skos:definition "Stable source variable identifier or selected wide-layout column name." ;
    sf:columnName "variable_id" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfstat:componentColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Component" ;
    skos:definition "One-based latent component index." ;
    sf:columnName "component" ;
    sf:type "integer" ;
    sf:storageType "BIGINT" .

sfstat:scoreColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Score" ;
    skos:definition "Sample score on the selected principal component." ;
    sf:columnName "score" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:groupLabelColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Group label" ;
    skos:definition "Optional sample-level group label copied from the source table." ;
    sf:columnName "group_label" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfstat:loadingColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Loading" ;
    skos:definition "Variable or response loading on a latent component." ;
    sf:columnName "loading" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:eigenvalueColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Eigenvalue" ;
    skos:definition "Variance represented by a principal component." ;
    sf:columnName "eigenvalue" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:explainedVarianceRatioColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Explained variance ratio" ;
    skos:definition "Fraction of total variance represented by this component." ;
    sf:columnName "explained_variance_ratio" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:cumulativeVarianceColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Cumulative explained variance" ;
    skos:definition "Cumulative explained variance ratio through this component." ;
    sf:columnName "cumulative_explained_variance" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:xScoreColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "X score" ;
    skos:definition "Sample score in the predictor block for a PLS component." ;
    sf:columnName "x_score" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:yScoreColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Y score" ;
    skos:definition "Sample score in the response block for a PLS component." ;
    sf:columnName "y_score" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:blockColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Block" ;
    skos:definition "PLS matrix block represented by a loading row: x or y." ;
    sf:columnName "block" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfstat:itemIdColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Item ID" ;
    skos:definition "Predictor variable or selected response identifier for a PLS loading." ;
    sf:columnName "item_id" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfstat:predictorIdColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Predictor ID" ;
    skos:definition "Stable identifier of a predictor variable." ;
    sf:columnName "predictor_id" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfstat:responseIdColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Response ID" ;
    skos:definition "Selected numeric response column or categorical group column." ;
    sf:columnName "response_id" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfstat:coefficientColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Coefficient" ;
    skos:definition "Fitted PLS regression coefficient for a predictor-response pair." ;
    sf:columnName "coefficient" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:interceptColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Intercept" ;
    skos:definition "Fitted PLS regression intercept for a response." ;
    sf:columnName "intercept" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:observedValueColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Observed value" ;
    skos:definition "Observed numeric response; null for PLS-DA." ;
    sf:columnName "observed_value" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:predictedValueColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Predicted value" ;
    skos:definition "In-sample fitted numeric response; null for PLS-DA." ;
    sf:columnName "predicted_value" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:observedLabelColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Observed label" ;
    skos:definition "Observed categorical response label; null for numeric PLS." ;
    sf:columnName "observed_label" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfstat:predictedLabelColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Predicted label" ;
    skos:definition "PLS-DA class label with the greatest fitted score; null for numeric PLS." ;
    sf:columnName "predicted_label" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfstat:confidenceColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Confidence score" ;
    skos:definition "Maximum uncalibrated fitted class score for PLS-DA; null for numeric PLS." ;
    sf:columnName "confidence" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:meanGroupAColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Group A mean" ;
    skos:definition "Arithmetic mean for group A." ;
    sf:columnName "mean_group_a" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:meanGroupBColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Group B mean" ;
    skos:definition "Arithmetic mean for group B." ;
    sf:columnName "mean_group_b" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:log2FoldChangeColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Log2 fold change" ;
    skos:definition "Log2 of the pseudocount-adjusted group B mean divided by the group A mean." ;
    sf:columnName "log2_fold_change" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:effectSizeColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Hedges g" ;
    skos:definition "Small-sample-corrected standardized mean difference, group B minus group A." ;
    sf:columnName "effect_size" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:pValueColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Welch p-value" ;
    skos:definition "Two-sided Welch two-sample t-test p-value." ;
    sf:columnName "p_value" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:adjustedPValueColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Adjusted p-value" ;
    skos:definition "Benjamini-Hochberg adjusted p-value across tested variables." ;
    sf:columnName "adjusted_p_value" ;
    sf:type "real" ;
    sf:storageType "DOUBLE" .

sfstat:significantColumn
    a sf:Column ;
    sf:availableInDomain sfstat:statistics ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Significant" ;
    skos:definition "True when the adjusted p-value is below 0.05." ;
    sf:columnName "significant" ;
    sf:type "boolean" ;
    sf:storageType "BOOLEAN" .
