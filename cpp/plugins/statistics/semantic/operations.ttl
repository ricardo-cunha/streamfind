@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfstat: <https://streamfind.dev/catalogue/domains/statistics#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfstat:pca
    a sf:Operation ;
    sf:operationId "statistics.pca" ;
    sf:availableInDomain sfstat:statistics ;
    sf:providedByModule sfstat:analysisModule ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Principal component analysis" ;
    skos:definition "Validate a selected long- or wide-layout AnyTable as a complete numeric matrix, preprocess its variables, and compute PCA scores, loadings, explained variance, and diagnostics." ;
    sf:category "statistics" ;
    sf:hasParameter
        sfstat:layoutParameter,
        sfstat:sampleIdColumnParameter,
        sfstat:variableIdColumnParameter,
        sfstat:valueColumnParameter,
        sfstat:variableColumnsParameter,
        sfstat:groupColumnParameter,
        sfstat:preprocessingParameter,
        sfstat:nComponentsParameter ;
    sf:hasInputPort sfstat:tableInputPort ;
    sf:hasOutputPort
        sfstat:pcaScoresTable,
        sfstat:pcaLoadingsTable,
        sfstat:pcaVarianceTable,
        sfstat:pcaDiagnostics,
        sfcore:operationSuccessSignal .

sfstat:pls
    a sf:Operation ;
    sf:operationId "statistics.pls" ;
    sf:availableInDomain sfstat:statistics ;
    sf:providedByModule sfstat:analysisModule ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Partial least squares" ;
    skos:definition "Fit a native NIPALS PLS2 regression or one-hot PLS-DA model from a validated AnyTable matrix and emit scores, loadings, coefficients, in-sample predictions, and diagnostics." ;
    sf:category "statistics" ;
    sf:hasParameter
        sfstat:layoutParameter,
        sfstat:sampleIdColumnParameter,
        sfstat:variableIdColumnParameter,
        sfstat:valueColumnParameter,
        sfstat:variableColumnsParameter,
        sfstat:groupColumnParameter,
        sfstat:preprocessingParameter,
        sfstat:nComponentsParameter,
        sfstat:responseModeParameter,
        sfstat:responseColumnsParameter ;
    sf:hasInputPort sfstat:tableInputPort ;
    sf:hasOutputPort
        sfstat:plsScoresTable,
        sfstat:plsLoadingsTable,
        sfstat:plsCoefficientsTable,
        sfstat:plsPredictionsTable,
        sfstat:plsDiagnostics,
        sfcore:operationSuccessSignal .

sfstat:foldChange
    a sf:Operation ;
    sf:operationId "statistics.fold_change" ;
    sf:availableInDomain sfstat:statistics ;
    sf:providedByModule sfstat:analysisModule ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Two-group fold-change analysis" ;
    skos:definition "Compare non-negative values between two explicitly selected independent groups using Welch tests, Benjamini-Hochberg adjustment, Hedges g, and pseudocount-adjusted log2 fold change." ;
    sf:category "statistics" ;
    sf:hasParameter
        sfstat:layoutParameter,
        sfstat:sampleIdColumnParameter,
        sfstat:variableIdColumnParameter,
        sfstat:valueColumnParameter,
        sfstat:variableColumnsParameter,
        sfstat:groupColumnParameter,
        sfstat:groupAParameter,
        sfstat:groupBParameter,
        sfstat:pseudocountParameter ;
    sf:hasInputPort sfstat:tableInputPort ;
    sf:hasOutputPort
        sfstat:foldChangeTable,
        sfstat:foldChangeSummary,
        sfcore:operationSuccessSignal .
