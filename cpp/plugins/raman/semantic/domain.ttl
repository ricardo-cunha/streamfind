@prefix sfram: <https://streamfind.dev/catalogue/domains/raman#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfram:raman
    a sf:Domain ;
    skos:prefLabel "raman" ;
    skos:definition "Raman spectroscopy project domain." ;
    sf:guidance "Raman workflow: create or describe the project, discover canonical operations with get_operations(domain=raman), add configured operation nodes, connect typed ports, validate the graph, and run_workflow." .
