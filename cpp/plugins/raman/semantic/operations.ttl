@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfram: <https://streamfind.dev/catalogue/domains/raman#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfram:ramanAddAnalyses
    a sf:Operation ;
    sf:operationId "raman.add_analyses" ;
    sf:availableInDomain sfram:raman ;
    sf:projectEntry true ;
    skos:prefLabel "Add Raman analyses" ;
    skos:definition "Add Raman analysis files to a project." ;
    sf:hasParameter sfram:analysesParameter ;
    sf:hasOutputPort sfcore:operationStatusResult, sfcore:operationSuccessSignal .

sfram:ramanRemoveAnalyses
    a sf:Operation ;
    sf:operationId "raman.remove_analyses" ;
    sf:availableInDomain sfram:raman ;
    skos:prefLabel "Remove Raman analyses" ;
    skos:definition "Remove Raman analysis files from a project." ;
    sf:hasParameter sfcore:analysisNamesParameter ;
    sf:hasOutputPort sfcore:operationStatusResult, sfcore:operationSuccessSignal .
