@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfms: <https://streamfind.dev/catalogue/domains/mass_spec#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfms:addAnalysesResult
    a sf:Result ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Added mass spectrometry analyses" ;
    skos:definition "Table of analysis records persisted by add_analyses." ;
    sf:type "table" ;
    sf:hasProperty
        sfms:analysisNameColumn,
        sfms:filePathColumn,
        sfms:replicateNameColumn,
        sfms:blankNameColumn .

sfms:removeAnalysesResult
    a sf:Result ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Removed mass spectrometry analyses" ;
    skos:definition "Array of analysis names removed from the project." ;
    sf:type "array" ;
    sf:items sfms:analysisNameColumn .

sfms:getAnalysesInfoResult
    a sf:Result ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry analysis information" ;
    skos:definition "Table of persisted mass spectrometry analysis metadata." ;
    sf:type "table" ;
    sf:hasProperty
        sfms:analysisNameColumn,
        sfms:replicateNameColumn,
        sfms:blankNameColumn,
        sfms:filePathColumn,
        sfms:formatColumn,
        sfms:numberSpectraColumn,
        sfms:numberChromatogramsColumn .

sfms:analysisNamesResult
    a sf:Result ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry analysis names" ;
    skos:definition "Analysis names ordered as stored in the analyses table." ;
    sf:type "array" ;
    sf:items sfms:analysisNameColumn .

sfms:replicateNamesResult
    a sf:Result ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry replicate names" ;
    skos:definition "Replicate names ordered as stored in the analyses table." ;
    sf:type "array" ;
    sf:items sfms:replicateNameColumn .

sfms:blankNamesResult
    a sf:Result ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry blank names" ;
    skos:definition "Blank names ordered as stored in the analyses table." ;
    sf:type "array" ;
    sf:items sfms:blankNameColumn .

sfms:concentrationsResult
    a sf:Result ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry concentrations" ;
    skos:definition "Concentrations ordered as stored in the analyses table." ;
    sf:type "array" ;
    sf:items sfms:concentrationColumn .

sfms:updatedResult
    a sf:Result ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Updated mass spectrometry analyses" ;
    skos:definition "Number of analysis rows updated by a metadata operation." ;
    sf:type "object" ;
    sf:hasProperty sfms:updatedField .

sfms:spectraHeadersResult
    a sf:Result ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry spectra headers" ;
    skos:definition "Table of persisted spectra header records." ;
    sf:type "table" ;
