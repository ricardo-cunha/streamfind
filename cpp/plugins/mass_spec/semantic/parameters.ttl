    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum EIC size" ;
    skos:definition "Optional minimum number of points in the stored extracted-ion chromatogram; null disables." ;
    sf:type "integer" ;
    sf:required false ;
    sf:example 5 .

sfms:minSizeMs1Parameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum MS1 size" ;
    skos:definition "Optional minimum number of stored MS1 points; null disables." ;
    sf:type "integer" ;
    sf:required false ;
