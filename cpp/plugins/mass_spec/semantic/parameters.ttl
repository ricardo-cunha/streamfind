sfms:minSizeMs2Parameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum MS2 size" ;
    skos:definition "Optional minimum number of stored MS2 fragment peaks; null disables." ;
    sf:type "integer" ;
    sf:required false ;
    sf:example 5 .

sfms:minRelPresenceReplicateParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum relative presence in replicate" ;
    skos:definition "Optional minimum relative presence within replicate analyses; null disables." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 0.8 .

sfms:removeIsotopesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Remove isotopes" ;
    skos:definition "Whether isotope-annotated features should be removed." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example false .

sfms:removeAdductsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Remove adducts" ;
    skos:definition "Whether annotated adduct features should be removed." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example false .

sfms:removeLossesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Remove losses" ;
    skos:definition "Whether annotated neutral-loss or in-source fragment features should be removed." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example false .

sfms:namesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Names" ;
    skos:definition "Optional names to match; empty keeps all." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"caffeine\"]" .

sfms:minScoreParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum score" ;
    skos:definition "Optional minimum match score to keep; null disables." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 0.5 .

sfms:maxErrorRtParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum RT error" ;
    skos:definition "Optional maximum absolute retention-time error; null disables." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 30.0 .

sfms:maxErrorMassParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum mass error" ;
    skos:definition "Optional maximum absolute mass error; null disables." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 5.0 .

sfms:idLevelsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Identification levels" ;
    skos:definition "Optional identification levels to keep; empty keeps all." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:integerItemParameter ;
    sf:example "[1,2,3]" .


sfms:transformationProductRangeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Transformation product" ;
    skos:definition "One transformation-product candidate: product identity (name, transformation, at least one of SMILES/InChI/InChIKey) plus precursor and main-precursor descriptors." ;
    sf:type "object" ;
    sf:required true ;
    sf:example "{\"name\":\"Metoprolol O-dealkylation\",\"transformation\":\"O-Dealkylation\",\"precursor_name\":\"Metoprolol\",\"precursor_mass\":267.1834,\"SMILES\":\"COCCc1ccc(cc1)OCC(CNC(C)C)O\"}" ;
    sf:hasProperty
        sfms:tpProductNameField,
        sfms:tpTransformationField,
        sfms:tpPrecursorNameField,
        sfms:tpPrecursorFormulaField,
        sfms:tpPrecursorMassField,
        sfms:tpPrecursorSmilesField,
        sfms:tpPrecursorInChIField,
        sfms:tpPrecursorInChIKeyField,
        sfms:tpPrecursorXLogPField,
        sfms:tpMainPrecursorNameField,
        sfms:tpMainPrecursorFormulaField,
        sfms:tpMainPrecursorMassField,
        sfms:tpMainPrecursorSmilesField,
        sfms:tpMainPrecursorInChIField,
        sfms:tpMainPrecursorInChIKeyField,
        sfms:tpMainPrecursorXLogPField,
        sfms:suspectSmilesField,
        sfms:suspectInChIField,
        sfms:suspectInChIKeyField .

sfms:transformationProductsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Transformation products" ;
    skos:definition "Transformation-product candidate table (array of objects) used to assign plausible products to suspected features." ;
    sf:type "array" ;
    sf:required false ;
    sf:example "[{\"name\":\"Metoprolol O-dealkylation\",\"transformation\":\"O-Dealkylation\"}]" ;
    sf:items sfms:transformationProductRangeParameter .

sfms:chromatographicPhaseParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Chromatographic phase" ;
    skos:definition "Chromatographic phase used for RT-plausibility scoring: reverse_phase or hilic." ;
    sf:type "string" ;
    sf:required false ;
    sf:constraints "reverse_phase|hilic" ;
    sf:example "reverse_phase" .

sfms:databaseTypeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MetFrag database type" ;
    skos:definition "MetFrag candidate database: PubChem, CS, ChemSpider, LocalCSV, ... (R .normalize_metfrag_database_type)." ;
    sf:type "string" ;
    sf:required false ;
    sf:example "PubChem" .

sfms:databaseParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MetFrag candidate database" ;
    skos:definition "Local candidate database rows for LocalCSV mode: name, formula, mass, SMILES, InChI, InChIKey, xLogP." ;
    sf:type "array" ;
    sf:required false ;
    sf:example "[{\"name\":\"Metoprolol\",\"formula\":\"C15H25NO3\",\"mass\":267.1834}]" ;
    sf:items sfms:databaseRangeParameter .

sfms:databaseRangeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MetFrag database row" ;
    skos:definition "One local candidate database row." ;
    sf:type "object" ;
    sf:required true ;
    sf:example "{\"name\":\"Metoprolol\",\"mass\":267.1834}" ;
    sf:hasProperty
        sfms:suspectNameField,
        sfms:suspectFormulaField,
        sfms:targetMassField,
        sfms:suspectSmilesField,
        sfms:suspectInChIField,
        sfms:suspectInChIKeyField,
        sfms:suspectXLogPField .

sfms:topNParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MetFrag top N candidates" ;
    skos:definition "Maximum number of MetFrag candidate fragments retained per feature." ;
    sf:type "integer" ;
    sf:required false ;
    sf:example 5 .

sfms:scoreTypesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MetFrag score types" ;
    skos:definition "MetFrag scoring method names; paired with score_weights." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"FragmenterScore\"]" .

sfms:scoreWeightsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MetFrag score weights" ;
    skos:definition "Weights paired with score_types (same length)." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:realItemParameter ;
    sf:example "[1.0]" .

sfms:preProcessingCandidateFilterParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MetFrag pre-processing filters" ;
    skos:definition "MetFrag candidate filters applied before scoring." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"UnconnectedCompoundFilter\",\"IsotopeFilter\"]" .

sfms:postProcessingCandidateFilterParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MetFrag post-processing filters" ;
    skos:definition "MetFrag candidate filters applied after scoring." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"InChIKeyFilter\"]" .

sfms:maximumTreeDepthParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MetFrag maximum tree depth" ;
    skos:definition "Maximum MetFrag fragmentation tree depth." ;
    sf:type "integer" ;
    sf:required false ;
    sf:example 3 .

sfms:numberThreadsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MetFrag number of threads" ;
    skos:definition "Thread count for the MetFrag command line." ;
    sf:type "integer" ;
    sf:required false ;
    sf:example 1 .

sfms:useSmilesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MetFrag use SMILES" ;
    skos:definition "Whether the candidate SMILES is passed to MetFrag." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example true .

sfms:debugParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Debug" ;
    skos:definition "Whether to keep debug/result files (e.g. MetFrag PSV outputs)." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example false .

sfms:mergeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Merge peaks" ;
    skos:definition "Whether to merge nearby chromatographic peaks." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example true .

sfms:mergeDistanceParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Merge distance" ;
    skos:definition "Maximum distance between peak apices for merging, in retention-time units." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 45.0 .

sfms:minPeakHeightParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum peak height" ;
    skos:definition "Minimum apex intensity for a chromatographic peak to be accepted." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 0.0 .

sfms:minPeakDistanceParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum peak distance" ;
    skos:definition "Minimum distance between adjacent peak apices, in retention-time units." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 10.0 .

sfms:minPeakWidthParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum peak width" ;
    skos:definition "Minimum chromatographic peak width in retention-time units." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 5.0 .
