sfms:minCosineSimilarityParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum cosine similarity" ;
    skos:definition "Minimum cosine similarity for an MS2 match to be accepted." ;
