    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Matrix suppression RT window" ;
    skos:definition "Retention-time window used when computing matrix/suppression factors." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 60.0 .

