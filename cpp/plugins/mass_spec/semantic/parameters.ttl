sfms:onlyFilledParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Only filled features" ;
    skos:definition "Tri-state: true keeps only filled, false keeps only non-filled, null disables." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example true .

sfms:removeFilledParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Remove filled features" ;
    skos:definition "Whether features marked as filled should be removed." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example false .

