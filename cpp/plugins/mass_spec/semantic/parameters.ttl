sfms:rtDeviationParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "RT deviation" ;
    skos:definition "Retention-time deviation tolerance used when grouping features." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 5.0 .

sfms:minNumberTracesParameter
    a sf:Parameter ;
