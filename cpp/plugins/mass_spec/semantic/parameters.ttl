sfms:minTracesIntensityParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum trace intensity" ;
    skos:definition "Minimum intensity a spectrum must meet to be considered for feature spectrum loading." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 1000.0 .

sfms:rtExpandParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Retention-time expansion" ;
