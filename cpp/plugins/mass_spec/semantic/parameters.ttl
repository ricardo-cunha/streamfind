sfms:maxChargeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum charge" ;
    skos:definition "Maximum charge state considered during isotope annotation." ;
    sf:type "integer" ;
    sf:required false ;
    sf:example 1 .

sfms:maxGapsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum gaps" ;
    skos:definition "Maximum allowed gaps in a feature annotation chain." ;
    sf:type "integer" ;
    sf:required false ;
    sf:example 1 .

sfms:isotopeElementsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Isotope elements" ;
