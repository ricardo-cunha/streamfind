@prefix sfms: <https://streamfind.dev/catalogue/domains/mass_spec#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfms:levelsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MS levels" ;
    skos:definition "Optional mass spectrometry levels to include." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:integerItemParameter ;
    sf:example "[1,2]" .

sfms:rtMinParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum retention time" ;
    skos:definition "Optional lower retention-time bound." ;
    sf:type "real" ;
    sf:required false ;
    sf:units "seconds" ;
    sf:example 900.0 .

sfms:rtMaxParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum retention time" ;
    skos:definition "Optional upper retention-time bound." ;
    sf:type "real" ;
    sf:required false ;
    sf:units "seconds" ;
    sf:example 1200.0 .

sfms:mzMinParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum m/z" ;
    skos:definition "Optional lower m/z bound." ;
    sf:type "real" ;
    sf:required false ;
    sf:units "Thomson (m/z)" ;
    sf:example 100.0 .

sfms:mzMaxParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum m/z" ;
    skos:definition "Optional upper m/z bound." ;
    sf:type "real" ;
    sf:required false ;
    sf:units "Thomson (m/z)" ;
    sf:example 1000.0 .

sfms:indicesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Indices" ;
    skos:definition "Optional zero-based data row indices." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:integerItemParameter ;
    sf:example "[0,2]" .

sfms:rtWindowsMinParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Feature RT window minimums" ;
    skos:definition "Lower retention-time bounds for feature detection windows; omitted or empty means the full retention-time range." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:realItemParameter ;
    sf:example "[0.0]" .

sfms:rtWindowsMaxParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Feature RT window maximums" ;
    skos:definition "Upper retention-time bounds for feature detection windows; omitted or empty means the full retention-time range." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:realItemParameter ;
    sf:example "[1800.0]" .

sfms:methodParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Feature grouping alignment method" ;
    skos:definition "Alignment method used when grouping features across analyses: internal_standards or obi_warp." ;
    sf:type "string" ;
    sf:required false ;
    sf:constraints "internal_standards|obi_warp" ;
    sf:example "internal_standards" .


sfms:ppmThresholdParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Feature ppm threshold" ;
    skos:definition "Maximum relative m/z distance used to group MS1 traces." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 15.0 .

sfms:noiseThresholdParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Feature noise threshold" ;
    skos:definition "Minimum MS1 intensity considered during feature detection." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 250.0 .

sfms:minSnrParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum feature SNR" ;
    skos:definition "Minimum signal-to-noise ratio for a detected feature." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 3.0 .

sfms:minTracesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum feature traces" ;
    skos:definition "Minimum number of spectra contributing to a detected feature." ;
    sf:type "integer" ;
    sf:required false ;
    sf:example 3 .

sfms:baselineWindowParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Baseline window" ;
    skos:definition "Retention-time baseline window used by NTA peak detection." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 200.0 .

sfms:maxFeatureWidthParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum feature width" ;
    skos:definition "Maximum chromatographic peak width used by NTA peak detection." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 100.0 .

sfms:baseQuantileParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Base noise quantile" ;
    skos:definition "Base quantile for adaptive per-spectrum noise estimation." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 0.1 .

sfms:targetsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry targets" ;
    skos:definition "Optional array of independent target objects. Each target should identify one mass-spectrometry query using mass/mass bounds, m/z/m/z bounds, or SMILES/InChI; optional id, analyses, polarity, levels, and retention-time fields refine the match." ;
    sf:type "array" ;
    sf:required false ;
    sf:example "[{\"id\":\"caffeine\",\"mass\":194.0804}]" ;
    sf:items sfms:targetRangeParameter .

sfms:targetRangeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry target" ;
    skos:definition "One independent target object shared by raw-spectrum/EIC/feature queries and suspect/internal-standard screening. Provide at least one selector: mz for an exact measured m/z, mz_min and/or mz_max for an m/z interval, mass for an exact neutral mass, mass_min and/or mass_max for a neutral-mass interval, or SMILES/InChI for a chemical structure. Optional id labels the returned rows; analyses, polarity, levels, rt, rt_min, and rt_max narrow the match. Numeric fields are used directly. When only SMILES/InChI is supplied, Open Babel derives the exact mass and the selected polarity determines the adduct." ;
    sf:type "object" ;
    sf:required true ;
    sf:constraints "{\"anyOf\":[{\"required\":[\"mass\"]},{\"required\":[\"mass_min\"]},{\"required\":[\"mass_max\"]},{\"required\":[\"mz\"]},{\"required\":[\"mz_min\"]},{\"required\":[\"mz_max\"]},{\"required\":[\"SMILES\"]},{\"required\":[\"InChI\"]}]}" ;
    sf:example "{\"id\":\"caffeine\",\"SMILES\":\"CN1C=NC2=C1C(=O)N(C(=O)N2C)C\"}" ;
    sf:hasProperty
        sfms:targetIdField,
        sfms:suspectNameField,
        sfms:targetAnalysesField,
        sfms:targetPolarityField,
        sfms:targetLevelsField,
        sfms:targetMassField,
        sfms:targetMassMinField,
        sfms:targetMassMaxField,
        sfms:targetMzField,
        sfms:targetMzMinField,
        sfms:targetMzMaxField,
        sfms:targetRtField,
        sfms:targetRtMinField,
        sfms:targetRtMaxField,
        sfms:suspectFormulaField,
        sfms:suspectSmilesField,
        sfms:suspectInChIField,
        sfms:suspectInChIKeyField,
        sfms:suspectXLogPField,
        sfms:suspectScoreField,
        sfms:suspectDatabaseIdField,
        sfms:suspectFragmentsMzPosField,
        sfms:suspectFragmentsIntensityPosField,
        sfms:suspectFragmentsMzNegField,
        sfms:suspectFragmentsIntensityNegField .

sfms:polarityParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Ion polarity" ;
    skos:definition "Ion polarity: use 1 for positive ions, -1 for negative ions, or omit it to use the operation's default polarity handling." ;
    sf:type "integer" ;
    sf:required false ;
    sf:constraints "-1|1" ;
    sf:example 1 .

sfms:ppmParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass tolerance" ;
    skos:definition "Mass tolerance in parts per million. For an exact mz or mass target, this expands the matching interval around the target." ;
    sf:type "real" ;
    sf:required false ;
    sf:units "ppm" ;
    sf:constraints "{\"exclusiveMinimum\":0}" ;
    sf:example 20.0 .

sfms:rtToleranceParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Retention-time tolerance" ;
    skos:definition "Retention-time tolerance in seconds applied when a target supplies exact rt. It is not a substitute for rt_min/rt_max when an explicit interval is needed." ;
    sf:type "real" ;
    sf:required false ;
    sf:units "seconds" ;
    sf:constraints "{\"minimum\":0}" ;
    sf:example 60.0 .

sfms:chargeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Ion charge" ;
    skos:definition "Positive integer charge used when converting a neutral mass target to m/z. Omit it to use charge 1." ;
    sf:type "integer" ;
    sf:required false ;
    sf:constraints "{\"minimum\":1}" ;
    sf:example 1 .

sfms:mzClustParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "m/z clustering tolerance" ;
    skos:definition "Maximum m/z distance used when merging points." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 0.003 .

sfms:presenceParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Trace presence" ;
    skos:definition "Minimum fraction of unique retention times in which a cluster must appear." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 0.8 .

sfms:isolationWindowParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Isolation window" ;
    skos:definition "Precursor isolation window width." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 1.3 .

sfms:minIntensityMs1Parameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum MS1 intensity" ;
    skos:definition "Minimum peak intensity retained from MS1 spectra." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 1000.0 .

sfms:minIntensityMs2Parameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum MS2 intensity" ;
    skos:definition "Minimum peak intensity retained from MS2 spectra." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 100.0 .

sfms:chromatogramIdRegexParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Chromatogram ID regular expressions" ;
    skos:definition "Regular expressions used to select chromatogram identifiers." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"^TIC.*\"]" .

sfms:ignoreCaseParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Ignore chromatogram ID case" ;
    skos:definition "Whether chromatogram ID matching ignores case." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example true .

sfms:invertParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Invert chromatogram ID selection" ;
    skos:definition "Keep chromatograms that do not match the supplied regular expressions." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example false .

sfms:filteredParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Include filtered features" ;
    skos:definition "When false (default), features marked as filtered are excluded from spectrum loading." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example false .

sfms:rtWindowParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Retention-time window" ;
    skos:definition "Two-element [min, max] retention-time offset applied to each feature's detection window." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:realItemParameter ;
    sf:example "[0.0, 0.0]" .

sfms:mzWindowParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "m/z window" ;
    skos:definition "Two-element [min, max] m/z offset applied to each feature's m/z bounds." ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:realItemParameter ;
