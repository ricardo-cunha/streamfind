sfms:minAreaParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum feature area" ;
    skos:definition "Optional minimum integrated feature area; null disables." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 10000.0 .

sfms:minWidthParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
