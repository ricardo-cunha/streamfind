    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Global presence threshold" ;
    skos:definition "Minimum presence across all analyses for an MS2 peak to be retained." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 0.0 .

