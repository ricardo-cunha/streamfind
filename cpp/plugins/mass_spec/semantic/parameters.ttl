sfms:maxAsymmetryParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum asymmetry" ;
    skos:definition "Optional maximum accepted peak asymmetry; null disables." ;
    sf:type "real" ;
    sf:required false ;
