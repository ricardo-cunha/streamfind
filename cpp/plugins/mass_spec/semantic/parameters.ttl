sfms:relMinIntensityParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Relative minimum intensity" ;
    skos:definition "Relative minimum intensity threshold applied to MS2 peaks." ;
    sf:type "real" ;
    sf:required false ;
    sf:example 0.01 .

sfms:blankCleanParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Blank clean MS2" ;
    skos:definition "Whether MS2 peaks found in blank analyses are removed." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:example true .

sfms:blankPresenceThresholdParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
