    skos:definition "Minimum chromatographic peak width in retention-time units." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.0 ;
    sf:example 5.0 .

sfms:analysisNamesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analysis names" ;
    skos:definition "Array of analysis names to process. When omitted or empty, all analyses in the project are processed. Use this to limit baseline correction, smoothing, or peak detection to specific analyses." ;
    sf:type "array" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default "[]" ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"sample1\"]" .

sfms:baselineAlgorithmParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Baseline correction algorithm" ;
    skos:definition "Algorithm used to estimate the chromatographic baseline before peak detection. Supported values: none (no correction), rolling_min (sliding-window minimum, fast and robust for well-separated peaks, controlled by window_size), als (asymmetric least-squares, fits a smooth baseline that hugs signal minima while ignoring peaks, controlled by lambda and asymmetry_penalty, better for drifting baselines or overlapping peaks), moving_average (sliding-window arithmetic mean, follows broad trends well, controlled by window_size, best for smooth gradient elution profiles without sharp peaks)." ;
    sf:type "string" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default "rolling_min" ;
    sf:example "rolling_min" .

sfms:smoothingAlgorithmParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Smoothing algorithm" ;
    skos:definition "Algorithm used to reduce high-frequency noise in the processed chromatogram signal. Supported values: none (no smoothing), moving_average (sliding-window arithmetic mean, removes noise but broadens peaks, controlled by window_size), savitzky_golay (polynomial local regression, preserves peak shape and height better than moving average, controlled by window_size and poly_order)." ;
    sf:type "string" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default "savitzky_golay" ;
    sf:example "savitzky_golay" .

sfms:windowSizeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Window size" ;
    skos:definition "Number of data points in the sliding window. For rolling_min baseline: half-width of the minimum-finding window, typical range 20-200 points. For moving_average smoothing: full width of the averaging window, must be odd. For savitzky_golay smoothing: full width of the polynomial fitting window, must be odd and at least poly_order + 1, typical range 5-21 points." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default 0 ;
    sf:example 50 .

sfms:polyOrderParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Polynomial order" ;
    skos:definition "Order of the local polynomial used by Savitzky-Golay smoothing. Must be less than window_size. A value of 2 (quadratic) preserves peak heights well and is the most common choice. Higher orders (3-5) follow the signal more closely but remove less noise. Typical range: 2-3." ;
    sf:type "integer" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default 2 ;
    sf:example 2 .

sfms:lambdaParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "ALS smoothness parameter" ;
    skos:definition "Smoothness penalty (lambda) for asymmetric least-squares baseline correction. Lambda is auto-scaled by the signal range squared, so this value controls relative smoothness. A larger value produces a smoother baseline that follows broad trends; a smaller value allows the baseline to follow rapid changes. Typical range: 0.1-10. Default 1.0 works well for most chromatographic data. Only used when baseline_algorithm is als." ;
    sf:type "real" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default 1.0 ;
    sf:example 1.0 .

sfms:asymmetryPenaltyParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "ALS asymmetry penalty" ;
    skos:definition "Asymmetry weight (p) for ALS baseline correction. Controls how aggressively the baseline avoids peaks: a smaller value places more weight below peaks, producing a lower baseline; a larger value (closer to 0.5) treats the signal more symmetrically. Typical range: 0.001-0.1. Default 0.01 works well for most chromatographic data. Only used when baseline_algorithm is als." ;
    sf:type "real" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default 0.01 ;
    sf:example 0.01 .

sfms:maxIterationsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "ALS maximum iterations" ;
    skos:definition "Maximum number of iterations for the asymmetric least-squares baseline algorithm. More iterations give a more converged baseline but take longer. Typical range: 5-20. Default 10 is sufficient for most chromatograms. Only used when baseline_algorithm is als." ;
    sf:type "integer" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default 10 ;
    sf:example 10 .

sfms:sourcePathsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MS source paths" ;
    skos:definition "Files or vendor directories to read and discover as logical mass-spectrometry analyses." ;
    sf:type "array" ;
    sf:required true ;
    sf:items sfms:filePathColumn ;
    sf:default "[]" ;
    sf:example "[\"data/sample.wiff\",\"data/control.mzML\",\"data/batch.d\"]" .
