sfms:minIntensityParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum feature intensity" ;
    skos:definition "Optional minimum feature apex intensity; null disables." ;
