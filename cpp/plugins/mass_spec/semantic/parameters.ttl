    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum signal-to-noise" ;
    skos:definition "Optional minimum signal-to-noise threshold; null disables." ;
    sf:type "real" ;
    sf:required false ;
