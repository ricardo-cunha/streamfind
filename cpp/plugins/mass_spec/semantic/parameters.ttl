sfms:mzExpandParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "m/z expansion" ;
    skos:definition "m/z tolerance expanded around a target feature when matching across analyses." ;
    sf:type "real" ;
    sf:required false ;
