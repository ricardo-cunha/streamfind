sfms:maxIsotopesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum isotopes" ;
    skos:definition "Maximum number of isotopes considered per element during annotation." ;
    sf:type "integer" ;
    sf:required false ;
