    sf:required false ;
    sf:example 0.7 .

sfms:minSharedFragmentsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum shared fragments" ;
    skos:definition "Minimum number of shared MS2 fragments required for an assignment." ;
    sf:type "integer" ;
    sf:required false ;
    sf:example 3 .

sfms:topParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Top peaks" ;
    skos:definition "Maximum number of MS2 peaks retained per feature; 0 means no limit." ;
    sf:type "integer" ;
    sf:required false ;
