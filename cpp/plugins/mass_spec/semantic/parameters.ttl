    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum asymmetry" ;
    skos:definition "Optional minimum accepted peak asymmetry; null disables." ;
    sf:type "real" ;
    sf:required false ;
