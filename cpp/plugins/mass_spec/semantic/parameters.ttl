sfms:minSamplesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum samples" ;
    skos:definition "Minimum number of analyses in which a feature must appear to form a group." ;
