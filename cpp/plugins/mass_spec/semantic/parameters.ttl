@prefix sfms: <https://streamfind.dev/catalogue/domains/mass_spec#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfms:debugRtParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Debug RT" ;
    skos:definition "Optional retention time used to select a component-creation diagnostic trace. Zero disables RT debugging." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.0 ;
    sf:example 120.0 .

sfms:debugComponentParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Debug component" ;
    skos:definition "Optional component identifier to include in annotation diagnostics. Empty disables component debugging." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "component_1" .

sfms:levelsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MS levels" ;
    skos:definition "Optional mass spectrometry levels to include." ;
    sf:type "array" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default "[1,2]" ;
    sf:items sfcore:integerItemParameter ;
    sf:example "[1,2]" .

sfms:plotDownsizeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Plot downsize" ;
    skos:definition "Optional retention-time bin width used to average TIC points before plotting." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.0 ;
    sf:units "seconds" ;
    sf:example 5.0 .

sfms:plotGroupByParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Plot group" ;
    skos:definition "TIC trace grouping key." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "analysis" ;
    sf:enum "analysis,replicate,polarity,level" ;
    sf:example "analysis" .

sfms:plotTitleParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Plot title" ;
    skos:definition "Optional visualization title." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "Total Ion Chromatograms (TICs)" ;
    sf:example "Total Ion Chromatograms (TICs)" .

sfms:plotXLabelParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Plot x-axis label" ;
    skos:definition "Optional x-axis label." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "Retention time / seconds" ;
    sf:example "Retention time / seconds" .

sfms:plotYLabelParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Plot y-axis label" ;
    skos:definition "Optional y-axis label." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "Intensity / counts" ;
    sf:example "Intensity / counts" .

sfms:rtMinParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum retention time" ;
    skos:definition "Optional lower retention-time bound." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.0 ;
    sf:units "seconds" ;
    sf:example 900.0 .

sfms:rtMaxParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum retention time" ;
    skos:definition "Optional upper retention-time bound." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.0 ;
    sf:units "seconds" ;
    sf:example 1200.0 .

sfms:mzMinParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum m/z" ;
    skos:definition "Optional lower m/z bound." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.0 ;
    sf:units "Thomson (m/z)" ;
    sf:example 100.0 .

sfms:mzMaxParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum m/z" ;
    skos:definition "Optional upper m/z bound." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.0 ;
    sf:units "Thomson (m/z)" ;
    sf:example 1.0 .

sfms:indicesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Indices" ;
    skos:definition "Optional zero-based data row indices." ;
    sf:type "array" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default "[]" ;
    sf:items sfcore:integerItemParameter ;
    sf:example "[0,2]" .

sfms:rtWindowsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Retention-time windows" ;
    skos:definition "Optional retention-time windows for feature detection. Each row contains an inclusive lower bound in rtmin and upper bound in rtmax; omitted or empty means the full retention-time range." ;
    sf:type "table" ;
    sf:tableContract sfms:rtWindowsTable ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default "[]" ;
    sf:example "[{\"rtmin\":0,\"rtmax\":1800}]" .


sfms:methodParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Feature grouping alignment method" ;
    skos:definition "Alignment method used when grouping features across analyses: internal_standards or obi_warp." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "obi_warp" ;
    sf:constraints "internal_standards|obi_warp" ;
    sf:example "internal_standards" .


sfms:ppmThresholdParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Feature ppm threshold" ;
    skos:definition "Maximum relative m/z distance used to group MS1 traces." ;
    sf:type "real" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default 10.0 ;
    sf:example 10.0 .

sfms:noiseThresholdParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Feature noise threshold" ;
    skos:definition "Minimum MS1 intensity considered during feature detection." ;
    sf:type "real" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default 250.0 ;
    sf:example 250.0 .

sfms:minSnrParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum feature SNR" ;
    skos:definition "Minimum signal-to-noise ratio for a detected feature." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 3.0 ;
    sf:example 3.0 .

sfms:minTracesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum feature traces" ;
    skos:definition "Minimum number of spectra contributing to a detected feature." ;
    sf:type "integer" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default 3 ;
    sf:example 3 .

sfms:baselineWindowParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Baseline window" ;
    skos:definition "Retention-time baseline window used by NTA peak detection." ;
    sf:type "real" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default 200.0 ;
    sf:example 200.0 .

sfms:maxFeatureWidthParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum feature width" ;
    skos:definition "Maximum chromatographic peak width used by NTA peak detection." ;
    sf:type "real" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default 250.0 ;
    sf:example 250.0 .

sfms:baseQuantileParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Base noise quantile" ;
    skos:definition "Base quantile for adaptive per-spectrum noise estimation." ;
    sf:type "real" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default 0.99 ;
    sf:example 0.99 .

sfms:targetsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry targets" ;
    skos:definition "Optional target rows supplied inline as schema-validated JSON or through a connection to a persisted targets table artifact. For feature matching, provide mass or mz, optionally rt or explicit bounds, and optionally analysis, polarity, and name. Formula, SMILES, InChI, and InChIKey are accepted target metadata but do not replace mass or mz matching." ;
    sf:guidance "Use an array of objects such as [{\"mass\":267.1834,\"name\":\"Metoprolol\"}]. Omit analysis_names and analysis to search all analyses. Omit polarity to search both polarities; include polarity in a row only when it is a deliberate constraint. A mass or mz value is expanded by ppm; an exact rt value is expanded by rt_tolerance seconds. Use mass_min/mass_max, mzmin/mzmax, or rtmin/rtmax for explicit inclusive ranges. The returned featuresTable is a new persisted artifact." ;
    sf:type "table" ;
    sf:tableContract sfms:targetsTable ;
    sf:required false ;
    sf:default "[]" ;
    sf:example "[{\"name\":\"caffeine\",\"mass\":194.0804},{\"name\":\"acetaminophen\",\"mass\":151.0633}]" .

sfms:targetsCsvPathParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Targets CSV path" ;
    skos:definition "CSV file containing target rows. A target requires mass or mz, while optional chemical structure columns are normalized with Open Babel when supplied." ;
    sf:type "string" ;
    sf:required true ;
    sf:defaultRequired true ;
    sf:default "" ;
    sf:extensions ".csv" ;
    sf:example "bindings/r/dev/dev_duckdb/suspects.csv" .

sfms:suspectTargetsCsvPathParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Suspect targets CSV path" ;
    skos:definition "CSV file containing validated suspect chemical identities and optional positive- and negative-mode MS2 reference peaks." ;
    sf:type "string" ;
    sf:required true ;
    sf:defaultRequired true ;
    sf:default "" ;
    sf:extensions ".csv" ;
    sf:example "bindings/r/dev/dev_duckdb/suspects.csv" .

sfms:molFilePathParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MOL file path" ;
    skos:definition "Path to one MDL MOL file containing a chemical structure. Open Babel reads the structure and derives the canonical SMILES, formula, InChI, InChIKey, exact mass, and optional xLogP." ;
    sf:type "string" ;
    sf:required true ;
    sf:defaultRequired true ;
    sf:default "" ;
    sf:extensions ".mol" ;
    sf:example "structures/caffeine.mol" .

sfms:compoundNameParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Compound name" ;
    skos:definition "Optional name assigned to the suspect target. When empty, the MOL title is used and then Compound is used as a fallback." ;
    sf:type "string" ;
    sf:required false ;
    sf:defaultRequired true ;
    sf:default "Compound" ;
    sf:example "Caffeine" .

sfms:suspectTargetsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry suspect targets" ;
    skos:definition "Optional suspect or candidate rows supplied inline or through a persisted suspect-targets table. Rows may provide chemical identity through SMILES, InChI, formula, mass, or m/z; retention time and positive- or negative-mode MS2 reference fragments are optional." ;
    sf:type "table" ;
    sf:tableContract sfms:suspectTargetsTable ;
    sf:required false ;
    sf:default "[]" ;
    sf:example "[{\"name\":\"caffeine\",\"mass\":194.0804,\"fragments_mz_pos\":[138.066]}]" .

sfms:polarityParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Ion polarity" ;
    skos:definition "Ion polarity: use 1 for positive ions, -1 for negative ions, or omit it to use the operation's default polarity handling." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default 0 ;
    sf:constraints "-1|1" ;
    sf:example 1 .

sfms:ppmParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass tolerance" ;
    skos:definition "Mass tolerance in parts per million. For an exact mz or mass target, this expands the matching interval around the target." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 10.0 ;
    sf:units "ppm" ;
    sf:constraints "{\"exclusiveMinimum\":0}" ;
    sf:example 10.0 .

sfms:rtToleranceParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Retention-time tolerance" ;
    skos:definition "Retention-time tolerance in seconds applied when a target supplies exact rt. It is not a substitute for rt_min/rt_max when an explicit interval is needed." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 60.0 ;
    sf:units "seconds" ;
    sf:constraints "{\"minimum\":0}" ;
    sf:example 60.0 .

sfms:chargeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Ion charge" ;
    skos:definition "Positive integer charge used when converting a neutral mass target to m/z. Omit it to use charge 1." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default 1 ;
    sf:constraints "{\"minimum\":1}" ;
    sf:example 1 .

sfms:mzClustParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "m/z clustering tolerance" ;
    skos:definition "Maximum m/z distance used when merging points." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.003 ;
    sf:example 0.003 .

sfms:presenceParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Trace presence" ;
    skos:definition "Minimum fraction of unique retention times in which a cluster must appear." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.8 ;
    sf:example 0.8 .

sfms:isolationWindowParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Isolation window" ;
    skos:definition "Precursor isolation window width." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 1.3 ;
    sf:example 1.3 .

sfms:minIntensityMs1Parameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum MS1 intensity" ;
    skos:definition "Minimum peak intensity retained from MS1 spectra." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 50.0 ;
    sf:example 50.0 .

sfms:minIntensityMs2Parameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum MS2 intensity" ;
    skos:definition "Minimum peak intensity retained from MS2 spectra." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 5.0 ;
    sf:example 5.0 .

sfms:chromatogramIdRegexParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Chromatogram ID regular expressions" ;
    skos:definition "Regular expressions used to select chromatogram identifiers." ;
    sf:type "array" ;
    sf:required false ;
    sf:default "[]" ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"^TIC.*\"]" .

sfms:ignoreCaseParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Ignore chromatogram ID case" ;
    skos:definition "Whether chromatogram ID matching ignores case." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:default false ;
    sf:example true .

sfms:invertParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Invert chromatogram ID selection" ;
    skos:definition "Keep chromatograms that do not match the supplied regular expressions." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:default false ;
    sf:example false .

sfms:filteredParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Include filtered features" ;
    skos:definition "When false (default), features marked as filtered are excluded from the returned feature table. Set true to include them." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:default false ;
    sf:example false .

sfms:rtWindowParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Retention-time window" ;
    skos:definition "Two-element [min, max] retention-time offset applied to each feature's detection window." ;
    sf:type "array" ;
    sf:required false ;
    sf:default "[-2.5, 2.5]" ;
    sf:items sfcore:realItemParameter ;
    sf:example "[-2.5, 2.5]" .

sfms:mzWindowParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "m/z window" ;
    skos:definition "Two-element [min, max] m/z offset applied to each feature's m/z bounds." ;
    sf:type "array" ;
    sf:required false ;
    sf:default "[]" ;
    sf:items sfcore:realItemParameter ;
    sf:example "[0.0, 0.0]" .

sfms:minTracesIntensityParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum trace intensity" ;
    skos:definition "Minimum intensity a spectrum must meet to be considered for feature spectrum loading." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.0 ;
    sf:example 1.0 .

sfms:rtExpandParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Retention-time expansion" ;
    skos:definition "Retention-time window expanded around a target feature when matching across analyses." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 10.0 ;
    sf:example 10.0 .

sfms:mzExpandParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "m/z expansion" ;
    skos:definition "m/z tolerance expanded around a target feature when matching across analyses." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.005 ;
    sf:example 0.005 .

sfms:minCorrelationParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum correlation" ;
    skos:definition "Minimum Pearson correlation between feature EICs required to join them into a component." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.8 ;
    sf:example 0.8 .

sfms:maxIsotopesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum isotopes" ;
    skos:definition "Maximum number of isotopes considered per element during annotation." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default 8 ;
    sf:example 8 .

sfms:maxChargeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum charge" ;
    skos:definition "Maximum charge state considered during isotope annotation." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default 1 ;
    sf:example 1 .

sfms:maxGapsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum gaps" ;
    skos:definition "Maximum allowed gaps in a feature annotation chain." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default 1 ;
    sf:example 1 .

sfms:isotopeElementsParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Isotope elements" ;
    skos:definition "Elements and allowed isotope-count ranges for annotation. Each entry must use Element:min-max syntax, such as C:1-80." ;
    sf:type "array" ;
    sf:required false ;
    sf:default "[\"C:1-80\",\"N:0-10\",\"O:0-20\",\"S:0-4\",\"Cl:0-6\",\"Br:0-4\"]" ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"C:1-80\",\"N:0-10\",\"O:0-20\",\"S:0-4\",\"Cl:0-6\",\"Br:0-4\"]" .

sfms:minSamplesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum samples" ;
    skos:definition "Minimum number of analyses in which a feature must appear to form a group." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default 1 ;
    sf:example 2 .

sfms:binSizeParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Group bin size" ;
    skos:definition "Retention-time bin size used when grouping features." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 5.0 ;
    sf:example 5.0 .

sfms:rtDeviationParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "RT deviation" ;
    skos:definition "Retention-time deviation tolerance used when grouping features." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 5.0 ;
    sf:example 5.0 .

sfms:minNumberTracesParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum number of traces" ;
    skos:definition "Minimum number of EIC traces required to fill a feature gap." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default 5 ;
    sf:example 5 .

sfms:rtApexDeviationParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "RT apex deviation" ;
    skos:definition "Maximum retention-time deviation of a detected peak apex from the expected feature RT." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 1.0 ;
    sf:example 1.0 .

sfms:minSignalToNoiseRatioParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum signal-to-noise ratio" ;
    skos:definition "Minimum signal-to-noise ratio for a filled feature peak." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 3.0 ;
    sf:example 3.0 .

sfms:minGaussianFitParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum Gaussian fit" ;
    skos:definition "Minimum Gaussian fit R-squared for a filled feature peak." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.2 ;
    sf:example 0.2 .

sfms:maxPeakWidthParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum peak width" ;
    skos:definition "Maximum chromatographic peak width allowed for a filled feature." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 30.0 ;
    sf:example 30.0 .

sfms:withinReplicateParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
