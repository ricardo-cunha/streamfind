sfms:minCorrelationParameter
    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum correlation" ;
    skos:definition "Minimum Pearson correlation between feature EICs required to join them into a component." ;
    sf:type "real" ;
    sf:required false ;
