    a sf:Parameter ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "MS2 m/z ratio tolerance" ;
    skos:definition "m/z tolerance used when matching MS2 fragment ratios." ;
    sf:type "real" ;
    sf:required false ;
