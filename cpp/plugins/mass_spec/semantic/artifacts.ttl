sfms:analysisNamesResult
    a sf:OperationResult ;
    sf:availableInDomain sfms:mass_spec ;
    sf:dataKind "json" ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry analysis names" ;
    skos:definition "Analysis names ordered as stored in the analyses table." ;
    sf:type "array" ;
    sf:items sfms:analysisNameColumn .

sfms:replicateNamesResult
    a sf:OperationResult ;
    sf:availableInDomain sfms:mass_spec ;
    sf:dataKind "json" ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry replicate names" ;
    skos:definition "Replicate names ordered as stored in the analyses table." ;
    sf:type "array" ;
    sf:items sfms:replicateNameColumn .

sfms:blankNamesResult
    a sf:OperationResult ;
