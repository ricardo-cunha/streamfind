@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfms: <https://streamfind.dev/catalogue/domains/mass_spec#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfms:analysesTable
    a sf:Table ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Mass spectrometry analyses table" ;
    skos:definition "Persisted summary and metadata for imported mass spectrometry analyses." ;
    sf:tableContractName "MASS_SPEC_ANALYSES" ;
    sf:dataKind "duckdb_table" ;
    sf:hasColumn
        sfms:analysisNameColumn,
        sfms:analysisIndexColumn,
        sfms:sourceAnalysisNumberColumn,
        sfms:replicateNameColumn,
        sfms:blankNameColumn,
        sfms:fileNameColumn,
        sfms:filePathColumn,
        sfms:fileDirColumn,
        sfms:fileExtensionColumn,
        sfms:formatColumn,
        sfms:typeColumn,
        sfms:timeStampColumn,
        sfms:numberSpectraColumn,
        sfms:numberChromatogramsColumn,
        sfms:numberSpectraBinaryArraysColumn,
        sfms:minMzColumn,
        sfms:maxMzColumn,
        sfms:startRtColumn,
        sfms:endRtColumn,
        sfms:hasIonMobilityColumn,
        sfms:concentrationColumn,
        sfcore:createdAtColumn .

sfms:spectraHeadersTable
    a sf:Table ;
    sf:availableInDomain sfms:mass_spec ;
