sfms:filterFeaturesMassSpecMethod
    a sf:Method ;
    sf:methodId "mass_spec.filter_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Filter features" ;
    skos:definition "Remove or flag features failing signal, shape, and quality criteria." ;
