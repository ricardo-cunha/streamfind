sfms:groupFeaturesMassSpecMethod
    a sf:Method ;
    sf:methodId "mass_spec.group_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Group features" ;
    skos:definition "Group features across analyses into shared feature groups using RT/mass tolerance and an alignment method." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:methodParameter,
        sfms:rtDeviationParameter,
        sfms:ppmParameter,
        sfms:minSamplesParameter,
        sfms:binSizeParameter ;
    sf:cacheable true ;
    sf:singleOccurrence false ;
    sf:reads sfms:analysesTable, sfms:ntaFeaturesTable ;
    sf:conditionalRead [ a sf:ReadDependency ; sf:table sfms:internalStandardsTable ; sf:when sfms:methodParameter ; sf:equals "internal_standards" ] ;
    sf:writes sfms:ntaFeaturesTable ;
    sf:returns sfcore:operationStatusResult .

