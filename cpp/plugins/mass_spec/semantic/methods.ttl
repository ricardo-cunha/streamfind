sfms:assignTransformationProductsMassSpecMethod
    a sf:Method ;
    sf:methodId "mass_spec.assign_transformation_products" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Assign transformation products" ;
    skos:definition "Assign plausible biotransformation products to suspected features using transformation-product candidates, scoring combinations by mass/MS2 cosine similarity and logP-based retention-time plausibility, and append the assignments to the suspect results." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:transformationProductsParameter,
        sfms:chromatographicPhaseParameter,
        sfms:mzrMs2Parameter ;
    sf:cacheable true ;
    sf:singleOccurrence false ;
    sf:reads sfms:analysesTable, sfms:ntaFeaturesTable, sfms:suspectsTable ;
    sf:writes sfms:suspectsTable, sfms:transformationProductsTable ;
    sf:returns sfcore:operationStatusResult .



sfms:metfragScreeningMassSpecMethod
    a sf:Method ;
    sf:methodId "mass_spec.metfrag_screening" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Screen features with MetFrag" ;
    skos:definition "Run in-silico MetFrag fragmenter screening for detected features: write per-feature MetFrag input, invoke the MetFrag command line (Java) from the ~/.streamfind tool layout, and rank resulting candidate fragments into the suspect results." ;
    sf:guidance "Requires Java 21 and MetFragCL. Installation is explicit and never automatic: run 'streamfind-cli tools install java' and 'streamfind-cli tools install metfrag', then retry this method." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:databaseTypeParameter,
        sfms:databaseParameter,
        sfms:ppmParameter,
        sfms:secParameter,
        sfms:ppmMs2Parameter,
        sfms:mzrMs2Parameter,
        sfms:topNParameter,
        sfms:scoreTypesParameter,
        sfms:scoreWeightsParameter,
        sfms:preProcessingCandidateFilterParameter,
        sfms:postProcessingCandidateFilterParameter,
        sfms:maximumTreeDepthParameter,
        sfms:numberThreadsParameter,
        sfms:useSmilesParameter,
        sfms:filteredParameter,
        sfms:debugParameter ;
    sf:cacheable true ;
    sf:singleOccurrence false ;
    sf:reads sfms:analysesTable, sfms:ntaFeaturesTable ;
    sf:writes sfms:ntaFeaturesTable, sfms:suspectsTable ;
    sf:returns sfcore:operationStatusResult .
