sfms:getRawSpectra
    a sf:Operation ;
    sf:operationId "mass_spec.get_raw_spectra" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Get raw spectra" ;
    skos:definition "Read flattened raw spectrum points. analysis_names selects analyses first; non-empty indices selects spectra and takes priority over targets; targets are used when indices are omitted or empty." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter,
        sfms:levelsParameter,
        sfms:targetsParameter,
        sfms:polarityParameter,
        sfms:ppmParameter,
        sfms:rtToleranceParameter,
        sfms:chargeParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:spectraTable, sfcore:operationSuccessSignal .

sfms:getRawSpectraEic
    a sf:Operation ;
    sf:operationId "mass_spec.get_raw_spectra_eic" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Get extracted ion chromatograms" ;
    skos:definition "Read MS1 raw points grouped as extracted-ion chromatograms for independent mass/mz target ranges; optional analysis, polarity, level, and retention-time fields narrow the result." ;
    sf:category "mass-spec-query" ;
    sf:guidance "Use mz for a measured ion such as 275.23457 or mass for a neutral mass. Set polarity to 1 or -1 when known, ppm for mass tolerance, and rt_min/rt_max for an explicit seconds window. Use the operation catalogue and tools/list to discover this operation; do not use method discovery." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:targetsParameter,
        sfms:polarityParameter,
        sfms:ppmParameter,
        sfms:rtToleranceParameter,
        sfms:chargeParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:eicTable, sfcore:operationSuccessSignal .

