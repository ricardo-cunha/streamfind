@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfms: <https://streamfind.dev/catalogue/domains/mass_spec#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfms:readMassSpecFiles
    a sf:Operation ;
    sf:operationId "mass_spec.read_mass_spec_files" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Read mass spectrometry files" ;
    skos:definition "Read one or more mass-spectrometry files or vendor directories, discover their logical analyses, and persist analysis, spectra-header, and chromatogram-header metadata." ;
    sf:category "mass-spec-ingestion" ;
    sf:projectEntry true ;
    sf:guidance "Provide an array of supported mass-spectrometry file or vendor-directory paths. Replicate and blank labels are initially empty and can be assigned by subsequent operations." ;
    sf:hasParameter sfms:sourcePathsParameter ;
    sf:hasOutputPort sfms:analysesTable, sfms:spectraHeadersTable, sfms:chromatogramsHeadersTable, sfcore:operationSuccessSignal .

sfms:removeAnalyses
    a sf:Operation ;
    sf:operationId "mass_spec.remove_analyses" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Remove mass spectrometry analyses" ;
    skos:definition "Read the analyses table and remove every analysis whose name matches at least one ECMAScript regular-expression pattern." ;
    sf:guidance "Provide analysis_names as exact names or regex patterns. Plain strings match one exact analysis name. Use ^prefix for a prefix batch, suffix$ for a suffix batch, or .*middle.* for text occurring anywhere in the name. Regex matching uses ECMAScript syntax, is case-sensitive, and uses regex search.\n\nExamples:\n[\"sample_exact\"]\nRemoves one exact analysis.\n\n[\"^QC_\"]\nRemoves all analyses beginning with QC_.\n\n[\"_blank$\"]\nRemoves all analyses ending with _blank.\n\n[\".*blank.*\"]\nRemoves all analyses containing blank anywhere in the name; because matching uses regex search, [\"blank\"] is equivalent." ;
    sf:hasParameter sfcore:analysisNamesParameter ;
    sf:hasInputPort sfms:analysesTable ;
    sf:hasOutputPort sfms:analysesTable, sfcore:operationSuccessSignal .

sfms:getAnalyses
    a sf:Operation ;
    sf:operationId "mass_spec.get_analyses" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Get mass spectrometry analyses" ;
    skos:definition "Return a filtered subset of the persisted mass-spectrometry analyses table." ;
    sf:category "mass-spec-inspection" ;
    sf:guidance "Use after read_mass_spec_files to select analysis rows and confirm the exact analysis names accepted by later analysis_names parameters." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter ;
    sf:hasInputPort sfms:analysesTable ;
    sf:hasOutputPort sfms:analysesTable, sfcore:operationSuccessSignal .

sfms:getAnalysisNames
    a sf:Operation ;
    sf:operationId "mass_spec.get_analysis_names" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Get mass spectrometry analysis names" ;
    skos:definition "Return the canonical analysis names registered in the project. Names are normally the source file stem and are passed to analysis_names in later operations and methods." ;
    sf:category "mass-spec-inspection" ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter ;
    sf:hasInputPort sfms:analysesTable ;
    sf:hasOutputPort sfms:analysisNamesResult, sfcore:operationSuccessSignal .

sfms:getReplicateNames
    a sf:Operation ;
