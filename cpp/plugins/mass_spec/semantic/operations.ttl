    skos:prefLabel "Get raw chromatograms" ;
    skos:definition "Read chromatogram point records directly from the selected mass spectrometry files. Returns the same column structure as get_chromatograms (analysis, replicate, index, chromatogram_id, polarity, precursor_mz, activation_ce, product_mz, signal_type, chromatogram_type, detector, channel, wavelength_nm, units, rt, raw_intensity, baseline, intensity)." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:chromatogramsHeadersTable ;
    sf:hasOutputPort sfms:chromatogramsTable, sfcore:operationSuccessSignal .

