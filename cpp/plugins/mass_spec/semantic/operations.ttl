    skos:prefLabel "Drop filtered features" ;
    skos:definition "Return a new featuresTable containing only feature rows not marked as filtered." ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .

