sfms:getSpectraHeaders
    a sf:Operation ;
    sf:operationId "mass_spec.get_spectra_headers" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Get spectra headers" ;
    skos:definition "Read spectrum-header rows for selected analyses, including scan number, retention time, polarity, MS level, precursor information, and point counts. Use this lightweight inspection operation before requesting large point arrays." ;
    sf:category "mass-spec-query" ;
    sf:guidance "Use analysis_names from get_analysis_names. An empty analysis_names array means all registered analyses; provide names to reduce work and response size." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:spectraHeadersTable, sfcore:operationSuccessSignal .

sfms:getChromatogramsHeaders
    a sf:Operation ;
    sf:operationId "mass_spec.get_chromatograms_headers" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Get chromatogram headers" ;
    skos:definition "Read chromatogram-header rows for selected analyses, including identifiers, retention-time ranges, polarity, and point counts." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:chromatogramsHeadersTable ;
    sf:hasOutputPort sfms:chromatogramsHeadersTable, sfcore:operationSuccessSignal .

sfms:getSpectraTic
    a sf:Operation ;
    sf:operationId "mass_spec.get_spectra_tic" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Get spectra TIC" ;
    skos:definition "Read total-ion-current values from spectrum headers using analysis, MS-level, and retention-time filters." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter,
        sfms:levelsParameter,
        sfms:rtMinParameter,
        sfms:rtMaxParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:ticTable, sfcore:operationSuccessSignal .

sfms:plotSpectraTic
    a sf:Operation ;
    sf:operationId "mass_spec.plot_spectra_tic" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Plot spectra TIC" ;
    skos:definition "Generate a bounded Plotly visualization specification for total-ion-current spectra, preserving the R plotting defaults and retention-time units." ;
    sf:category "mass-spec-visualization" ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:levelsParameter,
        sfms:rtMinParameter,
        sfms:rtMaxParameter,
        sfms:plotDownsizeParameter,
        sfms:plotGroupByParameter,
        sfms:plotTitleParameter,
        sfms:plotXLabelParameter,
        sfms:plotYLabelParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:spectraHeadersTable ;
    sf:hasOutputPort sfcore:visualizationSpecResult, sfcore:operationSuccessSignal .

sfms:getRawSpectra
    a sf:Operation ;
    sf:operationId "mass_spec.get_raw_spectra" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Get raw spectra" ;
    skos:definition "Read flattened raw spectrum points. analysis_names selects analyses first; non-empty indices selects spectra and takes priority over targets; targets are used when indices are omitted or empty." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter,
        sfms:levelsParameter,
        sfms:targetsParameter,
        sfms:polarityParameter,
        sfms:ppmParameter,
        sfms:rtToleranceParameter,
        sfms:chargeParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:spectraTable, sfcore:operationSuccessSignal .

sfms:getRawSpectraEic
    a sf:Operation ;
    sf:operationId "mass_spec.get_raw_spectra_eic" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Get extracted ion chromatograms" ;
    skos:definition "Read MS1 raw points grouped as extracted-ion chromatograms for independent target ranges. Each target must provide mass/mz bounds or a chemical structure; optional id, analysis, polarity, level, and retention-time fields narrow the result." ;
    sf:category "mass-spec-query" ;
    sf:guidance "Use mz for a measured ion such as 275.23457, mass for a neutral mass, or SMILES/InChI when the exact mass should be derived. Set polarity to 1 or -1 when known, ppm for mass tolerance, and rt_min/rt_max for an explicit seconds window. Use the operation catalogue and tools/list to discover this operation; do not use method discovery." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:targetsParameter,
        sfms:polarityParameter,
        sfms:ppmParameter,
        sfms:rtToleranceParameter,
        sfms:chargeParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:eicTable, sfcore:operationSuccessSignal .

sfms:getRawSpectraMs1
    a sf:Operation ;
    sf:operationId "mass_spec.get_raw_spectra_ms1" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Get MS1 spectra" ;
    skos:definition "Read MS1 raw spectrum points using independent target ranges and shared filters." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:targetsParameter,
        sfms:polarityParameter,
        sfms:ppmParameter,
        sfms:rtToleranceParameter,
        sfms:chargeParameter,
        sfms:mzClustParameter,
        sfms:presenceParameter,
        sfms:minIntensityMs1Parameter ;
    sf:hasInputPort sfms:analysesTable, sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:ms1Table, sfcore:operationSuccessSignal .

sfms:getRawSpectraMs2
    a sf:Operation ;
    sf:operationId "mass_spec.get_raw_spectra_ms2" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Get MS2 spectra" ;
    skos:definition "Read MS2 raw spectrum points using independent target ranges and shared filters." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:targetsParameter,
        sfms:polarityParameter,
        sfms:ppmParameter,
        sfms:rtToleranceParameter,
        sfms:chargeParameter,
        sfms:isolationWindowParameter,
        sfms:mzClustParameter,
        sfms:presenceParameter,
        sfms:minIntensityMs2Parameter ;
    sf:hasInputPort sfms:analysesTable, sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:ms2Table, sfcore:operationSuccessSignal .

sfms:getChromatograms
    a sf:Operation ;
    sf:operationId "mass_spec.get_chromatograms" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Get chromatograms" ;
    skos:definition "Read persisted chromatogram point rows for selected analyses and return the matching subset of the chromatograms table." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter ;
    sf:hasInputPort sfms:chromatogramsTable ;
    sf:hasOutputPort sfms:chromatogramsTable, sfcore:operationSuccessSignal .

sfms:getRawChromatograms
    a sf:Operation ;
    sf:operationId "mass_spec.get_raw_chromatograms" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Get raw chromatograms" ;
    skos:definition "Read chromatogram point records directly from the selected mass spectrometry files. Returns the same column structure as get_chromatograms (analysis, replicate, index, chromatogram_id, polarity, precursor_mz, activation_ce, product_mz, signal_type, chromatogram_type, detector, channel, wavelength_nm, units, rt, raw_intensity, baseline, intensity)." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:chromatogramsHeadersTable ;
    sf:hasOutputPort sfms:chromatogramsTable, sfcore:operationSuccessSignal .

sfms:getChromatogramPeaks
    a sf:Operation ;
    sf:operationId "mass_spec.get_chromatogram_peaks" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Get chromatogram peaks" ;
    skos:definition "Read persisted chromatographic peak records joined with channel metadata from MASS_SPEC_CHROMATOGRAMS_HEADERS. Filter by analysis names and chromatogram indices." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:chromatogramsHeadersTable, sfms:chromatogramPeaksTable ;
    sf:hasOutputPort sfms:chromatogramPeaksTable, sfcore:operationSuccessSignal .

sfms:getFeatures
    a sf:Operation ;
    sf:operationId "mass_spec.get_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Get NTA features" ;
    skos:definition "Return a reduced, persisted featuresTable artifact containing features that match optional target rows. Omit analysis_names to search every analysis. Each target may provide mass, mz, rt, explicit bounds, analysis, and optional polarity; omitted polarity never filters. A mass or mz target is expanded by ppm, and an exact rt target is expanded by rt_tolerance seconds. The result includes the matched target name when supplied and is available for artifact inspection and downstream connections." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:targetsParameter,
        sfms:ppmParameter,
        sfms:rtToleranceParameter,
        sfms:filteredParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .

sfms:getSuspects
    a sf:Operation ;
    sf:operationId "mass_spec.get_suspects" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Get NTA suspects" ;
    skos:definition "Read persisted non-target-analysis suspect-screening assignments matching analysis, mass or m/z, retention time, and polarity targets." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:targetsParameter,
        sfms:polarityParameter,
        sfms:ppmParameter,
        sfms:rtToleranceParameter ;
    sf:hasInputPort sfms:suspectsTable ;
    sf:hasOutputPort sfms:suspectsTable, sfcore:operationSuccessSignal .

sfms:getInternalStandards
    a sf:Operation ;
    sf:operationId "mass_spec.get_internal_standards" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Get NTA internal standards" ;
    skos:definition "Read persisted non-target-analysis internal-standard assignments matching analysis, mass or m/z, retention time, and polarity targets." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:targetsParameter,
        sfms:polarityParameter,
        sfms:ppmParameter,
        sfms:rtToleranceParameter ;
    sf:hasInputPort sfms:internalStandardsTable ;
    sf:hasOutputPort sfms:internalStandardsTable, sfcore:operationSuccessSignal .

sfms:getTransformationProducts
    a sf:Operation ;
    sf:operationId "mass_spec.get_transformation_products" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Get NTA transformation products" ;
    skos:definition "Read persisted non-target-analysis transformation-product assignments matching analysis and mass targets. Transformation-product artifacts do not contain independent m/z or retention-time columns." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:targetsParameter,
        sfms:ppmParameter ;
    sf:hasInputPort sfms:transformationProductsTable ;
    sf:hasOutputPort sfms:transformationProductsTable, sfcore:operationSuccessSignal .

sfms:loadChromatograms
    a sf:Operation ;
    sf:operationId "mass_spec.load_chromatograms" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Load chromatograms" ;
    skos:definition "Read chromatogram signal arrays and channel metadata from the native reader and persist them as immutable chromatogram-header and point artifacts. Each point stores retention time and raw intensity; intensity is initialized from raw_intensity and can be modified by subsequent baseline correction and smoothing steps. Use chromatogram_id_regex to select specific channels, such as MRM or DAD wavelengths." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:chromatogramIdRegexParameter,
        sfms:ignoreCaseParameter,
        sfms:invertParameter ;
    sf:hasInputPort sfms:analysesTable ;
    sf:hasOutputPort sfms:chromatogramsHeadersTable, sfms:chromatogramsTable, sfcore:operationSuccessSignal .


sfms:filterChromatogramsRetentionTime
    a sf:Operation ;
    sf:operationId "mass_spec.filter_chromatograms_retention_time" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Filter chromatograms by retention time" ;
    skos:definition "Remove chromatogram point rows whose retention time falls outside the inclusive [rt_min, rt_max] window. Operates on the point table only; header metadata is not affected. Use this to focus downstream processing on a specific retention-time range (e.g. to exclude solvent front or late-eluting compounds)." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:rtMinParameter,
        sfms:rtMaxParameter ;
    sf:hasInputPort sfms:chromatogramsTable ;
    sf:hasOutputPort sfms:chromatogramsTable, sfcore:operationSuccessSignal .


sfms:findChromatogramPeaks
    a sf:Operation ;
    sf:operationId "mass_spec.find_chromatogram_peaks" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Find chromatogram peaks" ;
    skos:definition "Detect and integrate chromatographic peaks from the processed chromatogram signal (intensity column). Expects intensity to reflect any prior baseline correction and smoothing. The algorithm uses Savitzky-Golay smoothing and first-derivative zero-crossing detection to locate peak apices, then integrates accepted peaks and publishes peak metrics as a new chromatogramPeaksTable artifact. Detector-independent: works for MRM, DAD, UV, EIC, and TIC chromatograms." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:indicesParameter,
        sfms:mergeParameter,
        sfms:mergeDistanceParameter,
        sfms:minPeakHeightParameter,
        sfms:minPeakDistanceParameter,
        sfms:minPeakWidthParameter,
        sfms:maxPeakWidthParameter,
        sfms:minSnrParameter ;
    sf:hasInputPort sfms:chromatogramsTable ;
    sf:hasOutputPort sfms:chromatogramPeaksTable, sfcore:operationSuccessSignal .


sfms:correctChromatogramBaseline
    a sf:Operation ;
    sf:operationId "mass_spec.correct_chromatogram_baseline" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Correct chromatogram baseline" ;
    skos:definition "Estimate the chromatographic baseline and subtract it from the signal. For each chromatogram the algorithm computes a baseline vector, stores it in the baseline column, and sets intensity = max(0, signal - baseline). The raw_intensity column is never modified, so the original data is always preserved. Rolling-minimum (rolling_min) is fast and works well for well-separated peaks; asymmetric least-squares (als) fits a smooth baseline that follows signal minima while rejecting peaks, which is better for drifting baselines or co-eluting compounds. This method reads and writes the MASS_SPEC_CHROMATOGRAMS table and can be chained with smooth_chromatograms before peak detection." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:baselineAlgorithmParameter,
        sfms:windowSizeParameter,
        sfms:lambdaParameter,
        sfms:asymmetryPenaltyParameter,
        sfms:maxIterationsParameter ;
    sf:hasInputPort sfms:chromatogramsTable ;
    sf:hasOutputPort sfms:chromatogramsTable, sfcore:operationSuccessSignal .


sfms:smoothChromatograms
    a sf:Operation ;
    sf:operationId "mass_spec.smooth_chromatograms" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Smooth chromatograms" ;
    skos:definition "Apply noise reduction to the chromatogram signal. The algorithm reads the current intensity column (which may already have baseline correction applied) and writes a smoothed version back. raw_intensity is never modified. Moving-average (moving_average) is the simplest filter but broadens peaks and reduces apparent peak height. Savitzky-Golay (savitzky_golay) fits a local polynomial and better preserves peak shape, height, and position; window_size and poly_order control the smoothing strength. This method is typically applied after baseline correction and before peak detection." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:smoothingAlgorithmParameter,
        sfms:windowSizeParameter,
        sfms:polyOrderParameter ;
    sf:hasInputPort sfms:chromatogramsTable ;
    sf:hasOutputPort sfms:chromatogramsTable, sfcore:operationSuccessSignal .


sfms:findFeatures
    a sf:Operation ;
    sf:operationId "mass_spec.find_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Find mass spectrometry features" ;
    skos:definition "Detect chromatographic MS1 features from every analysis in the analyses table. The operation reads source files through the native reader, optionally reuses persisted spectra headers, clusters centroid traces within retention-time windows, and emits the feature table." ;
    sf:category "nta-feature-detection" ;
    sf:guidance "Connect analysesTable. Connect spectraHeadersTable only when persisted headers are available; otherwise headers are read directly from the source files. The operation processes every analysis in analysesTable. rt_windows_min and rt_windows_max must be arrays of equal length." ;
    sf:hasParameter
        sfms:rtWindowsMinParameter,
        sfms:rtWindowsMaxParameter,
        sfms:ppmThresholdParameter,
        sfms:noiseThresholdParameter,
        sfms:minSnrParameter,
        sfms:minTracesParameter,
        sfms:baselineWindowParameter,
        sfms:maxFeatureWidthParameter,
        sfms:baseQuantileParameter,
        sfcore:debugAnalysisParameter,
        sfcore:debugMzParameter,
        sfcore:debugSpecIdxParameter ;
    sf:hasInputPort sfms:analysesTable ;
    sf:optionalInputPort sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:loadFeaturesMs1
    a sf:Operation ;
    sf:operationId "mass_spec.load_features_ms1" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Load MS1 spectra for features" ;
    skos:definition "Read MS1 points from the native source files for each persisted feature, cluster them into a consensus spectrum, and store the encoded MS1 spectrum on the feature table." ;
    sf:category "nta-spectrum-loading" ;
    sf:guidance "Run after find_features. The operation reads every analysis from the analyses table and the latest connected feature table; filtered controls whether already-filtered features are skipped. The output updates ms1_size, ms1_mz, and ms1_intensity." ;
    sf:hasParameter
        sfms:filteredParameter,
        sfms:rtWindowParameter,
        sfms:mzWindowParameter,
        sfms:minTracesIntensityParameter,
        sfms:mzClustParameter,
        sfms:presenceParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:loadFeaturesMs2
    a sf:Operation ;
    sf:operationId "mass_spec.load_features_ms2" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Load MS2 spectra for features" ;
    skos:definition "Read MS2 points from the native source files for each persisted feature using the precursor isolation window, cluster them into a consensus spectrum, and store the encoded MS2 spectrum on the feature table." ;
    sf:category "nta-spectrum-loading" ;
    sf:guidance "Run after load_features_ms1 when MS1 and MS2 evidence are both required. The operation reads every analysis from the analyses table and the latest connected feature table; it updates ms2_size, ms2_mz, and ms2_intensity without requiring a separate spectraHeadersTable input." ;
    sf:hasParameter
        sfms:filteredParameter,
        sfms:minTracesIntensityParameter,
        sfms:isolationWindowParameter,
        sfms:mzClustParameter,
        sfms:presenceParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:subtractBlank
    a sf:Operation ;
    sf:operationId "mass_spec.subtract_blank" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Subtract blank features" ;
    skos:definition "Flag features whose intensity is largely explained by blank analyses, using RT and m/z expansion windows." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:blankThresholdParameter,
        sfms:rtExpandParameter,
        sfms:mzExpandParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:filterFeatures
    a sf:Operation ;
    sf:operationId "mass_spec.filter_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Filter features" ;
    skos:definition "Remove or flag features failing signal, shape, and quality criteria." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:minSnParameter,
        sfms:minIntensityParameter,
        sfms:minAreaParameter,
        sfms:minWidthParameter,
        sfms:maxWidthParameter,
        sfms:maxPpmParameter,
        sfms:minFwhmRtParameter,
        sfms:maxFwhmRtParameter,
        sfms:minFwhmMzParameter,
        sfms:maxFwhmMzParameter,
        sfms:minGaussianAParameter,
        sfms:minGaussianMuParameter,
        sfms:maxGaussianMuParameter,
        sfms:minGaussianSigmaParameter,
        sfms:maxGaussianSigmaParameter,
        sfms:minGaussianR2Parameter,
        sfms:maxJaggednessParameter,
        sfms:minSharpnessParameter,
        sfms:minAsymmetryParameter,
        sfms:maxAsymmetryParameter,
        sfms:maxModalityParameter,
        sfms:minPlatesParameter,
        sfms:onlyFilledParameter,
        sfms:removeFilledParameter,
        sfms:minSizeEicParameter,
        sfms:minSizeMs1Parameter,
        sfms:minSizeMs2Parameter,
        sfms:minRelPresenceReplicateParameter,
        sfms:removeIsotopesParameter,
        sfms:removeAdductsParameter,
        sfms:removeLossesParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:filterFeaturesMs2
    a sf:Operation ;
    sf:operationId "mass_spec.filter_features_ms2" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Filter feature MS2 spectra" ;
    skos:definition "Clean feature MS2 spectra: remove blank contaminants, apply relative intensity and top-N limits." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:topParameter,
        sfms:minIntensityMs2Parameter,
        sfms:relMinIntensityParameter,
        sfms:blankCleanParameter,
        sfms:mzClustParameter,
        sfms:blankPresenceThresholdParameter,
        sfms:globalPresenceThresholdParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:groupFeatures
    a sf:Operation ;
    sf:operationId "mass_spec.group_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Group features" ;
    skos:definition "Group features across analyses into shared feature groups using RT/mass tolerance and an alignment method." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:methodParameter,
        sfms:rtDeviationParameter,
        sfms:ppmParameter,
        sfms:minSamplesParameter,
        sfms:binSizeParameter ;
    sf:hasInputPort sfms:featuresTable, sfms:internalStandardsTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:fillFeatures
    a sf:Operation ;
    sf:operationId "mass_spec.fill_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Fill feature gaps" ;
    skos:definition "Fill missing feature values across analyses by extracting and integrating EIC peaks in the expected windows." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:withinReplicateParameter,
        sfms:filteredParameter,
        sfms:rtExpandParameter,
        sfms:mzExpandParameter,
        sfms:maxPeakWidthParameter,
        sfms:minTracesIntensityParameter,
        sfms:minNumberTracesParameter,
        sfms:minIntensityMs1Parameter,
        sfms:rtApexDeviationParameter,
        sfms:minSignalToNoiseRatioParameter,
        sfms:minGaussianFitParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:createComponents
    a sf:Operation ;
    sf:operationId "mass_spec.create_components" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Create components" ;
    skos:definition "Join correlated features from every analysis into components based on EIC correlation within a retention-time window." ;
    sf:guidance "The operation processes every analysis in the connected featuresTable, matching find_features. It does not accept an analysis_names parameter." ;
    sf:hasParameter
        sfms:rtWindowParameter,
        sfms:minCorrelationParameter,
        sfms:debugRtParameter,
        sfcore:debugAnalysisParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:annotateComponents
    a sf:Operation ;
    sf:operationId "mass_spec.annotate_components" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Annotate components" ;
    skos:definition "Annotate feature components from every analysis with isotopic, adduct, and fragment relationships." ;
    sf:guidance "The operation processes every analysis in the connected featuresTable, matching find_features. It does not accept an analysis_names parameter. isotope_elements uses entries in the form Element:min-max, for example C:1-80." ;
    sf:hasParameter
        sfms:maxIsotopesParameter,
        sfms:maxChargeParameter,
        sfms:maxGapsParameter,
        sfms:ppmParameter,
        sfms:isotopeElementsParameter,
        sfms:debugComponentParameter,
        sfcore:debugAnalysisParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:suspectScreening
    a sf:Operation ;
    sf:operationId "mass_spec.suspect_screening" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Screen suspect features" ;
    skos:definition "Match detected features against suspect targets by accurate mass, retention time, and optional MS2 similarity, persist candidate assignments, and attach the best assignments to the feature records." ;
    sf:category "nta-identification" ;
    sf:guidance "Run after load_features_ms2 when MS2 assignment is required. Each target should provide a name, mass or formula, optional retention time, and optional MS2 reference peaks. Set min_shared_fragments and min_cosine_similarity to require MS2 evidence; an empty analysis_names array processes every analysis." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:suspectTargetsParameter,
        sfms:ppmParameter,
        sfms:secParameter,
        sfms:ppmMs2Parameter,
        sfms:mzrMs2Parameter,
        sfms:minCosineSimilarityParameter,
        sfms:minSharedFragmentsParameter,
        sfms:filteredParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfms:suspectsTable, sfcore:operationSuccessSignal .


sfms:findInternalStandards
    a sf:Operation ;
    sf:operationId "mass_spec.find_internal_standards" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Find internal standards" ;
    skos:definition "Match detected features against internal-standard targets by mass, RT, and MS2 similarity." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:suspectTargetsParameter,
        sfms:ppmParameter,
        sfms:secParameter,
        sfms:ppmMs2Parameter,
        sfms:mzrMs2Parameter,
        sfms:minCosineSimilarityParameter,
        sfms:minSharedFragmentsParameter,
        sfms:filteredParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfms:internalStandardsTable, sfcore:operationSuccessSignal .


sfms:correctMatrixSuppression
    a sf:Operation ;
    sf:operationId "mass_spec.correct_matrix_suppression" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Correct matrix suppression" ;
    skos:definition "Apply matrix/suppression correction factors derived from analysis intensity profiles." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:mpRtWindowParameter,
        sfms:refBlankReplicateParameter ;
    sf:hasInputPort sfms:featuresTable, sfms:internalStandardsTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:filterSuspects
    a sf:Operation ;
    sf:operationId "mass_spec.filter_suspects" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Filter suspects" ;
    skos:definition "Refine suspect-screening results by applying name, score, RT/mass error, identification-level, fragment, and cosine-similarity thresholds." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:namesParameter,
        sfms:minScoreParameter,
        sfms:maxErrorRtParameter,
        sfms:maxErrorMassParameter,
        sfms:idLevelsParameter,
        sfms:minSharedFragmentsParameter,
        sfms:minCosineSimilarityParameter ;
    sf:hasInputPort sfms:featuresTable, sfms:suspectsTable ;
    sf:hasOutputPort sfms:suspectsTable, sfcore:operationSuccessSignal .


sfms:filterInternalStandards
    a sf:Operation ;
    sf:operationId "mass_spec.filter_internal_standards" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Filter internal standards" ;
    skos:definition "Refine internal-standard matches by applying name, score, RT/mass error, identification-level, fragment, and cosine-similarity thresholds." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:namesParameter,
        sfms:minScoreParameter,
        sfms:maxErrorRtParameter,
        sfms:maxErrorMassParameter,
        sfms:idLevelsParameter,
        sfms:minSharedFragmentsParameter,
        sfms:minCosineSimilarityParameter ;
    sf:hasInputPort sfms:featuresTable, sfms:internalStandardsTable ;
    sf:hasOutputPort sfms:internalStandardsTable, sfcore:operationSuccessSignal .


sfms:assignTransformationProducts
    a sf:Operation ;
    sf:operationId "mass_spec.assign_transformation_products" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Assign transformation products" ;
    skos:definition "Assign plausible biotransformation products to suspected features using transformation-product candidates, scoring combinations by mass/MS2 cosine similarity and logP-based retention-time plausibility, and append the assignments to the suspect results." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:transformationProductsParameter,
        sfms:chromatographicPhaseParameter,
        sfms:mzrMs2Parameter ;
    sf:hasInputPort sfms:featuresTable, sfms:suspectsTable ;
    sf:hasOutputPort sfms:suspectsTable, sfms:transformationProductsTable, sfcore:operationSuccessSignal .


sfms:metfragScreening
    a sf:Operation ;
    sf:operationId "mass_spec.metfrag_screening" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Screen features with MetFrag" ;
    skos:definition "Run in-silico MetFrag fragmenter screening for detected features: write per-feature MetFrag input, invoke the MetFrag command line (Java) from the ~/.streamfind tool layout, and rank resulting candidate fragments into the suspect results." ;
    sf:guidance "Requires Java 21 and MetFragCL. Installation is explicit and never automatic: run 'streamfind-cli tools install java' and 'streamfind-cli tools install metfrag', then retry this method." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:databaseTypeParameter,
        sfms:databaseParameter,
        sfms:ppmParameter,
        sfms:secParameter,
        sfms:ppmMs2Parameter,
        sfms:mzrMs2Parameter,
        sfms:topNParameter,
        sfms:scoreTypesParameter,
        sfms:scoreWeightsParameter,
        sfms:preProcessingCandidateFilterParameter,
        sfms:postProcessingCandidateFilterParameter,
        sfms:maximumTreeDepthParameter,
        sfms:numberThreadsParameter,
        sfms:useSmilesParameter,
        sfms:filteredParameter,
        sfms:debugParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfms:suspectsTable, sfcore:operationSuccessSignal .
