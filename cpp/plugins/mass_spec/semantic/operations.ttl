    skos:prefLabel "Get chromatogram peaks" ;
    skos:definition "Read persisted chromatographic peak records joined with channel metadata from MASS_SPEC_CHROMATOGRAMS_HEADERS. Filter by analysis names and chromatogram indices." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:indicesParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:chromatogramsHeadersTable, sfms:chromatogramPeaksTable ;
    sf:hasOutputPort sfms:chromatogramPeaksTable, sfcore:operationSuccessSignal .

sfms:getFeatures
    a sf:Operation ;
    sf:operationId "mass_spec.get_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Get features" ;
    skos:definition "Return a reduced, persisted featuresTable artifact containing features that match optional target rows. Omit analysis_names to search every analysis. Each target may provide mass, mz, rt, explicit bounds, analysis, and optional polarity; omitted polarity never filters. A mass or mz target is expanded by ppm, and an exact rt target is expanded by rt_tolerance seconds. The result includes the matched target name when supplied and is available for artifact inspection and downstream connections." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:targetsParameter,
        sfms:ppmParameter,
        sfms:rtToleranceParameter,
        sfms:filteredParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .

