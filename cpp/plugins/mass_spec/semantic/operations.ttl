@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfms: <https://streamfind.dev/catalogue/domains/mass_spec#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfms:readMassSpecFiles
    a sf:Operation ;
    sf:operationId "mass_spec.read_mass_spec_files" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Read mass spectrometry files" ;
    skos:definition "Read one or more mass-spectrometry files or vendor directories, discover their logical analyses, and persist analysis, spectra-header, and chromatogram-header metadata." ;
    sf:category "mass-spec-ingestion" ;
    sf:projectEntry true ;
    sf:guidance "Provide an array of supported mass-spectrometry file or vendor-directory paths. Replicate and blank labels are initially empty and can be assigned by subsequent operations." ;
    sf:hasParameter sfms:sourcePathsParameter ;
    sf:hasOutputPort sfms:analysesTable, sfms:spectraHeadersTable, sfms:chromatogramsHeadersTable, sfcore:operationSuccessSignal .

sfms:readCsvTargets
    a sf:Operation ;
    sf:operationId "mass_spec.read_csv_targets" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Read CSV with targets" ;
    skos:definition "Read a mass/mz target CSV, validate numeric matching fields, ignore any chemical-identity columns, and publish a reusable targetsTable artifact." ;
    sf:category "mass-spec-ingestion" ;
    sf:hasParameter sfms:targetsCsvPathParameter ;
    sf:hasOutputPort sfms:targetsTable, sfcore:operationSuccessSignal .

sfms:readCsvSuspectTargets
    a sf:Operation ;
    sf:operationId "mass_spec.read_csv_suspect_targets" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Read CSV with suspect targets" ;
    skos:definition "Read a suspect-target CSV with mass/mz-driven matching fields, normalize optional chemical structures with Open Babel, validate optional MS2 reference peaks, and publish a reusable suspectTargetsTable artifact." ;
    sf:category "nta-identification" ;
    sf:hasParameter sfms:suspectTargetsCsvPathParameter ;
    sf:hasOutputPort sfms:suspectTargetsTable, sfcore:operationSuccessSignal .

sfms:internalStandardsToSuspects
    a sf:Operation ;
    sf:operationId "mass_spec.internal_standards_to_suspects" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Convert internal standards to suspects" ;
    skos:definition "Project an internalStandardsTable onto the shared suspectsTable contract without changing its physical rows or identification values." ;
    sf:category "nta-identification" ;
    skos:guidance "Connect an internalStandardsTable created by Find internal standards or Find internal standards with MetFrag. The operation is a semantic projection only: it preserves the shared suspect columns, including validated database MS2 and experimental MS2 fields, and emits them under the suspectsTable contract for downstream suspect-target aggregation." ;
    sf:hasInputPort sfms:internalStandardsTable ;
    sf:hasOutputPort sfms:suspectsTable, sfcore:operationSuccessSignal .

sfms:suspectsToSuspectTargets
    a sf:Operation ;
    sf:operationId "mass_spec.suspects_to_suspect_targets" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Convert suspects to suspect targets" ;
    skos:definition "Aggregate validated suspect assignments into one suspect-target row per chemical identity and polarity, including averaged database mass, chemical descriptors, experimental retention time, and harmonized in-silico MS2 reference fragments." ;
    sf:category "nta-identification" ;
    skos:guidance "Connect a suspectsTable. An internalStandardsTable is accepted because it is a specialized suspectsTable contract with the same identification columns. Only rows meeting min_shared_fragments and min_cosine_similarity and containing validated db_ms2_mz, db_ms2_intensity, db_ms2_formula, and db_ms2_size are used for the reference spectrum. Before aggregation, duplicate identities within the same analysis and polarity are reduced to one representative: more shared fragments, lower absolute mass error, higher intensity and area, higher cosine similarity, then higher identification level and lower candidate rank. Only database MS2 fragments with a non-empty matching db_ms2_formula are written; experimental ms2_mz and ms2_intensity are not used. Rows are grouped by InChIKey, then SMILES, then formula/mass/name, with polarity kept separate. Fragment m/z values are clustered using mz_clust, cluster m/z values are rounded to four decimal places, and cluster intensities are averaged across contributing rows and normalized so the maximum is 100. The resulting positive- or negative-mode JSON arrays conform directly to suspectTargetsTable and can be connected to later suspect screening or MetFrag operations." ;
    sf:hasParameter
        sfms:mzClustParameter,
        sfms:minCosineSimilarityParameter,
        sfms:minSharedFragmentsParameter ;
    sf:hasInputPort sfms:suspectsTable ;
    sf:hasOutputPort sfms:suspectTargetsTable, sfcore:operationSuccessSignal .

sfms:updateSuspectTargets
    a sf:Operation ;
    sf:operationId "mass_spec.update_suspect_targets" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Update suspect targets" ;
    skos:definition "Update an existing suspectTargetsTable with retention-time and polarity-specific MS2 evidence from a connected suspectsTable, preserving unmatched target rows and appending new chemically described suspects." ;
    sf:category "nta-identification" ;
    skos:guidance "Connect a suspectTargetsTable, typically produced by Read CSV with suspect targets, and a suspectsTable, typically produced by suspect screening or by converting internal standards. Only suspect rows meeting min_shared_fragments, min_cosine_similarity, and db_ms2_size criteria are used. Duplicate identities within the same analysis and polarity are reduced to one representative. When an existing target has an RT, the representative with the smallest absolute RT difference is selected first; ties use more shared fragments, lower absolute mass error, higher intensity and area, higher cosine similarity, then higher identification level and lower candidate rank. Only database MS2 fragments with a non-empty matching db_ms2_formula are copied into the updated target spectra; experimental ms2_mz and ms2_intensity are not copied. Matching uses InChIKey, InChI, SMILES, or formula plus mass, independently of polarity, so positive and negative MS2 arrays can coexist in one target row. Existing target rows without matching suspect evidence are preserved; valid unmatched suspects are appended. m/z values are clustered using mz_clust and normalized into the target spectrum arrays." ;
    sf:hasParameter
        sfms:mzClustParameter,
        sfms:minCosineSimilarityParameter,
        sfms:minSharedFragmentsParameter ;
    sf:hasInputPort sfms:suspectsTable, sfms:suspectTargetsTable ;
    sf:hasOutputPort sfms:suspectTargetsTable, sfcore:operationSuccessSignal .

sfms:readMolSuspectTarget
    a sf:Operation ;
    sf:operationId "mass_spec.read_mol_suspect_target" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Read MOL suspect target" ;
    skos:definition "Read one MDL MOL file, normalize its chemical structure with Open Babel, and publish all derived chemical descriptors as a reusable suspectTargetsTable artifact." ;
    sf:category "mass-spec-ingestion" ;
    sf:guidance "The optional compound_name overrides the MOL title; when omitted or empty, the MOL title is used and then Compound is used as a fallback. The operation does not invent MS2 reference peaks, retention time, polarity, or database identifiers." ;
    sf:hasParameter
        sfms:molFilePathParameter,
        sfms:compoundNameParameter ;
    sf:hasOutputPort sfms:suspectTargetsTable, sfcore:operationSuccessSignal .

sfms:removeAnalyses
    a sf:Operation ;
    sf:operationId "mass_spec.remove_analyses" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Remove mass spectrometry analyses" ;
    skos:definition "Read the analyses table and remove every analysis whose name matches at least one ECMAScript regular-expression pattern." ;
    sf:guidance "Provide analysis_names as exact names or regex patterns. Plain strings match one exact analysis name. Use ^prefix for a prefix batch, suffix$ for a suffix batch, or .*middle.* for text occurring anywhere in the name. Regex matching uses ECMAScript syntax, is case-sensitive, and uses regex search.\n\nExamples:\n[\"sample_exact\"]\nRemoves one exact analysis.\n\n[\"^QC_\"]\nRemoves all analyses beginning with QC_.\n\n[\"_blank$\"]\nRemoves all analyses ending with _blank.\n\n[\".*blank.*\"]\nRemoves all analyses containing blank anywhere in the name; because matching uses regex search, [\"blank\"] is equivalent." ;
    sf:hasParameter sfcore:analysisNamesParameter ;
    sf:hasInputPort sfms:analysesTable ;
    sf:hasOutputPort sfms:analysesTable, sfcore:operationSuccessSignal .

