sfms:getTransformationProducts
    a sf:Operation ;
    sf:operationId "mass_spec.get_transformation_products" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Get transformation products" ;
    skos:definition "Read persisted non-target-analysis transformation-product assignments matching analysis and mass targets. Transformation-product artifacts do not contain independent m/z or retention-time columns." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:targetsParameter,
        sfms:ppmParameter ;
    sf:hasInputPort sfms:transformationProductsTable ;
    sf:hasOutputPort sfms:transformationProductsTable, sfcore:operationSuccessSignal .

sfms:loadChromatograms
    a sf:Operation ;
    sf:operationId "mass_spec.load_chromatograms" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Load chromatograms" ;
    skos:definition "Read chromatogram signal arrays and channel metadata from the native reader and persist them as immutable chromatogram-header and point artifacts. Each point stores retention time and raw intensity; intensity is initialized from raw_intensity and can be modified by subsequent baseline correction and smoothing steps. Use chromatogram_id_regex to select specific channels, such as MRM or DAD wavelengths." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:chromatogramIdRegexParameter,
        sfms:ignoreCaseParameter,
        sfms:invertParameter ;
    sf:hasInputPort sfms:analysesTable ;
    sf:hasOutputPort sfms:chromatogramsHeadersTable, sfms:chromatogramsTable, sfcore:operationSuccessSignal .


sfms:filterChromatogramsRetentionTime
    a sf:Operation ;
    sf:operationId "mass_spec.filter_chromatograms_retention_time" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Filter chromatograms by retention time" ;
    skos:definition "Remove chromatogram point rows whose retention time falls outside the inclusive [rt_min, rt_max] window. Operates on the point table only; header metadata is not affected. Use this to focus downstream processing on a specific retention-time range (e.g. to exclude solvent front or late-eluting compounds)." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:rtMinParameter,
        sfms:rtMaxParameter ;
    sf:hasInputPort sfms:chromatogramsTable ;
    sf:hasOutputPort sfms:chromatogramsTable, sfcore:operationSuccessSignal .


sfms:findChromatogramPeaks
    a sf:Operation ;
    sf:operationId "mass_spec.find_chromatogram_peaks" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Find chromatogram peaks" ;
    skos:definition "Detect and integrate chromatographic peaks from the processed chromatogram signal (intensity column). Expects intensity to reflect any prior baseline correction and smoothing. The algorithm uses Savitzky-Golay smoothing and first-derivative zero-crossing detection to locate peak apices, then integrates accepted peaks and publishes peak metrics as a new chromatogramPeaksTable artifact. Detector-independent: works for MRM, DAD, UV, EIC, and TIC chromatograms." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:indicesParameter,
        sfms:mergeParameter,
        sfms:mergeDistanceParameter,
        sfms:minPeakHeightParameter,
        sfms:minPeakDistanceParameter,
        sfms:minPeakWidthParameter,
        sfms:maxPeakWidthParameter,
        sfms:minSnrParameter ;
    sf:hasInputPort sfms:chromatogramsTable ;
    sf:hasOutputPort sfms:chromatogramPeaksTable, sfcore:operationSuccessSignal .


sfms:correctChromatogramBaseline
    a sf:Operation ;
    sf:operationId "mass_spec.correct_chromatogram_baseline" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Correct chromatogram baseline" ;
    skos:definition "Estimate the chromatographic baseline and subtract it from the signal. For each chromatogram the algorithm computes a baseline vector, stores it in the baseline column, and sets intensity = max(0, signal - baseline). The raw_intensity column is never modified, so the original data is always preserved. Rolling-minimum (rolling_min) is fast and works well for well-separated peaks; asymmetric least-squares (als) fits a smooth baseline that follows signal minima while rejecting peaks, which is better for drifting baselines or co-eluting compounds. This method reads and writes the MASS_SPEC_CHROMATOGRAMS table and can be chained with smooth_chromatograms before peak detection." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:baselineAlgorithmParameter,
        sfms:windowSizeParameter,
        sfms:lambdaParameter,
        sfms:asymmetryPenaltyParameter,
        sfms:maxIterationsParameter ;
    sf:hasInputPort sfms:chromatogramsTable ;
    sf:hasOutputPort sfms:chromatogramsTable, sfcore:operationSuccessSignal .


sfms:smoothChromatograms
    a sf:Operation ;
    sf:operationId "mass_spec.smooth_chromatograms" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:chromatogramsModule ;
    skos:prefLabel "Smooth chromatograms" ;
    skos:definition "Apply noise reduction to the chromatogram signal. The algorithm reads the current intensity column (which may already have baseline correction applied) and writes a smoothed version back. raw_intensity is never modified. Moving-average (moving_average) is the simplest filter but broadens peaks and reduces apparent peak height. Savitzky-Golay (savitzky_golay) fits a local polynomial and better preserves peak shape, height, and position; window_size and poly_order control the smoothing strength. This method is typically applied after baseline correction and before peak detection." ;
    sf:hasParameter
        sfms:analysisNamesParameter,
        sfms:smoothingAlgorithmParameter,
        sfms:windowSizeParameter,
        sfms:polyOrderParameter ;
    sf:hasInputPort sfms:chromatogramsTable ;
    sf:hasOutputPort sfms:chromatogramsTable, sfcore:operationSuccessSignal .


sfms:findFeatures
    a sf:Operation ;
    sf:operationId "mass_spec.find_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Find features" ;
    skos:definition "Detect chromatographic MS1 features from every analysis in the analyses table. The operation reads source files through the native reader, optionally reuses persisted spectra headers, clusters centroid traces within retention-time windows, and emits the feature table." ;
    sf:category "nta-feature-detection" ;
    sf:guidance "Connect analysesTable. Optionally connect spectraHeadersTable to reuse persisted spectra headers; use it only when its rows match the same analysis names and indices. If it is omitted or stale, headers are read directly from the source files. The operation processes every analysis in analysesTable. Optionally add rows to rtWindows with columns rtmin and rtmax to restrict detection to multiple retention-time windows; omit it or leave it empty to use the full retention-time range." ;
    sf:hasParameter
        sfms:rtWindowsParameter,
        sfms:ppmThresholdParameter,
        sfms:noiseThresholdParameter,
        sfms:minSnrParameter,
        sfms:minTracesParameter,
        sfms:baselineWindowParameter,
        sfms:maxFeatureWidthParameter,
        sfms:baseQuantileParameter,
        sfcore:debugAnalysisParameter,
        sfcore:debugMzParameter,
        sfcore:debugSpecIdxParameter ;
    sf:hasInputPort sfms:analysesTable ;
    sf:optionalInputPort sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal ;
    sf:optionalOutputPort sfms:findFeaturesDebugResult .


sfms:loadFeaturesMs1
    a sf:Operation ;
    sf:operationId "mass_spec.load_features_ms1" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Load features MS1 spectra" ;
    skos:definition "Read MS1 points from the native source files for each persisted feature, cluster them into a consensus spectrum, and store the encoded MS1 spectrum on the feature table." ;
    sf:category "nta-spectrum-loading" ;
    sf:guidance "Run after find_features. The operation reads every analysis from the analyses table and the latest connected feature table; filtered controls whether already-filtered features are skipped. Optionally connect spectraHeadersTable from read_mass_spec_files to reuse persisted scan headers and avoid reparsing native headers. The output updates ms1_size, ms1_mz, and ms1_intensity." ;
    sf:hasParameter
        sfms:filteredParameter,
        sfms:rtWindowParameter,
        sfms:mzWindowParameter,
        sfms:minTracesIntensityParameter,
        sfms:mzClustParameter,
        sfms:presenceParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:featuresTable ;
    sf:optionalInputPort sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:loadFeaturesMs2
    a sf:Operation ;
    sf:operationId "mass_spec.load_features_ms2" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Load features MS2 spectra" ;
    skos:definition "Read MS2 points from the native source files for each persisted feature using the precursor isolation window, cluster them into a consensus spectrum, and store the encoded MS2 spectrum on the feature table." ;
    sf:category "nta-spectrum-loading" ;
    sf:guidance "Run after load_features_ms1 when MS1 and MS2 evidence are both required. The operation reads every analysis from the analyses table and the latest connected feature table. Optionally connect spectraHeadersTable from read_mass_spec_files to reuse persisted scan headers and avoid reparsing native headers. It updates ms2_size, ms2_mz, and ms2_intensity." ;
    sf:hasParameter
        sfms:filteredParameter,
        sfms:minTracesIntensityParameter,
        sfms:isolationWindowParameter,
        sfms:mzClustParameter,
        sfms:presenceParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:featuresTable ;
    sf:optionalInputPort sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:subtractBlank
    a sf:Operation ;
    sf:operationId "mass_spec.subtract_blank" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Subtract blank background" ;
    skos:definition "Flag features whose intensity is largely explained by blank analyses, using RT and m/z expansion windows. The operation processes every analysis and resolves its associated blank replicate from analysesTable." ;
    sf:guidance "Connect analysesTable and featuresTable. The replicate and blank columns in featuresTable describe feature rows but do not replace analysesTable: analysesTable remains required because it supplies authoritative native source paths and analysis indices needed to load each associated blank spectrum. Every analysis is processed using its blank assignment. Optionally connect spectraHeadersTable to reuse persisted spectra headers for RT/m/z targeting. Matching persisted headers avoid reparsing source headers; missing or stale rows fall back to native header loading." ;
    sf:hasParameter
        sfms:blankThresholdParameter,
        sfms:rtExpandParameter,
        sfms:mzExpandParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:featuresTable ;
    sf:optionalInputPort sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:filterFeatures
    a sf:Operation ;
    sf:operationId "mass_spec.filter_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Filter features" ;
    skos:definition "Remove or flag features failing signal, shape, and quality criteria." ;
    sf:hasParameter
        sfms:minSnParameter,
        sfms:minIntensityParameter,
        sfms:minAreaParameter,
        sfms:minWidthParameter,
        sfms:maxWidthParameter,
        sfms:maxPpmParameter,
        sfms:minFwhmRtParameter,
        sfms:maxFwhmRtParameter,
        sfms:minFwhmMzParameter,
        sfms:maxFwhmMzParameter,
        sfms:minGaussianAParameter,
        sfms:minGaussianMuParameter,
        sfms:maxGaussianMuParameter,
        sfms:minGaussianSigmaParameter,
        sfms:maxGaussianSigmaParameter,
        sfms:minGaussianR2Parameter,
        sfms:maxJaggednessParameter,
        sfms:minSharpnessParameter,
        sfms:minAsymmetryParameter,
        sfms:maxAsymmetryParameter,
        sfms:maxModalityParameter,
        sfms:minPlatesParameter,
        sfms:removeFilledParameter,
        sfms:minSizeEicParameter,
        sfms:minSizeMs1Parameter,
        sfms:minSizeMs2Parameter,
        sfms:minRelPresenceReplicateParameter,
        sfms:removeIsotopesParameter,
        sfms:removeAdductsParameter,
        sfms:removeLossesParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:filterFeaturesMs2
    a sf:Operation ;
    sf:operationId "mass_spec.filter_features_ms2" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Filter feature MS2 spectra" ;
    skos:definition "Clean feature MS2 spectra: remove blank contaminants, apply relative intensity and top-N limits." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:topParameter,
        sfms:minIntensityMs2Parameter,
        sfms:relMinIntensityParameter,
        sfms:blankCleanParameter,
        sfms:mzClustParameter,
        sfms:blankPresenceThresholdParameter,
        sfms:globalPresenceThresholdParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:groupFeatures
    a sf:Operation ;
    sf:operationId "mass_spec.group_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Group features" ;
    skos:definition "Group features across analyses into shared feature groups using RT/mass tolerance and the selected alignment method. The internal_standards method consumes the optional internalStandardsTable through the internal_standards table parameter; obi_warp does not require that table." ;
    sf:guidance "Connect featuresTable. The operation processes all analyses present in the connected table. Select grouping_method from the constrained internal_standards or obi_warp options. When grouping_method is internal_standards, connect an internalStandardsTable result to the internal_standards table parameter; the operation rejects an empty or missing table in that mode." ;
    sf:hasParameter
        sfms:groupingMethodParameter,
        sfms:internalStandardsParameter,
        sfms:rtDeviationParameter,
        sfms:ppmParameter,
        sfms:minSamplesParameter,
        sfms:binSizeParameter,
        sfms:debugRtParameter,
        sfcore:debugAnalysisParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal ;
    sf:optionalOutputPort sfms:groupFeaturesDebugResult .


sfms:fillFeatures
    a sf:Operation ;
    sf:operationId "mass_spec.fill_features" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Fill feature gaps" ;
    skos:definition "Fill missing feature values across analyses by extracting and integrating EIC peaks in the expected windows." ;
    sf:guidance "Connect featuresTable and use min_traces_intensity as the single MS1 intensity threshold. It is applied when extracting trace points and again when accepting the resulting filled feature; an analysis selector is not required and all analyses in the featuresTable are processed." ;
    sf:hasParameter
        sfms:withinReplicateParameter,
        sfms:filteredParameter,
        sfms:rtExpandParameter,
        sfms:mzExpandParameter,
        sfms:maxPeakWidthParameter,
        sfms:minTracesIntensityParameter,
        sfms:minNumberTracesParameter,
        sfms:rtApexDeviationParameter,
        sfms:minSignalToNoiseRatioParameter,
        sfms:minGaussianFitParameter,
        sfms:debugFeatureGroupParameter ;
    sf:hasInputPort sfms:analysesTable, sfms:featuresTable ;
    sf:optionalInputPort sfms:spectraHeadersTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal ;
    sf:optionalOutputPort sfms:fillFeaturesDebugResult .


sfms:createComponents
    a sf:Operation ;
    sf:operationId "mass_spec.create_components" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Create components" ;
    skos:definition "Join correlated features from every analysis into components based on EIC correlation within a retention-time window." ;
    sf:guidance "The operation processes every analysis in the connected featuresTable, matching find_features. It does not accept an analysis_names parameter." ;
    sf:hasParameter
        sfms:rtWindowParameter,
        sfms:minCorrelationParameter,
        sfms:debugRtParameter,
        sfcore:debugAnalysisParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal ;
    sf:optionalOutputPort sfms:createComponentsDebugResult .


sfms:annotateComponents
    a sf:Operation ;
    sf:operationId "mass_spec.annotate_components" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Annotate components" ;
    skos:definition "Annotate feature components from every analysis with isotope, adduct, and neutral-loss relationships, and calculate isotope-derived carbon plus formula-derived fluorination and halogenation descriptors." ;
    sf:guidance "The operation processes every analysis in the connected featuresTable. isotope_elements controls isotope-envelope annotation only; D is an opt-in stable-label transition and can be enabled with an entry such as D:1-22. D-containing envelopes are evaluated by their exact mass spacing and coherent RT-contiguous chain rather than natural-abundance intensity ratios, so an observed pattern may grow and then decrease and a detector-saturated plateau may be retained. When D is detected in a validated isotope envelope, the highest-intensity member is used as the unfiltered polarity-specific base ion ([M+H]+ or [M-H]-); lower- and higher-mass members are annotated relative to that base as [M-1], [M-2], [M+1], and so on. A near-equal intensity plateau is centered when selecting the base. formula_elements independently controls the formula allow-list and defaults to C,H,N,O,P,S,F,Cl,Br,I; C and H are required, while B, Si, Se, As, and D are opt-in. formula_constraints accepts elemental counts such as D:22 or ranges such as D:0-22 and automatically enables constrained elements for formula generation. Deuterium uses the exact D-H mass shift and unit stable-label abundance rather than natural-isotope abundance statistics. When no 13C-derived carbon count is available, formulas can still be estimated for features with isotope evidence or explicit formula constraints using a bounded mass-only carbon range. Observed isotope elements are enabled and prioritized in formula ranking. Candidate formulas are filtered for valid composition and plausible DBE, then ranked using mass error, agreement with the isotope-derived carbon estimate when available, penalties for uncommon optional elements, and diagnostic isotope support when observed. From a valid estimated formula it records X/C and H/X ratios and formula-mass percentages for F, Cl, Br, and I, plus fluorination and halogenation scores. These are prioritisation descriptors, not confirmed identities." ;
    sf:hasParameter
        sfms:maxIsotopesParameter,
        sfms:maxChargeParameter,
        sfms:maxGapsParameter,
        sfms:ppmParameter,
        sfms:isotopeElementsParameter,
        sfms:formulaElementsParameter,
        sfms:formulaConstraintsParameter,
        sfms:annotationModificationsParameter,
        sfms:debugComponentParameter,
        sfcore:debugAnalysisParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal ;
    sf:optionalOutputPort sfms:annotateComponentsDebugResult .


sfms:suspectScreening
    a sf:Operation ;
    sf:operationId "mass_spec.suspect_screening" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Suspect screening" ;
    skos:definition "Match detected features against suspect targets by structure-derived or supplied accurate mass, with optional retention-time, isotope, and MS2 evidence, and persist candidate assignments in a suspectsTable." ;
    sf:category "nta-identification" ;
    sf:guidance "Provide suspect targets through the suspect_targets parameter; do not connect suspectTargetsTable. Each target may provide a name and chemical identity such as SMILES, InChI, formula, mass, or m/z. Retention time and reference MS2 peaks are optional. Cat. 1 requires accurate mass, matching reference MS2 from suspectTargetsTable, and matching RT; Cat. 2 requires accurate mass and matching reference MS2 without matching RT; Cat. 3 requires accurate mass with matching RT when reference MS2 is unavailable or does not match; Cat. 4 is an accurate-mass-only assignment. Isotope matching is informational only and does not control candidate retention or identification level. For formulas containing D or [2H], MS1 matching includes bounded partial D-to-H isotopologues below the dominant labelled ion, consistent with annotate_components selecting the most intense member as [M+H]+ or [M-H]-. Run after load_features_ms2 only when MS2 evidence is desired. Set min_shared_fragments and min_cosine_similarity to require MS2 evidence; isotope_ppm controls MS1 isotope-pattern matching. An empty analysis_names array processes every analysis." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:suspectTargetsParameter,
        sfms:ppmParameter,
        sfms:secParameter,
        sfms:ppmMs2Parameter,
        sfms:mzrMs2Parameter,
        sfms:minCosineSimilarityParameter,
        sfms:minSharedFragmentsParameter,
        sfms:isotopePpmParameter,
        sfms:filteredParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:suspectsTable, sfcore:operationSuccessSignal .


sfms:findInternalStandards
    a sf:Operation ;
    sf:operationId "mass_spec.find_internal_standards" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Find internal standards" ;
    skos:definition "Match detected features against internal-standard targets by mass, RT, isotope, and MS2 evidence, and publish the matches in the independent internalStandardsTable contract used by alignment, correction, and QC operations." ;
    sf:guidance "Provide internal-standard targets through suspect_targets. The operation processes every analysis in the connected featuresTable; analysis_names is not required. It emits only internalStandardsTable and an operation-success signal. Feature groups and components may be empty when the operation runs directly after feature detection; use enrichInternalStandards after grouping or component creation to update that context." ;
    sf:hasParameter
        sfms:suspectTargetsParameter,
        sfms:ppmParameter,
        sfms:secParameter,
        sfms:ppmMs2Parameter,
        sfms:mzrMs2Parameter,
        sfms:minCosineSimilarityParameter,
        sfms:minSharedFragmentsParameter,
        sfms:isotopePpmParameter,
        sfms:filteredParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:internalStandardsTable, sfcore:operationSuccessSignal .


sfms:enrichInternalStandards
    a sf:Operation ;
    sf:operationId "mass_spec.enrich_internal_standards" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Enrich internal standards" ;
    skos:definition "Update internal-standard rows with feature group, component, and adduct context from the current featuresTable." ;
    sf:guidance "Use after groupFeatures, createComponents, or annotateComponents when internal standards were created earlier. Rows are matched within each analysis by feature identity; unmatched rows remain unchanged. The operation mutates only the internalStandardsTable projection and does not require suspect targets." ;
    sf:hasInputPort sfms:featuresTable, sfms:internalStandardsTable ;
    sf:hasOutputPort sfms:internalStandardsTable, sfcore:operationSuccessSignal .


sfms:correctMatrixSuppression
    a sf:Operation ;
    sf:operationId "mass_spec.correct_matrix_suppression" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Correct matrix suppression" ;
    skos:definition "Apply matrix/suppression correction factors derived from all analysis intensity profiles." ;
    sf:guidance "Connect featuresTable and, when available, internalStandardsTable. The operation processes every analysis represented by the connected featuresTable; no analysis selector is required. The reference blank replicate may be left empty to use the available blank metadata." ;
    sf:hasParameter
        sfms:mpRtWindowParameter,
        sfms:refBlankReplicateParameter ;
    sf:hasInputPort sfms:featuresTable, sfms:internalStandardsTable ;
    sf:hasOutputPort sfms:featuresTable, sfcore:operationSuccessSignal .


sfms:filterSuspects
    a sf:Operation ;
    sf:operationId "mass_spec.filter_suspects" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Filter suspects" ;
    skos:definition "Refine suspect-screening results by applying name, score, RT/mass error, identification-level, fragment, and cosine-similarity thresholds." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:namesParameter,
        sfms:minScoreParameter,
        sfms:maxErrorRtParameter,
        sfms:maxErrorMassParameter,
        sfms:idLevelsParameter,
        sfms:minSharedFragmentsParameter,
        sfms:minCosineSimilarityParameter ;
    sf:hasInputPort sfms:featuresTable, sfms:suspectsTable ;
    sf:hasOutputPort sfms:suspectsTable, sfcore:operationSuccessSignal .


sfms:filterInternalStandards
    a sf:Operation ;
    sf:operationId "mass_spec.filter_internal_standards" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Filter internal standards" ;
    skos:definition "Refine internal-standard matches using only the rows and evidence stored in internalStandardsTable." ;
    sf:guidance "Connect internalStandardsTable. The operation does not require featuresTable or an analysis selector; all filters are applied to every persisted internal-standard row and the result is emitted as a new internalStandardsTable. Enable Deduplicate internal-standard matches to keep one chemically identical candidate per analysis and polarity. Deduplication prioritizes the smallest absolute RT error, then mass error, shared fragments, score, intensity, area, cosine similarity, identification level, and candidate rank." ;
    sf:hasParameter
        sfms:namesParameter,
        sfms:minScoreParameter,
        sfms:maxErrorRtParameter,
        sfms:maxErrorMassParameter,
        sfms:idLevelsParameter,
        sfms:minSharedFragmentsParameter,
        sfms:minCosineSimilarityParameter,
        sfms:deduplicateInternalStandardsParameter ;
    sf:hasInputPort sfms:internalStandardsTable ;
    sf:hasOutputPort sfms:internalStandardsTable, sfcore:operationSuccessSignal .


sfms:assignTransformationProducts
    a sf:Operation ;
    sf:operationId "mass_spec.assign_transformation_products" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Assign transformation products" ;
    skos:definition "Assign plausible biotransformation products to suspected features using transformation-product candidates, scoring combinations by mass/MS2 cosine similarity and logP-based retention-time plausibility, and emit the scored assignments as an independent transformationProductsTable." ;
    sf:hasParameter
        sfcore:analysisNamesParameter,
        sfms:transformationProductsParameter,
        sfms:chromatographicPhaseParameter,
        sfms:mzrMs2Parameter ;
    sf:hasInputPort sfms:featuresTable, sfms:suspectsTable ;
    sf:hasOutputPort sfms:transformationProductsTable, sfcore:operationSuccessSignal .


sfms:metfragScreening
    a sf:Operation ;
    sf:operationId "mass_spec.metfrag_screening" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Suspect screening with MetFrag" ;
    skos:definition "Run in-silico MetFrag fragmenter screening for all persisted detected features using a selectable candidate database, then rank resulting candidates into the suspect results." ;
    sf:guidance "Requires Java 21 and MetFragCL. Provide user-defined candidates through the suspect_targets parameter; those rows take precedence and automatically use LocalCSV. Select PubChem or ExtendedPubChem for online retrieval, PubChemLite for a local PubChemLite CSV, or CompToxCSV for a local CompTox CSV. All local database modes use database_path. If suspect_targets is empty, LocalCSV reads database_path. CompTox rows lacking an identifier, name, neutral mass, formula, or individual-component SMILES are excluded and duplicate component identifiers are collapsed. Isotope matching is evaluated from each candidate formula or structure for every database mode and reported as MS1 isotope fields; it is evidence, not a replacement for mass/RT/MS2 criteria. Candidates without experimental MS2 are always searched by precursor mass and returned at Cat. 4 unless RT or fragment evidence supports a higher level. feature_parallelism controls bounded feature-level concurrency, number_threads controls threads within each MetFrag job, and cache_candidates reuses identical queries. MetFrag in-silico MS2 evidence is Cat. 3; Cat. 1 and Cat. 2 are reserved for reference-MS2 screening." ;
    sf:hasParameter
        sfms:suspectTargetsParameter,
        sfms:ppmParameter,
        sfms:secParameter,
        sfms:ppmMs2Parameter,
        sfms:mzrMs2Parameter,
        sfms:isotopePpmParameter,
        sfms:databaseTypeParameter,
        sfms:databasePathParameter,
        sfms:topNParameter,
        sfms:scoreTypesParameter,
        sfms:scoreWeightsParameter,
        sfms:preProcessingCandidateFilterParameter,
        sfms:postProcessingCandidateFilterParameter,
        sfms:maximumTreeDepthParameter,
        sfms:numberThreadsParameter,
        sfms:featureParallelismParameter,
        sfms:cacheCandidatesParameter,
        sfms:includeFragmentSmilesParameter,
        sfms:useSmilesParameter,
        sfms:filteredParameter,
        sfms:debugParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:suspectsTable, sfcore:operationSuccessSignal .

sfms:findInternalStandardsMetfrag
    a sf:Operation ;
    sf:operationId "mass_spec.find_internal_standards_metfrag" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:ntaModule ;
    skos:prefLabel "Find internal standards with MetFrag" ;
    skos:definition "Run the MetFrag in-silico fragmentation screening path against detected features and user-supplied internal-standard suspect targets, then publish the resulting assignments in the independent internalStandardsTable contract." ;
    skos:guidance "Provide user-defined internal-standard candidates through the suspect_targets parameter, normally including deuterated compounds. The operation always uses those rows as its LocalCSV candidate database; public database selection and database-path parameters are intentionally unavailable. Use after loadFeaturesMs2 when experimental MS2 is available. MS1 isotope-pattern matching is evaluated from each target formula or structure; D or [2H] formulas also include bounded partial D-to-H isotopologues below the dominant labelled ion, matching the annotate_components base-ion convention, and the result is reported in the internal-standard table. Requires Java 21 and MetFragCL 2.6.11. The operation emits only internalStandardsTable and an operation-success signal." ;
    sf:hasParameter
        sfms:ppmParameter,
        sfms:secParameter,
        sfms:ppmMs2Parameter,
        sfms:mzrMs2Parameter,
        sfms:isotopePpmParameter,
        sfms:topNParameter,
        sfms:scoreTypesParameter,
        sfms:scoreWeightsParameter,
        sfms:preProcessingCandidateFilterParameter,
        sfms:postProcessingCandidateFilterParameter,
        sfms:maximumTreeDepthParameter,
        sfms:numberThreadsParameter,
        sfms:featureParallelismParameter,
        sfms:cacheCandidatesParameter,
        sfms:includeFragmentSmilesParameter,
        sfms:useSmilesParameter,
        sfms:filteredParameter,
        sfms:suspectTargetsParameter,
        sfms:debugParameter ;
    sf:hasInputPort sfms:featuresTable ;
    sf:hasOutputPort sfms:internalStandardsTable, sfcore:operationSuccessSignal .

sfms:fragmentSuspectTargets
    a sf:Operation ;
    sf:operationId "mass_spec.fragment_suspect_targets" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Generate suspect fragmentation trees" ;
    skos:definition "Generate a structural top-down fragmentation tree for every SMILES in the connected suspectTargetsTable using the standalone MetFrag Fragmenter CLI, preserving MetFrag-generated parent links and exposed structure metadata." ;
    sf:category "structure-fragmentation" ;
    sf:guidance "Connect suspectTargetsTable. Rows without SMILES are skipped. Requires Java 21 and the streamfind MetFrag Fragmenter JAR. Install dependency mass_spec.metfrag_fragmenter to download the pinned public v0.1.0 release into <streamfind-home>/tools/metfrag/streamfind-metfrag-fragmenter.jar, or set STREAMFIND_METFRAG_FRAGMENTER_JAR to a local JAR path. Parent links describe the generator's top-down traversal, not experimentally observed MS/MS transitions. Neutral-loss structures are limited to matches exposed by MetFrag." ;
    sf:hasParameter sfms:fragmentationDepthParameter ;
    sf:hasInputPort sfms:suspectTargetsTable ;
    sf:hasOutputPort sfms:fragmentationTreeTable, sfcore:operationSuccessSignal .

sfms:fragmentationToSuspectTargets
    a sf:Operation ;
    sf:operationId "mass_spec.fragmentation_to_suspect_targets" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Convert fragments to suspect targets" ;
    skos:definition "Convert each generated fragmentationTreeTable row into a chemical candidate row in suspectTargetsTable for downstream suspect screening, normalizing SMILES-derived descriptors with Open Babel when available." ;
    sf:category "structure-conversion" ;
    sf:guidance "Connect a MetFrag fragmentationTreeTable. Each fragment with a non-empty SMILES becomes one suspect target, with its fragment identifier appended to the source name. Open Babel canonicalizes the SMILES and derives formula, exact mass, InChI, InChIKey, and xLogP when available. Fragment parent/provenance fields remain in the source fragmentation artifact. The default retains at most two representative SMILES per formula to keep screening practical; set number_duplicate_formulas to another positive value for a controlled isomer set, or explicitly use zero to keep all rows." ;
    sf:hasParameter sfms:numberDuplicateFormulasParameter ;
    sf:hasInputPort sfms:fragmentationTreeTable ;
    sf:hasOutputPort sfms:suspectTargetsTable, sfcore:operationSuccessSignal .

sfms:expandFragmentationTree
    a sf:Operation ;
    sf:operationId "mass_spec.expand_fragmentation_tree" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Expand fragmentation tree inversely" ;
    skos:definition "Extend a one-compound fragmentationTreeTable with bounded, structure-bearing inverse-fragmentation candidates and return the same table contract. The MOL-derived row without parent_id is the main compound at depth 0; every generated graph-edit candidate is assigned depth -1." ;
    sf:category "structure-fragmentation" ;
    sf:guidance "Connect one fragmentationTreeTable generated from one MOL-derived suspect. The operation requires exactly one row without parent_id and rejects multi-root input to prevent mixing compounds. It preserves all original rows and appends depth -1 candidates. Unique observed fragment SMILES are attached at a bounded number of valid root/fragment positions; a second observed fragment may then be attached to model multi-unit impurities. A separate local-edit layer adds positional H/D exchange and simple oxygenation, fluorination, chlorination, and bromination hypotheses. Remaining capacity is filled with validated non-aromatic bond-order isomers. Open Babel canonicalizes every candidate and derives its formula and exact mass; provenance records the source fragment(s) and transformation. max_inverse_candidates caps the complete result, while the other parameters bound attachment positions, multi-unit expansion, and local edits. Formula-only composition hypotheses are intentionally handled by a separate formula-processing operation." ;
    sf:hasParameter
        sfms:maxInverseCandidatesParameter,
        sfms:maxAttachmentVariantsPerFragmentParameter,
        sfms:maxFragmentUnitsPerCandidateParameter,
        sfms:maxLocalEditCandidatesParameter ;
    sf:hasInputPort sfms:fragmentationTreeTable ;
    sf:hasOutputPort sfms:fragmentationTreeTable, sfcore:operationSuccessSignal .

sfms:filterFragmentationTree
    a sf:Operation ;
    sf:operationId "mass_spec.filter_fragmentation_tree" ;
    sf:availableInDomain sfms:mass_spec ;
    sf:providedByModule sfms:baseModule ;
    skos:prefLabel "Filter fragmentation tree" ;
    skos:definition "Filter fragmentationTreeTable rows by inclusive exact-mass bounds and limit repeated structures sharing the same formula while preserving the fragmentation-tree schema." ;
    sf:category "structure-fragmentation" ;
    sf:guidance "Connect one fragmentationTreeTable. Minimum and maximum fragment mass are inclusive and nullable. number_duplicate_formulas limits the number of rows retained per non-empty formula; zero keeps all rows. Filtering is applied in depth order and does not invent candidates or change parent links." ;
    sf:hasParameter
        sfms:fragmentationTreeMinimumMassParameter,
        sfms:fragmentationTreeMaximumMassParameter,
        sfms:numberDuplicateFormulasParameter ;
    sf:hasInputPort sfms:fragmentationTreeTable ;
    sf:hasOutputPort sfms:fragmentationTreeTable, sfcore:operationSuccessSignal .
