@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfms: <https://streamfind.dev/catalogue/domains/mass_spec#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfms:updatedField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Updated row count" ;
    skos:definition "Number of analysis rows updated by a metadata operation." ;
    sf:propertyName "updated" ;
    sf:type "integer" .

sfms:targetIdField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Target identifier" ;
    skos:definition "Stable identifier returned with rows matched to this target." ;
    sf:propertyName "id" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "caffeine" .

sfms:targetAnalysesField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Target analyses" ;
    skos:definition "Optional canonical analysis names to match. Use names returned by mass_spec.get_analysis_names; omit to search all analyses selected by the operation." ;
    sf:propertyName "analyses" ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"sample-r001\",\"sample-r002\"]" .

sfms:targetPolarityField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Target polarity" ;
    skos:definition "Optional ion polarity for this target: 1 for positive ions or -1 for negative ions." ;
    sf:propertyName "polarity" ;
    sf:type "integer" ;
    sf:required false ;
    sf:example 1 .

sfms:targetLevelsField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Target MS levels" ;
    skos:definition "Optional MS levels to match for this target, normally 1 for precursor/MS1 data or 2 for fragment/MS2 data." ;
    sf:propertyName "levels" ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:integerItemParameter ;
    sf:example "[1,2]" .

sfms:targetMassField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Target neutral mass" ;
    skos:definition "Exact neutral monoisotopic mass in daltons. The operation converts it to m/z using charge and polarity when needed." ;
    sf:propertyName "mass" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 194.0804 .

sfms:targetMassMinField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum target neutral mass" ;
    skos:definition "Inclusive lower neutral monoisotopic-mass bound in daltons." ;
    sf:propertyName "mass_min" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 194.0 .

sfms:targetMassMaxField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum target neutral mass" ;
    skos:definition "Inclusive upper neutral monoisotopic-mass bound in daltons." ;
    sf:propertyName "mass_max" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 194.2 .

sfms:targetMzField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Target m/z" ;
    skos:definition "Exact measured ion m/z in Thomson. The operation expands an exact value by ppm tolerance." ;
    sf:propertyName "mz" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 195.0877 .

sfms:targetMzMinField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum target m/z" ;
    skos:definition "Lower m/z bound." ;
    sf:propertyName "mz_min" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 195.0 .

sfms:targetMzMaxField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum target m/z" ;
    skos:definition "Upper m/z bound." ;
    sf:propertyName "mz_max" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 195.2 .

sfms:targetRtField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Target retention time" ;
    skos:definition "Exact retention time." ;
    sf:propertyName "rt" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 1020.0 .

sfms:targetRtMinField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Minimum target retention time" ;
    skos:definition "Lower retention-time bound." ;
    sf:propertyName "rt_min" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 1000.0 .

sfms:targetRtMaxField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Maximum target retention time" ;
    skos:definition "Upper retention-time bound." ;
    sf:propertyName "rt_max" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 1040.0 .

sfms:suspectNameField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Suspect name" ;
    skos:definition "Suspect display name used in assignment rows and filtering; an alias of the target identifier." ;
    sf:propertyName "name" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "caffeine" .

sfms:suspectFormulaField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Suspect formula" ;
    skos:definition "Molecular formula; used to derive exact mass when mass/mz are absent." ;
    sf:propertyName "formula" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "C8H10N4O2" .

sfms:suspectSmilesField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Suspect SMILES" ;
    skos:definition "SMILES string used with Open Babel to derive formula, exact mass, and identifiers." ;
    sf:propertyName "SMILES" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "CN1C=NC2=C1C(=O)N(C(=O)N2C)C" .

sfms:suspectInChIField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Suspect InChI" ;
    skos:definition "IUPAC InChI used with Open Babel when SMILES is absent." ;
    sf:propertyName "InChI" ;
    sf:type "string" ;
    sf:required false .

sfms:suspectInChIKeyField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Suspect InChIKey" ;
    skos:definition "InChIKey hash; replaced by the Open Babel value when normalised." ;
    sf:propertyName "InChIKey" ;
    sf:type "string" ;
    sf:required false .

sfms:suspectXLogPField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Suspect xLogP" ;
    skos:definition "Predicted log P; replaced by the Open Babel value when normalised." ;
    sf:propertyName "xLogP" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 0.5 .

sfms:suspectScoreField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Suspect score" ;
    skos:definition "Optional user-assigned base score stored on every assignment row." ;
    sf:propertyName "score" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 1.0 .

sfms:suspectDatabaseIdField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Suspect database identifier" ;
    skos:definition "External database identifier carried through to assignment rows." ;
    sf:propertyName "database_id" ;
    sf:type "string" ;
    sf:required false .

sfms:suspectFragmentsMzPosField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Positive-mode fragment m/z" ;
    skos:definition "Positive-mode MS2 fragment m/z values paired with fragments_intensity_pos." ;
    sf:propertyName "fragments_mz_pos" ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:realItemParameter ;
    sf:example "[138.066, 195.088]" .

sfms:suspectFragmentsIntensityPosField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Positive-mode fragment intensities" ;
    skos:definition "Positive-mode MS2 fragment intensities paired with fragments_mz_pos." ;
    sf:propertyName "fragments_intensity_pos" ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:realItemParameter ;
    sf:example "[100.0, 80.0]" .

sfms:suspectFragmentsMzNegField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Negative-mode fragment m/z" ;
    skos:definition "Negative-mode MS2 fragment m/z values paired with fragments_intensity_neg." ;
    sf:propertyName "fragments_mz_neg" ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:realItemParameter ;
    sf:example "[138.066]" .

sfms:suspectFragmentsIntensityNegField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Negative-mode fragment intensities" ;
    skos:definition "Negative-mode MS2 fragment intensities paired with fragments_mz_neg." ;
    sf:propertyName "fragments_intensity_neg" ;
    sf:type "array" ;
    sf:required false ;
    sf:items sfcore:realItemParameter ;
    sf:example "[100.0]" .

sfms:tpProductNameField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Name" ;
    skos:definition "Transformation-product candidate field name." ;
    sf:propertyName "name" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "Metoprolol O-dealkylation" .

sfms:tpTransformationField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Transformation" ;
    skos:definition "Transformation-product candidate field transformation." ;
    sf:propertyName "transformation" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "O-Dealkylation" .

sfms:tpPrecursorNameField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Precursor Name" ;
    skos:definition "Transformation-product candidate field precursor_name." ;
    sf:propertyName "precursor_name" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "Metoprolol" .

sfms:tpPrecursorFormulaField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Precursor Formula" ;
    skos:definition "Transformation-product candidate field precursor_formula." ;
    sf:propertyName "precursor_formula" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "C15H25NO3" .

sfms:tpPrecursorMassField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Precursor Mass" ;
    skos:definition "Transformation-product candidate field precursor_mass." ;
    sf:propertyName "precursor_mass" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 267.1834 .

sfms:tpPrecursorSmilesField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Precursor Smiles" ;
    skos:definition "Transformation-product candidate field precursor_SMILES." ;
    sf:propertyName "precursor_SMILES" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "COCCc1ccc(cc1)OCC(CNC(C)C)O" .

sfms:tpPrecursorInChIField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Precursor Inchi" ;
    skos:definition "Transformation-product candidate field precursor_InChI." ;
    sf:propertyName "precursor_InChI" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "InChI=1S/C15H25NO3/c1-12(2)16-10-14(17)11-19-15-6-4-13(5-7-15)8-9-18-3/h4-7,12,14,16-17H,8-11H2,1-3H3" .

sfms:tpPrecursorInChIKeyField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Precursor Inchikey" ;
    skos:definition "Transformation-product candidate field precursor_InChIKey." ;
    sf:propertyName "precursor_InChIKey" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "IUBSYMUCCVWXPE-UHFFFAOYSA-N" .

sfms:tpPrecursorXLogPField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Precursor Xlogp" ;
    skos:definition "Transformation-product candidate field precursor_xLogP." ;
    sf:propertyName "precursor_xLogP" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 1.9 .

sfms:tpMainPrecursorNameField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Main Precursor Name" ;
    skos:definition "Transformation-product candidate field main_precursor_name." ;
    sf:propertyName "main_precursor_name" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "Metoprolol" .

sfms:tpMainPrecursorFormulaField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Main Precursor Formula" ;
    skos:definition "Transformation-product candidate field main_precursor_formula." ;
    sf:propertyName "main_precursor_formula" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "C15H25NO3" .

sfms:tpMainPrecursorMassField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Main Precursor Mass" ;
    skos:definition "Transformation-product candidate field main_precursor_mass." ;
    sf:propertyName "main_precursor_mass" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 267.1834 .

sfms:tpMainPrecursorSmilesField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Main Precursor Smiles" ;
    skos:definition "Transformation-product candidate field main_precursor_SMILES." ;
    sf:propertyName "main_precursor_SMILES" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "COCCc1ccc(cc1)OCC(CNC(C)C)O" .

sfms:tpMainPrecursorInChIField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Main Precursor Inchi" ;
    skos:definition "Transformation-product candidate field main_precursor_InChI." ;
    sf:propertyName "main_precursor_InChI" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "InChI=1S/C15H25NO3/c1-12(2)16-10-14(17)11-19-15-6-4-13(5-7-15)8-9-18-3/h4-7,12,14,16-17H,8-11H2,1-3H3" .

sfms:tpMainPrecursorInChIKeyField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Main Precursor Inchikey" ;
    skos:definition "Transformation-product candidate field main_precursor_InChIKey." ;
    sf:propertyName "main_precursor_InChIKey" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "IUBSYMUCCVWXPE-UHFFFAOYSA-N" .

sfms:tpMainPrecursorXLogPField
    a sf:Field ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Main Precursor Xlogp" ;
    skos:definition "Transformation-product candidate field main_precursor_xLogP." ;
    sf:propertyName "main_precursor_xLogP" ;
    sf:type "real" ;
    sf:required false ;
    sf:example 1.9 .
