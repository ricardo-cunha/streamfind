@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sfms: <https://streamfind.dev/catalogue/domains/mass_spec#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfms:analysisNameColumn
    a sf:Column ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analysis" ;
    skos:definition "Analysis identifier." ;
    sf:columnName "analysis" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfms:analysisIndexColumn
    a sf:Column ;
    sf:availableInDomain sfms:mass_spec ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analysis index" ;
    skos:definition "Zero-based logical analysis index within the physical source file." ;
    sf:columnName "analysis_index" ;
    sf:type "integer" ;
    sf:storageType "INTEGER" .

