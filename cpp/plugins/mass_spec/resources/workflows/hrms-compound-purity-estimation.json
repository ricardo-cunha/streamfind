  "metadata": {
    "name": "HRMS Compound Purity Estimation",
    "description": "Processes blank and sample HRMS files through feature detection, component annotation, filtering, blank subtraction, MS1/MS2 loading, target matching, suspect fragmentation, and MetFrag identification.",
    "methods": [
      "Blank and replicate naming",
      "Feature detection and componentization",
      "Isotope, adduct, and loss annotation",
      "Feature filtering and blank subtraction",
      "MS1 and MS2 feature spectrum loading",
      "Target-matched feature retrieval",
      "Suspect target preparation and fragmentation",
      "MetFrag suspect screening and identification",
      "Total ion chromatogram visualization"
    ],
    "owner": "StreamFind mass-spectrometry demos",
    "purpose": "Prepare an HRMS workflow for compound purity estimation and suspect identification",
    "sample_type": "HRMS sample",
    "use_case": "Compound purity estimation with MetFrag identification"
  },
