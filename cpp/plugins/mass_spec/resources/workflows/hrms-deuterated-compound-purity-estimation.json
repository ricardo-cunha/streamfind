  "metadata": {
    "name": "HRMS Deuterated Compound Purity Estimation",
    "description": "Example deuterium-aware HRMS purity workflow, including isotope-chain annotation, blank subtraction, MS1/MS2 loading, and target matching.",
    "methods": [
      "Blank and replicate naming",
      "Feature detection and componentization",
      "Deuterium-aware isotope, adduct, and loss annotation",
      "Feature filtering and blank subtraction",
      "MS1 and MS2 feature spectrum loading",
      "Target-matched feature retrieval",
      "Suspect target preparation and fragmentation",
      "MetFrag suspect screening and identification",
      "Total ion chromatogram visualization"
    ],
    "owner": "StreamFind mass-spectrometry demos",
    "purpose": "Demonstrate compound purity estimation for deuterated HRMS compounds",
    "sample_type": "LC-UV-HRMS sample",
    "use_case": "Deuterated compound purity estimation with isotope-aware annotation"
  },
