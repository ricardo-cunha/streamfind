  "metadata": {
    "name": "Non-target Screening basic demo",
    "description": "Complete non-target screening workflow for high-resolution mass-spectrometry data, including feature processing, internal-standard handling, and suspect screening.",
    "methods": [
      "Blank and replicate naming",
      "Feature detection and componentization",
      "Isotope, adduct, and loss annotation",
      "MS1 and MS2 feature spectrum loading",
      "Internal-standard detection and enrichment",
      "Feature grouping and gap filling",
      "Matrix-suppression correction and internal-standard filtering",
      "Blank subtraction and feature filtering",
      "Suspect screening with MetFrag",
      "Total ion chromatogram visualization"
    ],
    "owner": "StreamFind mass-spectrometry demos",
    "purpose": "Demonstrate an end-to-end non-target screening workflow",
    "sample_type": "High-resolution mass-spectrometry samples",
    "use_case": "Non-target screening with internal-standard quality control and suspect identification"
  },
