#include <windows.h>

LANGUAGE 0, 0
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @STREAMFIND_VERSION_RESOURCE_NUMBERS@
 PRODUCTVERSION @STREAMFIND_VERSION_RESOURCE_NUMBERS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "streamfind\0"
            VALUE "FileDescription", "@STREAMFIND_VERSION_RESOURCE_DESCRIPTION@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "@STREAMFIND_VERSION_RESOURCE_FILENAME@\0"
            VALUE "OriginalFilename", "@STREAMFIND_VERSION_RESOURCE_FILENAME@\0"
            VALUE "ProductName", "streamfind\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
