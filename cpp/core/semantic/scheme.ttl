@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfcore:scheme
    a skos:ConceptScheme ;
    skos:prefLabel "streamfind semantic catalogue" ;
    skos:definition "Canonical semantic declarations for streamfind domains, operations, methods, parameters, results, errors, and interfaces." .
