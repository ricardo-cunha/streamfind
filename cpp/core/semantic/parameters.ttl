@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfcore:projectPathParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Project folder path" ;
    skos:definition "Filesystem path of a StreamFind .sf project folder containing project.duckdb and data/." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "/data/project.sf" .

sfcore:workerIdParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Worker ID" ;
    skos:definition "External worker identity used to claim and release one project workflow execution." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "frontend-worker-1" .

sfcore:executionModeParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow execution mode" ;
    skos:definition "Controls when workflow node results become published and inspectable. Both modes retain every completed node result on disk and in the project result inventory. detailed publishes each node result immediately; pipeline publishes the retained results together when the workflow reaches a terminal state." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "detailed" ;
    sf:constraints "detailed|pipeline" ;
    sf:example "pipeline" .

sfcore:executionStatusParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow execution status" ;
    skos:definition "Requested lifecycle transition for a workflow execution. The running transition starts the saved workflow and may include execution_mode; cancelling or cancelled requests cancellation." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:constraints "running|cancelling|cancelled" ;
    sf:example "running" .


sfcore:pluginParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Project plugin" ;
    skos:definition "Plugin identifier used to discover canonical workflow operations and capabilities; it is not a project-level assignment." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:constraints "mass_spec|raman|sensors|streamfind" ;
    sf:example "mass_spec" .

sfcore:projectMetadataParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Project metadata" ;
    skos:definition "User-defined annotations stored on the .sf project workspace. Separate from workflow metadata and future operational project configuration. Each stored value must be a JSON scalar." ;
    sf:type "object" ;
    sf:required true ;
    sf:default "{}" ;
    sf:example "{\"owner\":\"research\"}" .

sfcore:projectMetadataCreateParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Initial project metadata" ;
    skos:definition "Optional user-defined annotations for a new project workspace. Each value must be a JSON scalar; this field does not configure the workflow or scheduler." ;
    sf:type "object" ;
    sf:required false ;
    sf:default "{}" ;
    sf:example "{\"owner\":\"research\"}" .

sfcore:workflowMetadataParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow metadata" ;
    skos:definition "JSON metadata attached to the saved workflow definition, including its required name and description. Distinct from project metadata; replacing it does not modify operations or connections." ;
    sf:type "object" ;
    sf:required false ;
    sf:default "{}" ;
    sf:example "{\"name\":\"Peak review\",\"description\":\"Review chromatographic peaks\"}" .

sfcore:workflowMetadataReplacementParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Replacement workflow metadata" ;
    skos:definition "Complete replacement object for workflow.metadata. Must contain a non-empty name and description; additional descriptive keys are allowed. Does not include operations or connections." ;
    sf:type "object" ;
    sf:required true ;
    sf:default "{\"name\":\"Untitled workflow\",\"description\":\"Describe the purpose of this workflow.\"}" ;
    sf:example "{\"name\":\"Peak review\",\"description\":\"Review chromatographic peaks\"}" .

sfcore:workflowDefinitionRevisionParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow definition revision" ;
    skos:definition "Current concurrency revision returned by get_workflow. Always read and pass the current value to set_workflow_metadata; the initial value 1 is not a safe default for an existing project." ;
    sf:type "integer" ;
    sf:required true ;
    sf:default 1 ;
    sf:constraints "minimum:1" ;
    sf:example "3" .

sfcore:workflowParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow" ;
    skos:definition "Persisted operation graph containing configured operation nodes, explicit typed connections, and the definition_revision returned by get_workflow. Preserve that revision when saving so concurrent edits are detected." ;
    sf:type "object" ;
    sf:required true ;
    sf:default "{}" ;
    sf:example "{\"operations\":[],\"connections\":[]}" .

sfcore:methodParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Method identifier" ;
    skos:definition "Stable canonical identifier of a workflow operation, for example mass_spec.find_features. Obtain valid operation identifiers and their schemas from get_operations(plugin) and get_operation(operation)." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "mass_spec.get_raw_spectra" .

sfcore:parametersParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Method parameters" ;
    skos:definition "JSON object containing operation-specific parameter values. Use the selected operation's schema from get_operation; unknown keys are rejected." ;
    sf:type "object" ;
    sf:required false ;
    sf:default "{}" ;
    sf:example "{}" .

sfcore:pathsParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Paths" ;
    skos:definition "Files and vendor directories selected for a workflow input." ;
    sf:type "array" ;
    sf:required true ;
    sf:default "[]" ;
    sf:items sfcore:filePathColumn ;
    sf:example "[\"data/sample.wiff\",\"data/batch.d\"]" .

sfcore:csvPathParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "CSV output path" ;
    skos:definition "Filesystem path where a connected table is written as a UTF-8 CSV file, including a header row." ;
    sf:type "string" ;
    sf:pathKind "file-output" ;
    sf:required true ;
    sf:default "" ;
    sf:example "results/features.csv" .

sfcore:jsonPathParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "JSON output path" ;
    skos:definition "Filesystem path where a connected JSON artifact is written as formatted UTF-8 JSON." ;
    sf:type "string" ;
    sf:pathKind "file-output" ;
    sf:required true ;
    sf:default "" ;
    sf:example "results/debug.json" .

sfcore:csvInputPathParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "CSV input path" ;
    skos:definition "Filesystem path of a UTF-8 CSV file with a header row to import as a runtime AnyTable." ;
    sf:type "string" ;
    sf:pathKind "file" ;
    sf:required true ;
    sf:default "" ;
    sf:example "data/features.csv" .

sfcore:destinationProjectPathParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Destination project folder path" ;
    skos:definition "Filesystem path for the copied StreamFind .sf project folder." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "/data/copied.sf" .

sfcore:operationIdParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow operation node ID" ;
    skos:definition "Integer identifier assigned to a workflow operation node." ;
    sf:type "integer" ;
    sf:required true ;
    sf:default "" ;
    sf:example "1" .

sfcore:operationParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Operation identifier" ;
    skos:definition "Canonical catalogue identifier of the operation to add to the workflow." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "mass_spec.read_mass_spec_files" .

sfcore:sourceOperationParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Source operation node ID" ;
    skos:definition "Integer identifier of the workflow node that publishes the connected output." ;
    sf:type "integer" ;
    sf:required true ;
    sf:default "" ;
    sf:example "1" .

sfcore:sourcePortParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Source output port" ;
    skos:definition "Semantic output contract published by the source operation." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "sfms:analysesTable" .

sfcore:targetOperationParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Target operation node ID" ;
    skos:definition "Integer identifier of the workflow node that consumes the connected input." ;
    sf:type "integer" ;
    sf:required true ;
    sf:default "" ;
    sf:example "2" .

sfcore:targetPortParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Target input port" ;
    skos:definition "Semantic input contract consumed by the target operation." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "sfms:analysesTable" .

sfcore:outputPortParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Output contract" ;
    skos:definition "Semantic output contract to locate in the artifact inventory." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "sfms:analysesTable" .

sfcore:resultIdParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Result identifier" ;
    skos:definition "Exact immutable result identifier returned by the result inventory." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "result-0001" .

sfcore:operationInstanceParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Operation node ID" ;
    skos:definition "Integer workflow node identifier that produced or consumes a result." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default "" ;
    sf:example "1" .

sfcore:includeDataParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Include artifact data" ;
    skos:definition "Return the selected JSON payload or bounded rows from a table artifact." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:default "false" ;
    sf:example false .

sfcore:resultLimitParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Result row limit" ;
    skos:definition "Maximum number of table rows returned when result data is requested." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default "1000" ;
    sf:example 1000 .

sfcore:resultOffsetParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Result row offset" ;
    skos:definition "Number of table rows to skip when result data is requested." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default "0" ;
    sf:example 0 .


sfcore:analysesParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analyses" ;
    skos:definition "Array of analysis file records." ;
    sf:type "array" ;
    sf:required true ;
    sf:default "[]" ;
    sf:example "[{\"path\":\"data/sample.mzML\",\"replicate_name\":\"r1\"}]" ;
    sf:items sfcore:analysisFileParameter .

sfcore:analysisFileParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analysis file" ;
    skos:definition "One analysis file and optional replicate and blank labels." ;
    sf:type "object" ;
    sf:required true ;
    sf:default "{}" ;
    sf:example "{\"path\":\"data/sample.mzML\",\"replicate_name\":\"r1\"}" ;
    sf:hasProperty
        sfcore:analysisFilePathField,
        sfcore:analysisFileReplicateField,
        sfcore:analysisFileBlankField .

sfcore:analysisNamesParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analysis names" ;
    skos:definition "Array of analysis file names without filename extensions." ;
    sf:type "array" ;
    sf:required true ;
    sf:defaultRequired true ;
    sf:default "[]" ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"sample\",\"blank\"]" .

sfcore:replicateNamesParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Replicate names" ;
    skos:definition "Replicate labels ordered by analysis name." ;
    sf:type "array" ;
    sf:required true ;
    sf:default "[]" ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"r1\",\"r2\"]" .

sfcore:blankNamesParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Blank names" ;
    skos:definition "Blank labels ordered by analysis name." ;
    sf:type "array" ;
    sf:required true ;
    sf:default "[]" ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"blank\",\"blank\"]" .

sfcore:concentrationsParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Concentrations" ;
    skos:definition "Analysis concentrations ordered by analysis name." ;
    sf:type "array" ;
    sf:required true ;
    sf:default "[]" ;
    sf:items sfcore:realItemParameter ;
    sf:example "[1.0,2.0]" .

sfcore:stringItemParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "String array item" ;
    skos:definition "One string value in a string array parameter." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "sample" .

sfcore:integerItemParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Integer array item" ;
    skos:definition "One integer value in an integer array parameter." ;
    sf:type "integer" ;
    sf:required true ;
    sf:default 0 ;
    sf:example 1 .

sfcore:realItemParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Real array item" ;
    skos:definition "One real value in a real array parameter." ;
    sf:type "real" ;
    sf:required true ;
    sf:default 0.0 ;
    sf:example 1.0 .

sfcore:debugAnalysisParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Debug analysis" ;
    skos:definition "Optional analysis name to include in plugin diagnostic logging. Empty disables the analysis selector." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "sample_1" .

sfcore:debugMzParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Debug m/z" ;
    skos:definition "Optional m/z value to include in plugin diagnostic logging. Zero disables the m/z selector." ;
    sf:type "real" ;
    sf:required false ;
    sf:default 0.0 ;
    sf:example 500.2 .

sfcore:debugSpecIdxParameter
    a sf:Parameter ;
    sf:availableInPlugin sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Debug spectrum index" ;
    skos:definition "Optional zero-based spectrum index to include in plugin diagnostic logging. -1 disables the spectrum selector." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default -1 ;
    sf:example 42 .
