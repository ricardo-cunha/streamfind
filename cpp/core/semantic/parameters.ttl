@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfcore:databasePathParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Database path" ;
    skos:definition "Filesystem path of the DuckDB project database. Use an existing .duckdb file for describe/connect and a new path for create." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "/data/project.duckdb" .

sfcore:workerIdParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Worker ID" ;
    skos:definition "External worker identity used to claim and release one project workflow execution." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "frontend-worker-1" .


sfcore:domainParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Project domain" ;
    skos:definition "Domain identifier used to discover canonical workflow operations and capabilities; it is not a project-level assignment." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:constraints "mass_spec|raman|sensors|streamfind" ;
    sf:example "mass_spec" .

sfcore:metadataParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Project metadata" ;
    skos:definition "JSON object containing project-owned metadata. Metadata is user-owned and may contain arbitrary JSON keys." ;
    sf:type "object" ;
    sf:required true ;
    sf:default "{}" ;
    sf:example "{}" .

sfcore:workflowParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow" ;
    skos:definition "Persisted operation graph containing configured operation nodes and explicit typed connections between their input and output ports." ;
    sf:type "object" ;
    sf:required true ;
    sf:default "{}" ;
    sf:example "{\"operations\":[],\"connections\":[]}" .

sfcore:methodParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Method identifier" ;
    skos:definition "Stable canonical identifier of a workflow operation, for example mass_spec.find_features. Obtain valid operation identifiers and their schemas from get_operations(domain) and get_operation(operation)." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "mass_spec.get_raw_spectra" .

sfcore:parametersParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Method parameters" ;
    skos:definition "JSON object containing operation-specific parameter values. Use the selected operation's schema from get_operation; unknown keys are rejected." ;
    sf:type "object" ;
    sf:required false ;
    sf:default "{}" ;
    sf:example "{}" .

sfcore:pathsParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Paths" ;
    skos:definition "Files and vendor directories selected for a workflow input." ;
    sf:type "array" ;
    sf:required true ;
    sf:default "[]" ;
    sf:items sfcore:filePathColumn ;
    sf:example "[\"data/sample.wiff\",\"data/batch.d\"]" .

sfcore:destinationDatabasePathParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Destination database path" ;
    skos:definition "Filesystem path for the copied DuckDB project database." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "/data/copied.duckdb" .

sfcore:operationIdParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow operation instance ID" ;
    skos:definition "Unique identifier for one operation instance in the backend workflow graph." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "add_analyses_1" .

sfcore:operationParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Operation identifier" ;
    skos:definition "Canonical catalogue identifier of the operation to add to the workflow." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "mass_spec.read_mass_spec_files" .

sfcore:sourceOperationParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Source operation instance" ;
    skos:definition "Workflow operation instance that publishes the connected output." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "add_analyses_1" .

sfcore:sourcePortParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Source output port" ;
    skos:definition "Semantic output contract published by the source operation." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "sfms:analysesTable" .

sfcore:targetOperationParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Target operation instance" ;
    skos:definition "Workflow operation instance that consumes the connected input." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "remove_analyses_1" .

sfcore:targetPortParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Target input port" ;
    skos:definition "Semantic input contract consumed by the target operation." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "sfms:analysesTable" .

sfcore:outputPortParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Output contract" ;
    skos:definition "Semantic output contract to locate in the artifact inventory." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" ;
    sf:example "sfms:analysesTable" .

sfcore:artifactIdParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Artifact identifier" ;
    skos:definition "Exact immutable artifact identifier returned by the artifact inventory." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" .

sfcore:operationInstanceParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Operation instance" ;
    skos:definition "Workflow operation instance that produced or consumes an artifact." ;
    sf:type "string" ;
    sf:required false ;
    sf:default "" .

sfcore:includeDataParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Include artifact data" ;
    skos:definition "Return the selected JSON payload or bounded rows from a table artifact." ;
    sf:type "boolean" ;
    sf:required false ;
    sf:default "false" .

sfcore:artifactLimitParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Artifact row limit" ;
    skos:definition "Maximum number of table rows returned when artifact data is requested." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default "1000" .

sfcore:artifactOffsetParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Artifact row offset" ;
    skos:definition "Number of table rows to skip when artifact data is requested." ;
    sf:type "integer" ;
    sf:required false ;
    sf:default "0" .


sfcore:analysesParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analyses" ;
    skos:definition "Array of analysis file records." ;
    sf:type "array" ;
    sf:required true ;
    sf:default "[]" ;
    sf:example "[{\"path\":\"data/sample.mzML\",\"replicate_name\":\"r1\"}]" ;
    sf:items sfcore:analysisFileParameter .

sfcore:analysisFileParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analysis file" ;
    skos:definition "One analysis file and optional replicate and blank labels." ;
    sf:type "object" ;
    sf:required true ;
    sf:default "{}" ;
    sf:example "{\"path\":\"data/sample.mzML\",\"replicate_name\":\"r1\"}" ;
    sf:hasProperty
        sfcore:analysisFilePathField,
        sfcore:analysisFileReplicateField,
        sfcore:analysisFileBlankField .

sfcore:analysisNamesParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analysis names" ;
    skos:definition "Array of analysis file names without filename extensions." ;
    sf:type "array" ;
    sf:required true ;
    sf:defaultRequired true ;
    sf:default "[]" ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"sample\",\"blank\"]" .

sfcore:replicateNamesParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Replicate names" ;
    skos:definition "Replicate labels ordered by analysis name." ;
    sf:type "array" ;
    sf:required true ;
    sf:default "[]" ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"r1\",\"r2\"]" .

sfcore:blankNamesParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Blank names" ;
    skos:definition "Blank labels ordered by analysis name." ;
    sf:type "array" ;
    sf:required true ;
    sf:default "[]" ;
    sf:items sfcore:stringItemParameter ;
    sf:example "[\"blank\",\"blank\"]" .

sfcore:concentrationsParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Concentrations" ;
    skos:definition "Analysis concentrations ordered by analysis name." ;
    sf:type "array" ;
    sf:required true ;
    sf:default "[]" ;
    sf:items sfcore:realItemParameter ;
    sf:example "[1.0,2.0]" .

sfcore:stringItemParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "String array item" ;
    skos:definition "One string value in a string array parameter." ;
    sf:type "string" ;
    sf:required true ;
    sf:default "" ;
    sf:example "sample" .

sfcore:integerItemParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Integer array item" ;
    skos:definition "One integer value in an integer array parameter." ;
    sf:type "integer" ;
    sf:required true ;
    sf:default 0 ;
    sf:example 1 .

sfcore:realItemParameter
    a sf:Parameter ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Real array item" ;
    skos:definition "One real value in a real array parameter." ;
    sf:type "real" ;
    sf:required true ;
    sf:default 0.0 ;
    sf:example 1.0 .
