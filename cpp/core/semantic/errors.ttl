@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfcore:invalidArgument
    a sf:Error ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Invalid argument" ;
    skos:definition "A required argument is missing or has an invalid value." ;
    sf:errorCode "InvalidArgument" .

sfcore:projectNotFound
    a sf:Error ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Project not found" ;
    skos:definition "The requested project database does not exist." ;
    sf:errorCode "ProjectNotFound" .
