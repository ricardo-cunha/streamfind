@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfcore:statusField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Operation status" ;
    skos:definition "Deterministic operation status." ;
    sf:propertyName "status" ;
    sf:type "string" ;
    sf:constraints "finished|failed" .

sfcore:infoField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Operation information" ;
    skos:definition "Human-readable information about the operation outcome." ;
    sf:propertyName "info" ;
    sf:type "string" .

sfcore:validField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Validation status" ;
    skos:definition "Whether validation succeeded." ;
    sf:propertyName "valid" ;
    sf:type "boolean" .

sfcore:methodField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow method" ;
    skos:definition "One validated method record in the ordered project workflow." ;
    sf:propertyName "method" ;
    sf:type "object" ;
    sf:hasProperty
        sfcore:methodIdField,
        sfcore:methodNameField,
        sfcore:methodDescriptionField,
        sfcore:methodDomainField,
        sfcore:methodParametersField,
        sfcore:methodCacheableField,
        sfcore:methodRequiredField .

sfcore:methodIdField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Method ID" ;
    skos:definition "Registered method identifier." ;
    sf:propertyName "id" ;
    sf:type "string" .

sfcore:methodNameField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Method name" ;
    skos:definition "Method display name." ;
    sf:propertyName "name" ;
    sf:type "string" .


sfcore:methodDescriptionField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Method description" ;
    skos:definition "Method description." ;
    sf:propertyName "description" ;
    sf:type "string" .

sfcore:methodDomainField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Method domain" ;
    skos:definition "Domain owning the method." ;
    sf:propertyName "domain" ;
    sf:type "string" .

sfcore:methodParametersField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Configured parameters" ;
    skos:definition "Validated configured method parameter values." ;
    sf:propertyName "parameters" ;
    sf:type "object" .

sfcore:methodCacheableField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Cacheable" ;
    skos:definition "Whether method results may be cached." ;
    sf:propertyName "cacheable" ;
    sf:type "boolean" .

sfcore:methodRequiredField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Required methods" ;
    skos:definition "Methods required earlier in the workflow." ;
    sf:propertyName "required_methods" ;
    sf:type "array" ;
    sf:items sfcore:stringItemParameter .

sfcore:methodSingleOccurrenceField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Single occurrence" ;
    skos:definition "Whether the method may occur only once in a workflow." ;
    sf:propertyName "single_occurrence" ;
    sf:type "boolean" .

sfcore:methodInputSchemaField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Method input schema" ;
    skos:definition "Complete JSON Schema for the method-specific parameter object. Use this schema when constructing add_method or run_method parameters." ;
    sf:propertyName "inputSchema" ;
    sf:type "object" .

sfcore:methodWritesField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Method written tables" ;
    skos:definition "Persisted tables written by the method." ;
    sf:propertyName "writes" ;
    sf:type "array" ;
    sf:items sfcore:stringItemParameter .

sfcore:analysisFilePathField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analysis file path" ;
    skos:definition "Filesystem path of the analysis file." ;
    sf:propertyName "path" ;
    sf:type "string" ;
    sf:required true ;
    sf:example "data/sample.mzML" .

sfcore:analysisFileReplicateField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analysis replicate name" ;
    skos:definition "Optional replicate label for the analysis." ;
    sf:propertyName "replicate_name" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "r1" .

sfcore:analysisFileBlankField
    a sf:Field ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Analysis blank name" ;
    skos:definition "Optional blank label for the analysis." ;
    sf:propertyName "blank_name" ;
    sf:type "string" ;
    sf:required false ;
    sf:example "blank" .
