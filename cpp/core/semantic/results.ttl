@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfcore:operationStatusResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Operation status" ;
    skos:definition "Whether an operation completed as requested and an informational message about the outcome." ;
    sf:type "object" ;
    sf:hasProperty
        sfcore:statusField,
        sfcore:infoField .

sfcore:projectDescriptorResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Project descriptor" ;
    skos:definition "Project identity, metadata, workflow, table list, and cache summary." ;
    sf:type "table" ;
    sf:hasProperty
        sfcore:projectDomainColumn,
        sfcore:projectMetadataColumn,
        sfcore:schemaVersionColumn,
        sfcore:frameworkVersionColumn,
        sfcore:createdAtColumn,
        sfcore:projectWorkflowColumn .

sfcore:validationResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Validation result" ;
    skos:definition "Whether validation succeeded and an explanatory message." ;
    sf:type "object" ;
    sf:hasProperty
        sfcore:validField,
        sfcore:infoField .

sfcore:domainResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Project domain result" ;
    skos:definition "The immutable domain assigned to the project." ;
    sf:type "string" .

sfcore:metadataResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Project metadata result" ;
    skos:definition "The project metadata JSON object." ;
    sf:type "table" ;
    sf:hasProperty sfcore:projectMetadataColumn .

sfcore:workflowResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow result" ;
    skos:definition "The ordered workflow method objects." ;
    sf:type "array" ;
    sf:items sfcore:methodField .

sfcore:cacheEntriesResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Cache entries result" ;
    skos:definition "The project's cache entries." ;
    sf:type "array" ;
    sf:items sfcore:cacheEntryResult .

sfcore:cacheEntryResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Cache entry" ;
    skos:definition "One cached workflow result entry." ;
    sf:type "object" ;
    sf:hasProperty
        sfcore:cacheNameColumn,
        sfcore:cacheDescriptionColumn,
        sfcore:cacheHashColumn,
        sfcore:createdAtColumn .

sfcore:cacheSizeResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Cache size result" ;
    skos:definition "The number of cache entries." ;
    sf:type "integer" .

sfcore:auditEntriesResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Audit trail result" ;
    skos:definition "The project's ordered audit events." ;
    sf:type "array" ;
    sf:items sfcore:auditEntryResult .

sfcore:auditEntryResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Audit entry" ;
    skos:definition "One persisted project audit event." ;
    sf:type "object" ;
    sf:hasProperty
        sfcore:operationTypeColumn,
        sfcore:objectTypeColumn,
        sfcore:operationDetailsColumn,
        sfcore:createdAtColumn .

sfcore:methodsResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Available methods result" ;
    skos:definition "Definitions of workflow methods registered for a domain." ;
    sf:type "array" ;
    sf:items sfcore:methodDefinitionResult .

sfcore:methodDefinitionResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Method definition" ;
    skos:definition "One workflow method definition available to a domain, including its complete method-specific input schema and execution metadata." ;
    sf:type "object" ;
    sf:hasProperty
        sfcore:methodIdField,
        sfcore:methodNameField,
        sfcore:methodDescriptionField,
        sfcore:methodDomainField,
        sfcore:methodInputSchemaField,
        sfcore:methodCacheableField,
        sfcore:methodSingleOccurrenceField,
        sfcore:methodRequiredField,
        sfcore:methodWritesField .

sfcore:workflowExecutionResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow execution result" ;
    skos:definition "Workflow results, cancellation state, and the persisted workflow." ;
    sf:type "object" .

sfcore:workflowExecutionEntriesResult
    a sf:Result ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow execution entries" ;
    skos:definition "Execution status for workflow steps." ;
    sf:type "table" ;
    sf:hasProperty
        sfcore:workflowRevisionColumn,
        sfcore:stepIndexColumn,
        sfcore:executionMethodColumn,
        sfcore:parameterHashColumn,
        sfcore:executionStatusColumn,
        sfcore:startedAtColumn,
        sfcore:completedAtColumn,
        sfcore:executionErrorColumn,
        sfcore:cacheKeyColumn .
