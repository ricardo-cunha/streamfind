{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default standalone core configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../tmp/build/core-default",
      "cacheVariables": {
        "STREAMFIND_BUILD_TESTS": "ON",
        "STREAMFIND_BUILD_SHARED": "OFF",
        "STREAMFIND_ENABLED_PLUGINS": "ALL"
      }
    },
    {
      "name": "mingw-ucrt64",
      "displayName": "Windows MinGW-w64 UCRT64 GCC configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../tmp/build/mingw-ucrt64",
      "environment": {
        "MSYSTEM": "UCRT64",
        "PATH": "C:/msys64/ucrt64/bin;C:/msys64/usr/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "STREAMFIND_BUILD_TESTS": "ON",
        "STREAMFIND_BUILD_SHARED": "OFF",
        "STREAMFIND_ENABLED_PLUGINS": "ALL"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC + Ninja configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../tmp/build/linux-gcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "STREAMFIND_BUILD_TESTS": "ON",
        "STREAMFIND_BUILD_SHARED": "OFF",
        "STREAMFIND_ENABLED_PLUGINS": "ALL"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "mingw-ucrt64",
      "configurePreset": "mingw-ucrt64",
      "environment": {
        "MSYSTEM": "UCRT64",
        "PATH": "C:/msys64/ucrt64/bin;C:/msys64/usr/bin;$penv{PATH}"
      }
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    }
  ]
}
