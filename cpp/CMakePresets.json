{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default standalone core configuration",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/../tmp/build/core-default",
      "cacheVariables": {
        "STREAMFIND_BUILD_TESTS": "ON",
        "STREAMFIND_BUILD_SHARED": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "nativeToolOptions": [
        "-p:MSBuildWarningsAsMessages=MSB8029"
      ]
    }
  ]
}
