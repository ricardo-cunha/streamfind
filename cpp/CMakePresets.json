{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-core",
      "displayName": "Windows MinGW-w64 UCRT64 GCC configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../tmp/build/windows/core",
      "environment": {
        "MSYSTEM": "UCRT64",
        "PATH": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin;$env{STREAMFIND_MSYS2_ROOT}/usr/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin/ninja.exe",
        "STREAMFIND_MINGW_RUNTIME_DIR": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin",
        "STREAMFIND_BUILD_TESTS": "ON",
        "STREAMFIND_BUILD_SHARED": "OFF",
        "STREAMFIND_ENABLED_PLUGINS": "ALL",
        "STREAMFIND_INSTALL_PLUGIN_DEVELOPMENT_KIT": "OFF"
      }
    },
    {
      "name": "windows-devkit",
      "displayName": "Windows MinGW-w64 UCRT64 plugin developer kit",
      "inherits": "windows-core",
      "binaryDir": "${sourceDir}/../tmp/build/windows/devkit",
      "cacheVariables": {
        "STREAMFIND_INSTALL_PLUGIN_DEVELOPMENT_KIT": "ON"
      }
    },
    {
      "name": "linux-core",
      "displayName": "Linux GCC + Ninja configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../tmp/build/linux/core",
      "environment": {
        "PATH": "$penv{HOME}/.streamfind/tools/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "CMAKE_PREFIX_PATH": null,
        "CMAKE_MODULE_PATH": null,
        "CMAKE_LIBRARY_PATH": null,
        "CMAKE_INCLUDE_PATH": null,
        "CMAKE_TOOLCHAIN_FILE": null,
        "PKG_CONFIG_PATH": null,
        "PKG_CONFIG_LIBDIR": null,
        "PKG_CONFIG_SYSROOT_DIR": null
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "CMAKE_FIND_USE_PACKAGE_REGISTRY": "OFF",
        "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY": "OFF",
        "STREAMFIND_BUILD_TESTS": "ON",
        "STREAMFIND_BUILD_SHARED": "OFF",
        "STREAMFIND_ENABLED_PLUGINS": "ALL",
        "STREAMFIND_INSTALL_PLUGIN_DEVELOPMENT_KIT": "OFF"
      }
    },
    {
      "name": "linux-devkit",
      "displayName": "Linux plugin developer kit",
      "inherits": "linux-core",
      "binaryDir": "${sourceDir}/../tmp/build/linux/devkit",
      "cacheVariables": {
        "STREAMFIND_INSTALL_PLUGIN_DEVELOPMENT_KIT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-core",
      "configurePreset": "windows-core",
      "environment": {
        "MSYSTEM": "UCRT64",
        "PATH": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin;$env{STREAMFIND_MSYS2_ROOT}/usr/bin;$penv{PATH}"
      }
    },
    {
      "name": "windows-devkit",
      "configurePreset": "windows-devkit",
      "environment": {
        "MSYSTEM": "UCRT64",
        "PATH": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin;$env{STREAMFIND_MSYS2_ROOT}/usr/bin;$penv{PATH}"
      }
    },
    {
      "name": "linux-core",
      "configurePreset": "linux-core"
    },
    {
      "name": "linux-devkit",
      "configurePreset": "linux-devkit"
    }
  ]
}
