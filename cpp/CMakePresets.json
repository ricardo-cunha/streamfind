{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-ucrt64",
      "displayName": "Windows MinGW-w64 UCRT64 GCC configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../tmp/build/mingw-ucrt64",
      "environment": {
        "MSYSTEM": "UCRT64",
        "PATH": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin;$env{STREAMFIND_MSYS2_ROOT}/usr/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin/ninja.exe",
        "STREAMFIND_MINGW_RUNTIME_DIR": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin",
        "STREAMFIND_BUILD_TESTS": "ON",
        "STREAMFIND_BUILD_SHARED": "OFF",
        "STREAMFIND_ENABLED_PLUGINS": "ALL"
      }
    },
    {
      "name": "mingw-ucrt64-devkit",
      "displayName": "Windows MinGW-w64 UCRT64 plugin developer kit",
      "inherits": "mingw-ucrt64",
      "binaryDir": "${sourceDir}/../tmp/build/mingw-ucrt64-devkit",
      "cacheVariables": {
        "STREAMFIND_INSTALL_PLUGIN_DEVELOPMENT_KIT": "ON"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC + Ninja configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../tmp/build/linux-gcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "STREAMFIND_BUILD_TESTS": "ON",
        "STREAMFIND_BUILD_SHARED": "OFF",
        "STREAMFIND_ENABLED_PLUGINS": "ALL"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-ucrt64",
      "configurePreset": "mingw-ucrt64",
      "environment": {
        "MSYSTEM": "UCRT64",
        "PATH": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin;$env{STREAMFIND_MSYS2_ROOT}/usr/bin;$penv{PATH}"
      }
    },
    {
      "name": "mingw-ucrt64-devkit",
      "configurePreset": "mingw-ucrt64-devkit",
      "environment": {
        "MSYSTEM": "UCRT64",
        "PATH": "$env{STREAMFIND_MSYS2_ROOT}/ucrt64/bin;$env{STREAMFIND_MSYS2_ROOT}/usr/bin;$penv{PATH}"
      }
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    }
  ]
}
