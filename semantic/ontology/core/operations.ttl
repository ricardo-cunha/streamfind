@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sfcore:create
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "create" ;
    skos:prefLabel "Create a project" ;
    skos:definition "Create a new persisted DuckDB project and assign its immutable domain. This is the normal first project-management operation; after it succeeds, call describe to inspect the created project." ;
    sf:category "project-management" ;
    sf:invocationModel "stateless" ;
    sf:requiresConnection false ;
    sf:guidance "Use create once for a new database. Then use describe to inspect it. Do not call create to open an existing project; use describe or connect instead." ;
    sf:nextOperation sfcore:describe ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "create" ;
    sf:hasParameter
        sfcore:databasePathParameter,
        sfcore:domainParameter ;
    sf:returns sfcore:projectDescriptorResult ;
    sf:writes sfcore:projectTable, sfcore:cacheTable, sfcore:auditTrailTable ;
    sf:mutatesProject true .

sfcore:describe
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "describe" ;
    skos:prefLabel "Describe a project" ;
    skos:definition "Inspect a persisted project's identity, immutable domain, metadata, workflow, schema version, and creation information without changing it. Use this as the normal first read after create or before other work." ;
    sf:category "project-management" ;
    sf:invocationModel "stateless" ;
    sf:requiresConnection false ;
    sf:guidance "Call describe with the same database_path used by create. If the project does not exist, do not guess metadata; create it or correct the path." ;
    sf:nextOperation sfcore:connect ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "describe" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:projectDescriptorResult ;
    sf:reads sfcore:projectTable, sfcore:cacheTable ;
    sf:mutatesProject false .

sfcore:validate
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "validate" ;
    skos:prefLabel "Validate a project" ;
    skos:definition "Validate a project's schema and persisted state." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "validate" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:validationResult ;
    sf:reads sfcore:projectTable, sfcore:cacheTable, sfcore:auditTrailTable ;
    sf:mutatesProject false .

sfcore:getDomain
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "get_domain" ;
    skos:prefLabel "Read the project domain" ;
    skos:definition "Read the immutable domain assigned to a persisted project. Use this to confirm which domain-specific operations and workflow methods apply." ;
    sf:category "project-management" ;
    sf:invocationModel "stateless" ;
    sf:requiresConnection false ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "get_domain" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:domainResult ;
    sf:reads sfcore:projectTable ;
    sf:mutatesProject false .

sfcore:getMetadata
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "get_metadata" ;
    skos:prefLabel "Read project metadata" ;
    skos:definition "Return the user-defined metadata stored for a project. An empty object is a valid result when no metadata has been set." ;
    sf:category "project-management" ;
    sf:invocationModel "stateless" ;
    sf:requiresConnection false ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "get_metadata" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:metadataResult ;
    sf:reads sfcore:projectTable ;
    sf:mutatesProject false .

sfcore:setMetadata
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "set_metadata" ;
    skos:prefLabel "Set project metadata" ;
    skos:definition "Replace the user-defined metadata stored for a project. This changes metadata only; it does not change the immutable domain or analyses." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "set_metadata" ;
    sf:hasParameter
        sfcore:databasePathParameter,
        sfcore:metadataParameter ;
    sf:returns sfcore:metadataResult ;
    sf:writes sfcore:projectTable, sfcore:auditTrailTable ;
    sf:mutatesProject true .

sfcore:getWorkflow
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "get_workflow" ;
    skos:prefLabel "Read the project workflow" ;
    skos:definition "Return the ordered persisted workflow, including each method identifier and configured parameters." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "get_workflow" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:workflowResult ;
    sf:reads sfcore:projectTable ;
    sf:mutatesProject false .

sfcore:getWorkflowExecution
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "get_workflow_execution" ;
    skos:prefLabel "Read workflow execution" ;
    skos:definition "Return execution status, hashes, timestamps, errors, and cache keys for the project's workflow steps." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "get_workflow_execution" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:workflowExecutionEntriesResult ;
    sf:reads sfcore:workflowExecutionTable ;
    sf:mutatesProject false .

sfcore:createWorkflowExecution
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "create_workflow_execution" ;
    skos:prefLabel "Create workflow execution" ;
    skos:definition "Create a durable queued workflow execution record for the selected project." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "create_workflow_execution" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:workflowExecutionResult ;
    sf:writes sfcore:workflowExecutionTable ;
    sf:mutatesProject true .

sfcore:getExecution
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "get_execution" ;
    skos:prefLabel "Get workflow execution" ;
    skos:definition "Read one durable workflow execution by identifier." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "get_execution" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:workflowExecutionResult ;
    sf:reads sfcore:workflowExecutionTable ;
    sf:mutatesProject false .

sfcore:listExecutions
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "list_executions" ;
    skos:prefLabel "List workflow executions" ;
    skos:definition "List durable workflow executions scoped to the selected project." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "list_executions" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:workflowExecutionEntriesResult ;
    sf:reads sfcore:workflowExecutionTable ;
    sf:mutatesProject false .

sfcore:transitionExecution
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "transition_execution" ;
    skos:prefLabel "Transition workflow execution" ;
    skos:definition "Advance one workflow execution through a valid lifecycle transition." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "transition_execution" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:workflowExecutionResult ;
    sf:writes sfcore:workflowExecutionTable ;
    sf:mutatesProject true .

sfcore:cancelExecution
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "cancel_execution" ;
    skos:prefLabel "Cancel workflow execution" ;
    skos:definition "Cancel a queued execution or request cancellation of a running execution." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "cancel_execution" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:workflowExecutionResult ;
    sf:writes sfcore:workflowExecutionTable ;
    sf:mutatesProject true .

sfcore:setWorkflow
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "set_workflow" ;
    skos:prefLabel "Set the project workflow" ;
    skos:definition "Validate and replace a project's ordered workflow. Method identifiers, domain compatibility, dependency ordering, and parameters are checked before persistence." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "set_workflow" ;
    sf:hasParameter
        sfcore:databasePathParameter,
        sfcore:workflowParameter ;
    sf:returns sfcore:workflowResult ;
    sf:writes sfcore:projectTable, sfcore:auditTrailTable ;
    sf:mutatesProject true .

sfcore:addMethod
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "add_method" ;
    skos:prefLabel "Add a method to the project workflow" ;
    skos:definition "Append one validated workflow method to the ordered project workflow. The method must belong to the project's immutable domain and its parameters must match the method schema returned by get_available_methods." ;
    sf:category "workflow-planning" ;
    sf:invocationModel "stateless" ;
    sf:requiresConnection false ;
    sf:guidance "Use get_available_methods(domain) first, copy a method id and its parameter names/types, then call add_method. Call validate_workflow before run_workflow." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "add_method" ;
    sf:hasParameter
        sfcore:databasePathParameter,
        sfcore:methodParameter,
        sfcore:parametersParameter ;
    sf:returns sfcore:workflowResult ;
    sf:reads sfcore:projectTable ;
    sf:writes sfcore:projectTable, sfcore:auditTrailTable ;
    sf:mutatesProject true .

sfcore:removeMethod
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "remove_method" ;
    skos:prefLabel "Remove a method from the project workflow" ;
    skos:definition "Remove the first matching method object from the ordered project workflow." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "remove_method" ;
    sf:hasParameter
        sfcore:databasePathParameter,
        sfcore:methodParameter ;
    sf:returns sfcore:workflowResult ;
    sf:reads sfcore:projectTable ;
    sf:writes sfcore:projectTable, sfcore:auditTrailTable ;
    sf:mutatesProject true .

sfcore:validateWorkflow
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "validate_workflow" ;
    skos:prefLabel "Validate a workflow" ;
    skos:definition "Validate workflow method identifiers, ordering dependencies, project-domain compatibility, occurrence rules, and method parameter values without executing the workflow." ;
    sf:category "workflow-planning" ;
    sf:invocationModel "stateless" ;
    sf:requiresConnection false ;
    sf:guidance "Use after assembling a workflow and before run_workflow. Fix the returned validation message before executing." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "validate_workflow" ;
    sf:hasParameter sfcore:workflowParameter ;
    sf:returns sfcore:validationResult ;
    sf:mutatesProject false .

sfcore:runWorkflow
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "run_workflow" ;
    skos:prefLabel "Run the project workflow" ;
    skos:definition "Execute the persisted workflow for a project in order, using the connected project's domain and cached results where valid." ;
    sf:category "workflow-execution" ;
    sf:invocationModel "session" ;
    sf:requiresConnection true ;
    sf:guidance "Connect to the project first, inspect or validate the workflow, then call run_workflow. For one-step execution use run_method with a connected session." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "run_workflow" ;
    sf:hasParameter
        sfcore:databasePathParameter,
        sfcore:workerIdParameter ;
    sf:returns sfcore:workflowExecutionResult ;
    sf:reads sfcore:projectTable, sfcore:cacheTable ;
    sf:writes sfcore:projectTable, sfcore:cacheTable, sfcore:auditTrailTable ;
    sf:mutatesProject true .

sfcore:getCache
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "get_cache" ;
    skos:prefLabel "Read project cache" ;
    skos:definition "Return cache entries stored for a project." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "get_cache" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:cacheEntriesResult ;
    sf:reads sfcore:cacheTable ;
    sf:mutatesProject false .

sfcore:getCacheSize
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "get_cache_size" ;
    skos:prefLabel "Read project cache size" ;
    skos:definition "Return the number of cache entries stored for a project." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "get_cache_size" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:cacheSizeResult ;
    sf:reads sfcore:cacheTable ;
    sf:mutatesProject false .

sfcore:deleteCache
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "delete_cache" ;
    skos:prefLabel "Delete project cache" ;
    skos:definition "Delete all cache entries stored for a project." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "delete_cache" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:operationStatusResult ;
    sf:writes sfcore:cacheTable, sfcore:auditTrailTable ;
    sf:mutatesProject true .

sfcore:getAuditTrail
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "get_audit_trail" ;
    skos:prefLabel "Read project audit events" ;
    skos:definition "Return audit events recorded for a project." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "get_audit_trail" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:auditEntriesResult ;
    sf:reads sfcore:auditTrailTable ;
    sf:mutatesProject false .

sfcore:getAvailableMethods
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "get_available_methods" ;
    skos:prefLabel "List workflow methods registered for a domain" ;
    skos:definition "Return workflow methods registered for a domain. This lists methods that can be added to workflows; it does not list MCP operation tools. Operation names and complete input schemas, including nested target fields, are advertised directly by tools/list." ;
    sf:category "workflow-planning" ;
    sf:invocationModel "stateless" ;
    sf:requiresConnection false ;
    sf:guidance "Use this when planning a workflow. Select a method id from the result, then inspect its parameter definitions before calling add_method. Do not use this operation to discover callable MCP tools; tools/list is the operation catalogue." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "get_available_methods" ;
    sf:hasParameter sfcore:domainParameter ;
    sf:returns sfcore:methodsResult ;
    sf:mutatesProject false .

sfcore:runMethod
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "run_method" ;
    skos:prefLabel "Run a planned workflow method" ;
    skos:definition "Execute one selected workflow method for a connected project. The method must be registered for the project domain and its parameters are validated before execution." ;
    sf:category "workflow-execution" ;
    sf:invocationModel "session" ;
    sf:requiresConnection true ;
    sf:guidance "Connect first, discover methods with get_available_methods, and use the method's input schema. Use run_workflow instead when the whole persisted workflow should execute." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "run_method" ;
    sf:hasParameter
        sfcore:databasePathParameter,
        sfcore:methodParameter,
        sfcore:parametersParameter ;
    sf:returns sfcore:workflowExecutionResult ;
    sf:reads sfcore:projectTable ;
    sf:writes sfcore:projectTable, sfcore:auditTrailTable ;
    sf:mutatesProject true .

sfcore:copy
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "copy" ;
    skos:prefLabel "Copy a project" ;
    skos:definition "Copy a complete persisted project, including metadata, workflow, analyses, cached tables, and audit information, to a destination database." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "copy" ;
    sf:hasParameter
        sfcore:databasePathParameter,
        sfcore:destinationDatabasePathParameter ;
    sf:returns sfcore:projectDescriptorResult ;
    sf:writes sfcore:projectTable, sfcore:cacheTable, sfcore:auditTrailTable ;
    sf:mutatesProject true .

sfcore:close
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "close" ;
    skos:prefLabel "Close a project handle" ;
    skos:definition "Clear the connected project context used for workflow methods. This does not delete the project and does not remove stateless operation tools." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "close" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:operationStatusResult ;
    sf:mutatesProject false .

sfcore:connect
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "connect" ;
    skos:prefLabel "Connect an MCP session to a project" ;
    skos:definition "Open an existing project and bind its immutable domain to the MCP session for workflow-method operations. Domain operations remain discoverable and callable without connect; connect establishes the context used by add_method, validate_workflow, run_method, and run_workflow." ;
    sf:category "session-management" ;
    sf:invocationModel "session" ;
    sf:requiresConnection false ;
    sf:guidance "Call connect only after create or describe confirms the project. It does not add operation tools to tools/list. Use it when planning or executing workflow methods; close clears that session context." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "connect" ;
    sf:hasParameter sfcore:databasePathParameter ;
    sf:returns sfcore:operationStatusResult ;
    sf:mutatesProject false .

sfcore:toolsStatus
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "tools_status" ;
    skos:prefLabel "External tools status" ;
    skos:definition "Report the resolution state of the user-scoped external tools (~/.streamfind): the tools home, Java, and MetFrag paths, or not-found markers. No downloads are performed." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "tools_status" ;
    sf:returns sfcore:toolsStatusResult ;
    sf:mutatesProject false .

sfcore:toolsInstall
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "tools_install" ;
    skos:prefLabel "Install external tools" ;
    skos:definition "Install the external tools stack (Java + MetFrag) into the user-scoped ~/.streamfind layout. Downloads may take minutes; no project change is performed." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "tools_install" ;
    sf:returns sfcore:toolsStatusResult ;
    sf:mutatesProject false .

sfcore:toolsInstallJava
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "tools_install_java" ;
    skos:prefLabel "Install Java" ;
    skos:definition "Install the Temurin JDK 21 into the user-scoped ~/.streamfind layout. Downloads may take minutes; no project change is performed." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "tools_install_java" ;
    sf:returns sfcore:toolsStatusResult ;
    sf:mutatesProject false .

sfcore:toolsInstallMetfrag
    a sf:Operation ;
    skos:inScheme sfcore:scheme ;
    sf:operationId "tools_install_metfrag" ;
    skos:prefLabel "Install MetFrag" ;
    skos:definition "Install the MetFrag command-line jar into the user-scoped ~/.streamfind layout. Downloads may take minutes; no project change is performed." ;
    sf:availableInDomain sfcore:streamfind ;
    sf:toolName "tools_install_metfrag" ;
    sf:returns sfcore:toolsStatusResult ;
    sf:mutatesProject false .
