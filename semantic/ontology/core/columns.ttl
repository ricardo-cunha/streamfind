@prefix sfcore: <https://streamfind.dev/catalogue/core#> .
@prefix sf: <https://streamfind.dev/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .


sfcore:projectDomainColumn
    a sf:Column ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Domain" ;
    skos:definition "Immutable project domain." ;
    sf:columnName "domain" ;
    sf:type "string" ;
    sf:storageType "VARCHAR" .

sfcore:projectMetadataColumn
    a sf:Column ;
    sf:availableInDomain sfcore:streamfind ;
    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Metadata" ;
    skos:definition "Project metadata JSON." ;
    sf:columnName "metadata" ;
    sf:type "string" ;
    sf:storageType "JSON" .

sfcore:projectWorkflowColumn
