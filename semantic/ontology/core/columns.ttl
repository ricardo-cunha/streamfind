    skos:inScheme sfcore:scheme ;
    skos:prefLabel "Workflow" ;
    skos:definition "Persisted workflow JSON." ;
    sf:columnName "workflow" ;
    sf:type "array" ;
    sf:items sfcore:methodField ;
    sf:storageType "JSON" .

