        sfms:suspectsPolarityColumn,
        sfms:suspectsDbMassColumn,
        sfms:suspectsExpMassColumn,
        sfms:suspectsErrorMassColumn,
        sfms:suspectsDbRtColumn,
        sfms:suspectsExpRtColumn,
        sfms:suspectsErrorRtColumn,
        sfms:suspectsIntensityColumn,
        sfms:suspectsAreaColumn,
        sfms:suspectsIdLevelColumn,
        sfms:suspectsScoreColumn,
        sfms:suspectsSharedFragmentsColumn,
        sfms:suspectsCosineSimilarityColumn,
        sfms:suspectsFormulaColumn,
        sfms:suspectsSmilesColumn,
        sfms:suspectsInChIColumn,
        sfms:suspectsInChIKeyColumn,
        sfms:suspectsXLogPColumn,
        sfms:suspectsDatabaseIdColumn,
        sfms:suspectsDbMs2SizeColumn,
        sfms:suspectsDbMs2MzColumn,
        sfms:suspectsDbMs2IntensityColumn,
        sfms:suspectsDbMs2FormulaColumn,
        sfms:suspectsDbMs2SmilesColumn,
        sfms:suspectsExpMs2SizeColumn,
        sfms:suspectsExpMs2MzColumn,
        sfms:suspectsExpMs2IntensityColumn .

